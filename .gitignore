npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.next/
.cache/
*.tsbuildinfo

# Kubernetes
kubeconfig
*.kubeconfig
*.local.yaml
*-secrets.local.yaml

# Temporary files
tmp/
temp/
.tmp/

# Docker
.dockerignore

# Secrets (NEVER commit)
infra/k8s/production/oidc-secrets.yaml
infra/k8s/production/backup/backup-secrets.yaml
*-secrets.yaml
*-secret.yaml
secrets.dev.yaml
secrets.*.yaml
!*-secrets.example.yaml
!*-secrets.yaml.template
!*-secret.yaml.template
!*.TEMPLATE
!secrets.yaml.TEMPLATE
# ExternalSecret manifests (no actual secret values — just Vault path references)
!infra/k8s/base/external-secrets/vault-secrets/*-secrets.yaml

