---
# AlertManager Configuration
apiVersion: v1
kind: ConfigMap
metadata:
  name: alertmanager-config
  namespace: monitoring
  labels:
    app.kubernetes.io/name: alertmanager
    app.kubernetes.io/component: monitoring
    app.kubernetes.io/part-of: enclii
data:
  alertmanager.yml: |
    global:
      resolve_timeout: 5m
      smtp_smarthost: 'smtp.gmail.com:587'
      smtp_from: 'innovacionesmadfam@gmail.com'
      smtp_auth_username: 'innovacionesmadfam@gmail.com'
      smtp_auth_password_file: '/etc/alertmanager/smtp-password'
      smtp_require_tls: true

    route:
      group_by: ['alertname', 'severity', 'service']
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 4h
      receiver: 'default-receiver'
      routes:
        # THE MESSAGING PATH'S OWN FAILURE MUST NOT USE THE MESSAGING PATH.
        # CourierReceiverDown fires when Alertmanager cannot deliver to
        # angelia-api's Courier receiver. It is `severity: critical`, so
        # without this route it would match the critical route below and be
        # sent to the receiver that is broken — an alert about a dead pager,
        # delivered through the dead pager. FIRST in the list and
        # `continue: false` so it stops here and reaches the email-only
        # default-receiver. Required mitigation 2 of internal-devops
        # decisions/2026-09-05-third-party-messaging-via-angelia-courier.md § 4.
        #
        # `matchers` rather than the deprecated `match` below: this route's
        # correctness is load-bearing and the modern form is the one upstream
        # keeps.
        - matchers:
            - alertname="CourierReceiverDown"
          receiver: 'default-receiver'
          continue: false
          group_wait: 10s
          repeat_interval: 1h

        # Critical alerts - immediate notification
        - match:
            severity: critical
          receiver: 'critical-receiver'
          group_wait: 10s
          # Matches Courier's hourly idempotency window
          # (`alarm:<alertname>:<hour>`): a repeat inside the hour collapses to
          # one delivery in the ledger, so a shorter interval would only add
          # POSTs, not pages.
          repeat_interval: 1h

        # Warning alerts - grouped notifications
        - match:
            severity: warning
          receiver: 'warning-receiver'
          group_wait: 1m
          repeat_interval: 4h

    receivers:
      - name: 'default-receiver'
        email_configs:
          - to: 'admin@madfam.io'
            send_resolved: true

      # THE LAST MILE IS ANGELIA COURIER, and nothing else.
      # internal-devops decisions/2026-09-05-third-party-messaging-via-angelia-courier.md
      # (item M1) rules that every message this estate sends to a person on a
      # third-party messaging network goes through one door:
      # POST /v1/courier/alertmanager, which takes Alertmanager's schema-4
      # webhook verbatim and normalises it into Courier's envelope. Both
      # slack_configs blocks that used to live in these two receivers were
      # DELETED, not left inert — a direct last mile that still works is the
      # thing the decision removes.
      #
      # email_configs STAY, on purpose. They are the fallback that does not
      # depend on angelia-api (policy § 4): angelia-api down means the webhook
      # last mile is down, and the pager must not have a single point of
      # failure. The CourierReceiverDown rule in prometheus.yaml is routed to
      # the email receiver above for exactly that reason.
      #
      # WARNINGS ARE INERT HERE, deliberately. Courier's receiver filters by
      # severity (COURIER_ALERTMANAGER_SEVERITIES, default `critical` only), so
      # a warning POSTed to it is counted as `skipped` with reason `severity`
      # and no message is sent. Routing warnings to the webhook now costs
      # nothing and means the day Angelia widens that env var, warnings arrive
      # with no change here. Until then warnings reach people by email only,
      # exactly as they do today.
      #
      # repeat_interval: 1h on the critical route is not arbitrary: Courier
      # dedups on `alarm:<alertname>:<hour>`, an hourly idempotency window, so
      # every repeat inside the hour collapses to one delivery. A shorter
      # repeat_interval would not page more often, it would just POST more.
      #
      # Until the operator populates `secret/angelia:courier_alertmanager_secret`
      # (intake target `angelia/courier-alertmanager`), the receiver answers
      # 503 not_provisioned, Alertmanager records a failed webhook notification,
      # CourierReceiverDown fires, and email carries the page — which is the
      # same behaviour as today, when there was no working last mile at all.
      - name: 'critical-receiver'
        email_configs:
          - to: 'admin@madfam.io'
            send_resolved: true
            headers:
              Subject: '[CRITICAL] {{ .CommonLabels.alertname }} - Enclii'
        webhook_configs:
          - url: 'http://angelia-api.angelia.svc.cluster.local/v1/courier/alertmanager'
            send_resolved: true
            http_config:
              authorization:
                type: Bearer
                credentials_file: /etc/alertmanager/courier-alertmanager-secret

      - name: 'warning-receiver'
        email_configs:
          - to: 'admin@madfam.io'
            send_resolved: true
            headers:
              Subject: '[WARNING] {{ .CommonLabels.alertname }} - Enclii'
        webhook_configs:
          - url: 'http://angelia-api.angelia.svc.cluster.local/v1/courier/alertmanager'
            send_resolved: true
            http_config:
              authorization:
                type: Bearer
                credentials_file: /etc/alertmanager/courier-alertmanager-secret

    inhibit_rules:
      # If a critical alert is firing, inhibit warnings for the same service
      - source_match:
          severity: 'critical'
        target_match:
          severity: 'warning'
        equal: ['alertname', 'service']

    templates: []
---
# AlertManager SMTP Secret — NOT committed to git.
# Create manually before deploying AlertManager:
#
#   kubectl create secret generic alertmanager-smtp-secret -n monitoring \
#     --from-literal=smtp-password='YOUR_GMAIL_APP_PASSWORD'
#
# Use a Gmail App Password (not account password).
# Long-term: migrate to Resend SMTP relay or External Secrets Operator.
---
# AlertManager Deployment
apiVersion: apps/v1
kind: Deployment
metadata:
  name: alertmanager
  namespace: monitoring
  labels:
    app.kubernetes.io/name: alertmanager
    app.kubernetes.io/component: monitoring
    app.kubernetes.io/part-of: enclii
spec:
  # Single replica because the backing PVC alertmanager-data is RWO (Longhorn doesn't
  # support RWX without an NFS shim). With replicas=2 the second pod sat in
  # ContainerCreating for 25 days hitting Multi-Attach errors. True HA alertmanager
  # would need a StatefulSet with volumeClaimTemplates so each peer has its own
  # volume — out of scope here. Recreate strategy ensures the old pod releases
  # the volume before the new one tries to attach.
  # Cutover complete: HA StatefulSet (alertmanager-statefulset.yaml) owns alerting.
  # Keep Deployment at 0 so Argo does not fight the legacy RWO PVC attach loop.
  replicas: 0
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: alertmanager
  template:
    metadata:
      labels:
        app: alertmanager
        app.kubernetes.io/name: alertmanager
        app.kubernetes.io/component: monitoring
        app.kubernetes.io/part-of: enclii
    spec:
      securityContext:
        fsGroup: 65534
        runAsUser: 65534
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: alertmanager
          image: docker.io/prom/alertmanager:v0.26.0@sha256:361db356b33041437517f1cd298462055580585f26555c317df1a3caf2868552
          securityContext:
            allowPrivilegeEscalation: false
            privileged: false
            capabilities:
              drop:
                - ALL
          args:
            - "--config.file=/etc/alertmanager/alertmanager.yml"
            - "--storage.path=/alertmanager"
            - "--cluster.listen-address=0.0.0.0:9094"
            - "--cluster.peer=alertmanager-cluster.monitoring.svc.cluster.local:9094"
            - "--web.external-url=https://alertmanager.enclii.dev"
          ports:
            - containerPort: 9093
              name: http
            - containerPort: 9094
              name: cluster
          resources:
            requests:
              memory: "64Mi"
              cpu: "50m"
            limits:
              memory: "128Mi"
              cpu: "100m"
          volumeMounts:
            - name: config
              mountPath: /etc/alertmanager/alertmanager.yml
              subPath: alertmanager.yml
            - name: smtp-secret
              mountPath: /etc/alertmanager/smtp-password
              subPath: smtp-password
              readOnly: true
            # The Courier receiver's shared secret, read by
            # `http_config.authorization.credentials_file` in both
            # webhook_configs. Replaces the slack-webhook-url mount, which went
            # with the slack_configs blocks. The telegram-bot-token mount went
            # too: nothing referenced it, and re-adding telegram_configs — the
            # only thing it existed for — is now forbidden by
            # internal-devops decisions/2026-09-05-third-party-messaging-via-angelia-courier.md § 2.
            - name: courier-secret
              mountPath: /etc/alertmanager/courier-alertmanager-secret
              subPath: courier-alertmanager-secret
              readOnly: true
            - name: data
              mountPath: /alertmanager
          startupProbe:
            httpGet:
              path: /-/ready
              port: 9093
            failureThreshold: 15
            periodSeconds: 5
          readinessProbe:
            httpGet:
              path: /-/ready
              port: 9093
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 3
          livenessProbe:
            httpGet:
              path: /-/healthy
              port: 9093
            initialDelaySeconds: 30
            periodSeconds: 10
            timeoutSeconds: 3
      volumes:
        - name: config
          configMap:
            name: alertmanager-config
        - name: smtp-secret
          secret:
            secretName: alertmanager-smtp-secret
        - name: courier-secret
          secret:
            # Populated by alertmanager-courier-secret.externalsecret.yaml,
            # which reads secret/angelia:courier_alertmanager_secret CROSS-PATH
            # through the shared vault-store. Angelia owns that property; this
            # namespace projects it, it does not hold a second copy.
            #
            # `optional: true` on purpose: until the operator runs
            # `enclii secrets intake angelia/courier-alertmanager` the Secret
            # does not exist, and a required mount would leave alertmanager
            # Pending — i.e. the whole estate's alerting down waiting on a
            # credential whose absence is supposed to be merely inert. With
            # optional, the webhook POSTs with no credential, the receiver
            # answers 503, and email keeps carrying alerts.
            secretName: alertmanager-courier-secret
            optional: true
        - name: data
          persistentVolumeClaim:
            claimName: alertmanager-data
---
# AlertManager PVC — persistent alert state across restarts
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: alertmanager-data
  namespace: monitoring
  labels:
    app.kubernetes.io/name: alertmanager
    app.kubernetes.io/component: monitoring
    app.kubernetes.io/part-of: enclii
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: longhorn
  resources:
    requests:
      storage: 1Gi
---
# AlertManager Service
apiVersion: v1
kind: Service
metadata:
  name: alertmanager
  namespace: monitoring
  labels:
    app.kubernetes.io/name: alertmanager
    app.kubernetes.io/component: monitoring
    app.kubernetes.io/part-of: enclii
spec:
  type: ClusterIP
  ports:
    - port: 9093
      targetPort: 9093
      name: http
  selector:
    app: alertmanager
---
# Headless Service for AlertManager cluster peer discovery
apiVersion: v1
kind: Service
metadata:
  name: alertmanager-cluster
  namespace: monitoring
  labels:
    app.kubernetes.io/name: alertmanager
    app.kubernetes.io/component: monitoring
    app.kubernetes.io/part-of: enclii
spec:
  type: ClusterIP
  clusterIP: None
  ports:
    - port: 9094
      targetPort: 9094
      name: cluster
  selector:
    app: alertmanager
# NOTE: the Deployment-era `alertmanager-pdb` (minAvailable: 1) that used to
# live here was removed 2026-08-26. It selected `app: alertmanager` — the same
# label the HA StatefulSet's pods carry — so it overlapped
# `alertmanager-statefulset-pdb` in alertmanager-statefulset.yaml. Two PDBs
# selecting one pod makes the eviction API pick between them arbitrarily
# (448 `MultiplePodDisruptionBudgets` events observed in production), so
# disruption safety was undefined. The StatefulSet PDB is the surviving one.
