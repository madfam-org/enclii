---
# Prometheus RBAC
apiVersion: v1
kind: ServiceAccount
metadata:
  name: prometheus
  namespace: monitoring
  labels:
    app.kubernetes.io/name: prometheus
    app.kubernetes.io/component: monitoring
    app.kubernetes.io/part-of: enclii
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: prometheus
  labels:
    app.kubernetes.io/name: prometheus
    app.kubernetes.io/component: monitoring
    app.kubernetes.io/part-of: enclii
rules:
  - apiGroups: [""]
    resources:
      - nodes
      - nodes/proxy
      - nodes/metrics
      - services
      - endpoints
      - pods
    verbs: ["get", "list", "watch"]
  - apiGroups: ["extensions", "networking.k8s.io"]
    resources:
      - ingresses
    verbs: ["get", "list", "watch"]
  - nonResourceURLs: ["/metrics", "/metrics/cadvisor"]
    verbs: ["get"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: prometheus
  labels:
    app.kubernetes.io/name: prometheus
    app.kubernetes.io/component: monitoring
    app.kubernetes.io/part-of: enclii
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: prometheus
subjects:
  - kind: ServiceAccount
    name: prometheus
    namespace: monitoring
---
# Prometheus Configuration
apiVersion: v1
kind: ConfigMap
metadata:
  name: prometheus-config
  namespace: monitoring
  labels:
    app.kubernetes.io/name: prometheus
    app.kubernetes.io/component: monitoring
    app.kubernetes.io/part-of: enclii
data:
  prometheus.yml: |
    global:
      scrape_interval: 30s
      evaluation_interval: 30s
      external_labels:
        cluster: enclii-production
        environment: production

    # Alerts go to EVERY Alertmanager peer, not to the load-balanced Service.
    # Alertmanager does not gossip alerts, only silences and the notification
    # log, so a client must push each alert to every peer itself. Through the
    # `alertmanager` ClusterIP the keep-alive connection pinned this server to
    # one peer: on 2026-09-24 alertmanager-1 held 388 alerts from this server
    # while alertmanager-0 and -2 held none, so the "3-peer HA" pager was one
    # pod for everything this Prometheus evaluates. The operator-managed
    # `rules-eval` Prometheus already does this through endpoint discovery,
    # and the `alertmanager` scrape job below already reaches all three
    # peers on this port, so no network policy changes. Deduplication across
    # the peers is the notification log, gossiped on 9094.
    alerting:
      alertmanagers:
        - kubernetes_sd_configs:
            - role: endpoints
              namespaces:
                names:
                  - monitoring
          relabel_configs:
            - source_labels: [__meta_kubernetes_service_name, __meta_kubernetes_endpoint_port_name]
              action: keep
              regex: alertmanager;http

    rule_files:
      - /etc/prometheus/rules/*.yml

    scrape_configs:
      # Prometheus self-monitoring
      - job_name: 'prometheus'
        static_configs:
          - targets: ['localhost:9090']

      # Alertmanager self-monitoring. Added 2026-09-05 with the Courier last
      # mile: `alertmanager_notifications_failed_total` is what the
      # CourierReceiverDown rule reads, and until this job existed nothing in
      # this cluster scraped Alertmanager at all — the rule would have
      # evaluated over an empty series forever and reported a healthy pager
      # while the pager was dead. That is the "probe that passes while
      # measuring nothing" failure this repo's other detectors are written
      # against, so the scrape ships in the same commit as the rule.
      #
      # The headless per-peer Service is the target, not the load-balanced
      # `alertmanager` Service: notification counters are PER PEER, and
      # scraping through a round-robin Service would attribute one peer's
      # failures to whichever pod answered.
      - job_name: 'alertmanager'
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names:
                - monitoring
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_name, __meta_kubernetes_endpoint_port_name]
            action: keep
            regex: alertmanager;http
          - source_labels: [__meta_kubernetes_pod_name]
            action: replace
            target_label: pod
          - source_labels: [__meta_kubernetes_namespace]
            action: replace
            target_label: namespace

      # Kubernetes API server
      - job_name: 'kubernetes-apiservers'
        kubernetes_sd_configs:
          - role: endpoints
        scheme: https
        tls_config:
          ca_file: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
        bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token
        relabel_configs:
          - source_labels: [__meta_kubernetes_namespace, __meta_kubernetes_service_name, __meta_kubernetes_endpoint_port_name]
            action: keep
            regex: default;kubernetes;https

      # Kubernetes nodes
      # Kubelet and cadvisor go through the API server's node proxy. Direct
      # scrapes of <node-ip>:10250 never worked here: the Prometheus egress
      # policies have no rule for node IPs, so every kubelet target was refused.
      # The proxy rides the 443/6443 egress both instances already have and the
      # nodes/proxy permission both ClusterRoles already grant. `instance` is the
      # node name, since every target now shares the API server address.
      - job_name: 'kubernetes-nodes'
        kubernetes_sd_configs:
          - role: node
        scheme: https
        tls_config:
          ca_file: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
        bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token
        relabel_configs:
          - action: labelmap
            regex: __meta_kubernetes_node_label_(.+)
          - target_label: __address__
            replacement: kubernetes.default.svc:443
          - source_labels: [__meta_kubernetes_node_name]
            regex: (.+)
            target_label: __metrics_path__
            replacement: /api/v1/nodes/$1/proxy/metrics
          - source_labels: [__meta_kubernetes_node_name]
            target_label: instance

      # Kubernetes node cadvisor metrics
      - job_name: 'kubernetes-cadvisor'
        kubernetes_sd_configs:
          - role: node
        scheme: https
        tls_config:
          ca_file: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
        bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token
        relabel_configs:
          - action: labelmap
            regex: __meta_kubernetes_node_label_(.+)
          - target_label: __address__
            replacement: kubernetes.default.svc:443
          - source_labels: [__meta_kubernetes_node_name]
            regex: (.+)
            target_label: __metrics_path__
            replacement: /api/v1/nodes/$1/proxy/metrics/cadvisor
          - source_labels: [__meta_kubernetes_node_name]
            target_label: instance

      # Kubernetes pods with prometheus.io annotations
      - job_name: 'kubernetes-pods'
        kubernetes_sd_configs:
          - role: pod
        relabel_configs:
          - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_scrape]
            action: keep
            regex: true
          - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_path]
            action: replace
            target_label: __metrics_path__
            regex: (.+)
          - source_labels: [__address__, __meta_kubernetes_pod_annotation_prometheus_io_port]
            action: replace
            regex: ([^:]+)(?::\d+)?;(\d+)
            replacement: $1:$2
            target_label: __address__
          - action: labelmap
            regex: __meta_kubernetes_pod_label_(.+)
          - source_labels: [__meta_kubernetes_namespace]
            action: replace
            target_label: namespace
          - source_labels: [__meta_kubernetes_pod_name]
            action: replace
            target_label: pod

      # Kubernetes services with prometheus.io annotations
      - job_name: 'kubernetes-services'
        kubernetes_sd_configs:
          - role: endpoints
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_annotation_prometheus_io_scrape]
            action: keep
            regex: true
          - source_labels: [__meta_kubernetes_service_annotation_prometheus_io_path]
            action: replace
            target_label: __metrics_path__
            regex: (.+)
          - source_labels: [__address__, __meta_kubernetes_service_annotation_prometheus_io_port]
            action: replace
            target_label: __address__
            regex: ([^:]+)(?::\d+)?;(\d+)
            replacement: $1:$2
          - action: labelmap
            regex: __meta_kubernetes_service_label_(.+)
          - source_labels: [__meta_kubernetes_namespace]
            action: replace
            target_label: namespace
          - source_labels: [__meta_kubernetes_service_name]
            action: replace
            target_label: service

      # Switchyard API metrics
      - job_name: 'switchyard-api'
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names:
                - enclii
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_label_app]
            action: keep
            regex: switchyard-api
          - source_labels: [__meta_kubernetes_endpoint_port_name]
            action: keep
            regex: http
        metrics_path: /metrics

      # Pushgateway — batch/CronJob metrics.
      #
      # ADDED 2026-08-11. The pushgateway has existed for 96 days and NOTHING
      # HAS EVER SCRAPED IT: there was no job here, so every metric the
      # CronJob monitors push has been written to a gateway Prometheus never
      # read. That silently voided every alert built on them, including
      # ArgoMainParityDrift and the whole deploy-pipeline-monitor alert family.
      #
      # It was found on 2026-08-11 while arming a new rollout-truth alert: the
      # rules loaded, the monitor ran, the metric sat on the gateway, and the
      # series count in Prometheus was zero. An alert is usually dead in more
      # than one way at once — this was the second way.
      #
      # honor_labels: true is REQUIRED, not stylistic. Pushed samples already
      # carry their own `job` (e.g. argo_main_parity_monitor) and `instance`.
      # Without it Prometheus overwrites both with this scrape's job/instance,
      # so every pusher collapses into one series set and alert expressions
      # that group by application/repo silently lose their identity.
      - job_name: 'pushgateway'
        honor_labels: true
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names:
                - monitoring
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_label_app_kubernetes_io_name]
            action: keep
            regex: pushgateway
          # The Service and its headless twin share every label, so without
          # this the same gateway is scraped twice and each sample arrives
          # duplicated. Keep the stable ClusterIP Service only.
          - source_labels: [__meta_kubernetes_service_name]
            action: keep
            regex: pushgateway

      # Node exporter metrics (host CPU, memory, disk, network)
      - job_name: 'node-exporter'
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names:
                - monitoring
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_label_app_kubernetes_io_name]
            action: keep
            regex: node-exporter

      # Kubernetes OBJECT state (jobs, pods, deployments) — the series that the
      # kube_job_*/kube_pod_*/kube_deployment_* alert rules query.
      #
      # honor_labels: true is LOAD-BEARING, not style. Every sample here already
      # carries the `namespace`, `pod` and `job` of the object it DESCRIBES.
      # Without honor_labels those are overwritten by the scrape target's own
      # identity (namespace="monitoring", pod="kube-state-metrics-…") and the
      # originals are pushed to exported_*. BackupJobFailed{namespace="data"}
      # would then never match and would stay silently dead — the exact failure
      # this exporter is being deployed to end.
      #
      # For the same reason this uses endpoints discovery with no namespace/pod
      # relabeling, rather than the annotation-based kubernetes-pods job.
      - job_name: 'kube-state-metrics'
        honor_labels: true
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names:
                - monitoring
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_label_app_kubernetes_io_name]
            action: keep
            regex: kube-state-metrics
          # Metrics port only; drop the self-telemetry endpoint target.
          - source_labels: [__meta_kubernetes_endpoint_port_name]
            action: keep
            regex: http-metrics

      # Redis metrics (redis-exporter in data namespace)
      - job_name: 'redis'
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names:
                - data
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_label_app_kubernetes_io_name]
            action: keep
            regex: redis-exporter

      # PostgreSQL metrics (postgres-exporter in data namespace)
      - job_name: 'postgres'
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names:
                - data
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_label_app_kubernetes_io_name]
            action: keep
            regex: postgres-exporter

      # Roundhouse Build Worker metrics
      - job_name: 'roundhouse'
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names:
                - enclii
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_label_app]
            action: keep
            regex: roundhouse
          - source_labels: [__meta_kubernetes_endpoint_port_name]
            action: keep
            regex: metrics
        metrics_path: /metrics

      # ArgoCD metrics
      - job_name: 'argocd'
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names:
                - argocd
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_annotation_prometheus_io_scrape]
            action: keep
            regex: true
          - source_labels: [__meta_kubernetes_service_annotation_prometheus_io_port]
            action: replace
            target_label: __address__
            regex: ([^:]+)(?::\d+)?;(\d+)
            replacement: $1:$2
          - source_labels: [__address__, __meta_kubernetes_service_annotation_prometheus_io_port]
            action: replace
            regex: ([^:]+)(?::\d+)?;(\d+)
            replacement: $1:$2
            target_label: __address__

      # Kyverno metrics
      - job_name: 'kyverno'
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names:
                - kyverno
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_label_app_kubernetes_io_component]
            action: keep
            regex: admission-controller|background-controller
          # Only the metrics Services' port. kyverno-svc (the admission
          # webhook, https -> 9443) carries the same component label, and
          # endpoints discovery also adds every other container port of the
          # backing pods, so without this Prometheus scraped the TLS webhook
          # port over plain HTTP (400 / connection refused) and
          # KyvernoControllerDown fired against a healthy Kyverno.
          - source_labels: [__meta_kubernetes_endpoint_port_name]
            action: keep
            regex: metrics-port
        metrics_path: /metrics

      # External Secrets metrics
      - job_name: 'external-secrets'
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names:
                - external-secrets
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_annotation_prometheus_io_scrape]
            action: keep
            regex: true

      # Synthetic HTTP probes of the revenue flows (money-machine audit
      # 2026-10-11, M2 F1/F2/F5), through blackbox-exporter.yaml. Each target
      # is a PUBLIC URL, probed through Cloudflare and the tunnel like a
      # customer's browser; `module` picks how it is judged (the modules are
      # defined and explained in blackbox-exporter.yaml). The
      # `revenue-probes` rule group (revenue-probe-rules.yml below) pages on
      # the results.
      #
      # Labels on every target:
      #   product           what pages ("cotiza", "dhanam", ...)
      #   flow              which path of it: api, web, quote, fx, ...
      #   target_namespace  where to look first (enclii ops pods diagnose -n)
      #   check             availability, or fx-source for the one probe whose
      #                     body regex has its own alert
      #   module            the blackbox module (also sent as ?module=)
      #
      # Adding a target: use a URL that answers 2xx WITHOUT a redirect
      # (curl -sS -o /dev/null -w '%{http_code}' must print 200 on the exact
      # URL), and pick the module by the BODY it answers (curl -sS the URL):
      # a JSON object with a "status" or "ok" field is http_2xx_json; a bare
      # JSON array (a list endpoint, `[]` when empty) is http_2xx_json_array.
      # A module whose body check the healthy answer does not meet pages
      # falsely and forever. Add it to tests/scripts/test_revenue_probe_rules.py's
      # expectations. This repo is public: a client hostname goes here only
      # when the repo already publishes that client's domain (its tenant
      # entry in apps/switchyard-api/internal/ecosystem/tenants.json), and
      # never with any data about the client's people.
      #
      # `product` is also how Alertmanager groups these pages: the revenue
      # route in alertmanager.yaml groups by [alertname, product], so each
      # product failing opens its own page instead of joining one that is
      # already firing. Keep it set, and the same for every flow of a product.
      - job_name: 'blackbox-revenue'
        metrics_path: /probe
        scrape_interval: 60s
        scrape_timeout: 15s
        static_configs:
          # Cotiza. The web app's /api/* is a proxy to the API; when it
          # pointed at localhost:4000 the front page stayed 200 and every
          # quote call failed (F1). /api/health crosses the proxy to the
          # API's /health. /quotes is the route the quote flow calls; an
          # anonymous GET must answer 401 (route present, auth enforced).
          # Until Cotiza's NextAuth secret is provisioned (digifab-quoting#81),
          # /api/health answers 503 by design ("nextauth_secret_missing") and
          # would page on arrival. The guest-quote list through the same web
          # proxy answers 200 with a JSON array (`[]` when there are no guest
          # quotes), so it is judged by http_2xx_json_array: it has no
          # status/ok field, and under http_2xx_json it failed every probe from
          # 2026-10-12 and held RevenueEndpointDown firing while the flow was
          # up. Switch back to /api/health, on http_2xx_json, once #81 has
          # merged and /api/health returns 200.
          - targets: ['https://cotiza.studio/api/v1/guest/quotes']
            labels: {product: cotiza, flow: web-api-proxy, target_namespace: digifab-quoting, check: availability, module: http_2xx_json_array}
          - targets: ['https://cotiza.studio/api/quotes']
            labels: {product: cotiza, flow: quote-via-web, target_namespace: digifab-quoting, check: availability, module: http_401}
          - targets: ['https://api.cotiza.studio/quotes']
            labels: {product: cotiza, flow: quote, target_namespace: digifab-quoting, check: availability, module: http_401}
          - targets: ['https://api.cotiza.studio/health/ready']
            labels: {product: cotiza, flow: api, target_namespace: digifab-quoting, check: availability, module: http_2xx_json}
          # Dhanam: the API, the public billing catalog checkout reads, and
          # the FX rail. The FX probe fails on `"source":"emergency_fallback"`
          # (the hardcoded table, never authoritative), F2.
          - targets: ['https://api.dhan.am/health']
            labels: {product: dhanam, flow: api, target_namespace: dhanam, check: availability, module: http_2xx_json, money_path: ',dhanam-self-serve,'}
          - targets: ['https://api.dhan.am/v1/billing/catalog']
            labels: {product: dhanam, flow: billing-catalog, target_namespace: dhanam, check: availability, module: http_dhanam_catalog, money_path: ',dhanam-self-serve,'}
          - targets: ['https://api.dhan.am/v1/fx-rates/health']
            labels: {product: dhanam, flow: fx, target_namespace: dhanam, check: fx-source, module: http_dhanam_fx}
          # The other revenue products' health endpoints. Where a product's
          # apex serves an SPA that answers 200 index.html for any path
          # (factl.as, yantra4d.com), the API host is probed instead.
          - targets: ['https://api.yantra4d.com/api/health']
            labels: {product: yantra4d, flow: api, target_namespace: yantra4d, check: availability, module: http_2xx_json}
          - targets: ['https://kalya.app/api/health']
            labels: {product: kalya, flow: web, target_namespace: kalya, check: availability, module: http_2xx_json, money_path: ',sales-booking,'}
          - targets: ['https://madfam.io/api/health']
            labels: {product: madfam-site, flow: web, target_namespace: madfam-site, check: availability, module: http_2xx_json, money_path: ',sales-booking,'}
          - targets: ['https://api.avala.studio/v1/health']
            labels: {product: avala, flow: api, target_namespace: avala, check: availability, module: http_2xx_json}
          - targets: ['https://app.avala.studio/api/health']
            labels: {product: avala, flow: web, target_namespace: avala, check: availability, module: http_2xx_json}
          - targets: ['https://api.factl.as/health']
            labels: {product: factlas, flow: api, target_namespace: factlas, check: availability, module: http_2xx_json}
          - targets: ['https://routecraft.app/api/health']
            labels: {product: routecraft, flow: web, target_namespace: routecraft, check: availability, module: http_2xx_json}
          # Janua: the readiness REPORT, not /health. Readiness answers 200
          # while Redis or the database is down (R107/R109: it reports, it
          # does not gate), so http_janua_ready judges the body. /health has
          # no Redis or database field and read green through both outages.
          - targets: ['https://auth.madfam.io/api/v1/health/ready']
            labels: {product: janua, flow: api, target_namespace: janua, check: availability, module: http_janua_ready, money_path: ',retainer,dhanam-self-serve,'}
          # Trailing slash required: /api/v1/health answers 301.
          - targets: ['https://api.karafiel.mx/api/v1/health/']
            labels: {product: karafiel, flow: api, target_namespace: karafiel, check: availability, module: http_2xx_json, money_path: ',retainer,'}
          - targets: ['https://api.selva.town/health']
            labels: {product: selva, flow: api, target_namespace: selva, check: availability, module: http_2xx_json}
          - targets: ['https://api.tezca.mx/health']
            labels: {product: tezca, flow: api, target_namespace: tezca, check: availability, module: http_2xx_json}
          - targets: ['https://app.nauta.quest/health']
            labels: {product: nauta, flow: web, target_namespace: nauta, check: availability, module: http_2xx_json, money_path: ',retainer,'}
          - targets: ['https://api.forgesight.app/health']
            labels: {product: forgesight, flow: api, target_namespace: forgesight, check: availability, module: http_2xx_json}
          # Crea Tu Mundo, the vCTO client (tenant `crea` in tenants.json).
          # Its ERP is a Nauta workspace on its own hostname: replica alerts
          # in `nauta` cannot see a lost tunnel route, DNS record or
          # workspace-hostname binding, and app.nauta.quest/health does not
          # cross the binding. The root answers 401 to a JSON request (see
          # http_401_json in blackbox-exporter.yaml for why not http_401).
          - targets: ['https://erp.creatumundo.mx/']
            labels: {product: ctm-erp, flow: workspace, target_namespace: nauta, check: availability, module: http_401_json}
          # Its MAP (crea-map-web).
          - targets: ['https://map.creatumundo.mx/api/health']
            labels: {product: ctm-map, flow: web, target_namespace: crea-map, check: availability, module: http_2xx_json}

          # ---- Money paths (money-engine wave 2, 2026-10-18) -------------
          # Two more labels, read by the `money-paths` rule group below:
          #
          #   money_path  the money paths a target is a STEP of, comma-wrapped
          #               (`,retainer,dhanam-self-serve,`) so one target can
          #               belong to several. A target on a money path pages as
          #               MoneyPathDown (one page per broken PATH, critical);
          #               its own failure is the MoneyPathStepFailing warning
          #               (the digest names the step). The paths are the ones
          #               that take money TODAY:
          #                 retainer           the vCTO retainer: the Nauta
          #                                    cockpit, Karafiel (the CFDI),
          #                                    Janua (staff sign-in, email)
          #                 dhanam-self-serve  Dhanam Essentials: dhan.am
          #                                    pricing, app.dhan.am sign-up,
          #                                    Janua sign-in, the catalog, the
          #                                    API (then Stripe, not probed)
          #                 sales-booking      every other product's buy link
          #                                    ends at the Kalya booking page
          #                                    (HOSTED_CHECKOUT_ENABLED is off
          #                                    in production): madfam.io and
          #                                    kalya.app
          #   paging      `warning` for a target whose failure must NOT page
          #               (RevenueEndpointDegraded, the digest). Absent means
          #               the target pages as before.
          #
          # SEVERITY follows the journeys plan's decision 6 RECOMMENDATION
          # (UNRULED at the time of writing): Telegram pages only for a broken
          # money path on SKUs that work today; everything else warns. Only
          # NEW targets are placed by it here. The existing targets of products
          # that cannot be bought self-serve today keep paging critical until
          # the owner rules decision 6.
          #
          # Dhanam Essentials, the one self-serve SKU that works end to end.
          # Both pages render their prices and form in the browser, so the
          # server HTML only proves the page is served without a redirect.
          - targets: ['https://dhan.am/pricing']
            labels: {product: dhanam, flow: pricing-page, target_namespace: dhanam, check: availability, module: http_page_2xx, money_path: ',dhanam-self-serve,'}
          - targets: ['https://app.dhan.am/register']
            labels: {product: dhanam, flow: signup-page, target_namespace: dhanam, check: availability, module: http_page_2xx, money_path: ',dhanam-self-serve,'}
          # Janua, the sign-in rail of both money paths: discovery, signing
          # keys, and the browser's own call from Dhanam's origin (CORS).
          - targets: ['https://auth.madfam.io/.well-known/openid-configuration']
            labels: {product: janua, flow: oidc-discovery, target_namespace: janua, check: availability, module: http_oidc_discovery, money_path: ',retainer,dhanam-self-serve,'}
          - targets: ['https://auth.madfam.io/.well-known/jwks.json']
            labels: {product: janua, flow: jwks, target_namespace: janua, check: availability, module: http_jwks, money_path: ',retainer,dhanam-self-serve,'}
          - targets: ['https://auth.madfam.io/api/v1/auth/me']
            labels: {product: janua, flow: cors-dhanam, target_namespace: janua, check: availability, module: http_janua_cors_dhanam, money_path: ',dhanam-self-serve,'}
          # The booking page every product's buy link lands on today.
          - targets: ['https://kalya.app/madfam']
            labels: {product: kalya, flow: booking-page, target_namespace: kalya, check: availability, module: http_page_2xx, money_path: ',sales-booking,'}

          # Warning only (decision 6 recommendation): these SKUs cannot be
          # bought self-serve today (their buy links end at the Kalya booking
          # page), so a broken page loses a lead, not a sale. It goes to the
          # digest; it does not page.
          - targets: ['https://selva.town/pricing']
            labels: {product: selva, flow: pricing-page, target_namespace: selva, check: availability, module: http_pricing_page, paging: warning}
          - targets: ['https://karafiel.mx/precios']
            labels: {product: karafiel, flow: pricing-page, target_namespace: karafiel, check: availability, module: http_pricing_page, paging: warning}
          - targets: ['https://avala.studio/precios']
            labels: {product: avala, flow: pricing-page, target_namespace: avala, check: availability, module: http_pricing_page, paging: warning}
          - targets: ['https://tezca.mx/precios']
            labels: {product: tezca, flow: pricing-page, target_namespace: tezca, check: availability, module: http_page_2xx, paging: warning}
          - targets: ['https://routecraft.app/pricing']
            labels: {product: routecraft, flow: pricing-page, target_namespace: routecraft, check: availability, module: http_page_2xx, paging: warning}
          - targets: ['https://janua.dev/pricing']
            labels: {product: janua, flow: pricing-page, target_namespace: janua, check: availability, module: http_page_2xx, paging: warning}
          # Enclii's prices are on its landing; enclii.dev/pricing is not a
          # route (the landing answers 200 for any path).
          - targets: ['https://enclii.dev/']
            labels: {product: enclii, flow: pricing-landing, target_namespace: enclii, check: availability, module: http_pricing_page, paging: warning}
          # Dhanam FX degraded (a real but non-provider rate). The query string
          # only makes the URL distinct from the fx-source probe's (one
          # instance per target); the endpoint ignores it.
          - targets: ['https://api.dhan.am/v1/fx-rates/health?probe=fx-degraded']
            labels: {product: dhanam, flow: fx-degraded, target_namespace: dhanam, check: availability, module: http_dhanam_fx_degraded, paging: warning}
          # Karafiel's task broker (Redis), which /api/v1/health/ does not
          # gate on. Warning until it is known whether the retainer's CFDI
          # stamping is synchronous (API) or queued (worker); the stamping
          # itself is watched by the retainer-cycle rules, not by a probe.
          - targets: ['https://api.karafiel.mx/api/v1/health/?probe=cfdi-broker']
            labels: {product: karafiel, flow: cfdi-broker, target_namespace: karafiel, check: availability, module: http_karafiel_broker, paging: warning}
        relabel_configs:
          - source_labels: [__address__]
            target_label: __param_target
          - source_labels: [module]
            target_label: __param_module
          - source_labels: [__param_target]
            target_label: instance
          - target_label: __address__
            replacement: blackbox-exporter.monitoring.svc:9115

      # Geometry-factory hosts (geometry stability pass 2026-10-18, lane O1).
      # Every public host of Yantra4D, Fashion Cabinet, Pliego, Cotiza and
      # Blueprint.Tube, probed on its health path through Cloudflare and the
      # tunnel, as blackbox-revenue does. Until this job most of them were
      # watched by replica counts only: a host answering 5xx or timing out
      # behind Ready pods paged nobody. The `geometry-probes` rule group
      # (geometry-probe-rules.yml below) pages on the results:
      # GeometryHostDown (a probe failing for 3 minutes),
      # GeometryTLSCertExpiring (the served certificate expires within 14
      # days) and GeometryProbesNotRunning (this job is not being scraped).
      #
      # A job of its own, not more blackbox-revenue targets: its alerts carry
      # no `category: revenue-probe`, so they take the generic critical route
      # (critical-receiver: Courier + email, one group per alertname) and
      # leave the revenue route's email budget as it is. Two hosts are also
      # revenue targets (api.yantra4d.com/api/health; the Cotiza API, there
      # on /health/ready). When one fails both alerts fire: the revenue one
      # names the flow, this one names the factory.
      #
      # Labels on every target: product (what pages; Courier keys the page
      # on it, so each product pages once per episode), flow, target_namespace
      # (where to look first) and module. Adding a host: the same rules as
      # blackbox-revenue (a URL that answers 200 with no redirect, the module
      # chosen by its body), and add it to GEOMETRY_TARGETS in
      # tests/scripts/test_geometry_probe_rules.py.
      - job_name: 'blackbox-geometry'
        metrics_path: /probe
        scrape_interval: 60s
        scrape_timeout: 15s
        static_configs:
          # Yantra4D. The apex is a static SPA: every path, /api/health
          # included, answers 200 with index.html, so its front page is
          # judged as HTML. The studio and admin hosts answer /api/health
          # with the API's JSON report.
          - targets: ['https://yantra4d.com/']
            labels: {product: yantra4d, flow: landing, target_namespace: yantra4d, module: http_200_html}
          - targets: ['https://app.yantra4d.com/api/health']
            labels: {product: yantra4d, flow: studio, target_namespace: yantra4d, module: http_2xx_json}
          - targets: ['https://admin.yantra4d.com/api/health']
            labels: {product: yantra4d, flow: admin, target_namespace: yantra4d, module: http_2xx_json}
          - targets: ['https://api.yantra4d.com/api/health']
            labels: {product: yantra4d, flow: api, target_namespace: yantra4d, module: http_2xx_json}
          # Fashion Cabinet: one app behind two hostnames.
          - targets: ['https://fc.madfam.io/health']
            labels: {product: fashion-cabinet, flow: app, target_namespace: fashion-cabinet, module: http_2xx_json}
          - targets: ['https://fashioncabi.net/health']
            labels: {product: fashion-cabinet, flow: brand-domain, target_namespace: fashion-cabinet, module: http_2xx_json}
          # Pliego: one service behind three hostnames. The app host's root
          # redirects to /studio/; /health answers 200 on all three.
          - targets: ['https://pliego.madfam.io/health']
            labels: {product: pliego, flow: landing, target_namespace: pliego, module: http_2xx_json}
          - targets: ['https://pliego-app.madfam.io/health']
            labels: {product: pliego, flow: app, target_namespace: pliego, module: http_2xx_json}
          - targets: ['https://pliego-api.madfam.io/health']
            labels: {product: pliego, flow: api, target_namespace: pliego, module: http_2xx_json}
          # Cotiza: the web app's /api/health crosses its proxy to the API.
          - targets: ['https://cotiza.studio/api/health']
            labels: {product: cotiza, flow: web, target_namespace: digifab-quoting, module: http_2xx_json}
          - targets: ['https://api.cotiza.studio/health']
            labels: {product: cotiza, flow: api, target_namespace: digifab-quoting, module: http_2xx_json}
          # Blueprint.Tube: the landing and the API gateway.
          - targets: ['https://blueprint.tube/health']
            labels: {product: blueprint, flow: landing, target_namespace: blueprint-harvester, module: http_2xx_json}
          - targets: ['https://api.blueprint.tube/health']
            labels: {product: blueprint, flow: api, target_namespace: blueprint-harvester, module: http_2xx_json}
        relabel_configs:
          - source_labels: [__address__]
            target_label: __param_target
          - source_labels: [module]
            target_label: __param_module
          - source_labels: [__param_target]
            target_label: instance
          - target_label: __address__
            replacement: blackbox-exporter.monitoring.svc:9115
---
# Alert Rules ConfigMap
apiVersion: v1
kind: ConfigMap
metadata:
  name: prometheus-rules
  namespace: monitoring
  labels:
    app.kubernetes.io/name: prometheus
    app.kubernetes.io/component: monitoring
    app.kubernetes.io/part-of: enclii
  # REPLACE, NOT SERVER-SIDE APPLY, FOR THIS ONE OBJECT (2026-10-21).
  #
  # Prometheus loads every key of this ConfigMap (`rule_files:
  # /etc/prometheus/rules/*.yml`), so a key that is live but not in git is
  # a live rule nobody can see in review. Under the app's ServerSideApply,
  # Argo only removes data keys that argocd-controller itself owns. Two keys
  # written by `kubectl patch` on 2026-04-14 (ecosystem-alerts.yml,
  # secrets-alerts.yml) were owned by that field manager, so six months of
  # syncs left them in place and Argo still reported Synced. One of them
  # carried a second, unfiltered PodNotReady (no Succeeded/Failed exclusion,
  # for: 10m), which is why finished Job pods in crea-map and crea-sim
  # kept firing although the rule below excludes them.
  #
  # Replace=true makes each sync of this object a full PUT: the live data is
  # exactly git's, and any key added by hand is gone on the next change to
  # this file. PrometheusRuleFileNotInGit (alert-delivery-rules.yml) makes a
  # hand-added key visible in the meantime. Never `kubectl patch` a rule in:
  # add the key here, and to the rule_group regex in that rule.
  annotations:
    argocd.argoproj.io/sync-options: Replace=true
data:
  enclii-alerts.yml: |
    groups:
      - name: enclii-platform
        interval: 30s
        rules:
          # API Health
          - alert: SwitchyardAPIDown
            expr: up{job="switchyard-api"} == 0
            for: 2m
            labels:
              severity: critical
              service: switchyard-api
            annotations:
              summary: "Switchyard API is down"
              description: "Switchyard API has been down for more than 2 minutes."

          - alert: SwitchyardAPIHighLatency
            expr: histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job="switchyard-api"}[5m])) > 0.5
            for: 5m
            labels:
              severity: warning
              service: switchyard-api
            annotations:
              summary: "Switchyard API high latency"
              description: "95th percentile latency is above 500ms for 5 minutes."

          - alert: SwitchyardAPIHighErrorRate
            expr: sum(rate(http_requests_total{job="switchyard-api",status=~"5.."}[5m])) / sum(rate(http_requests_total{job="switchyard-api"}[5m])) > 0.02
            for: 5m
            labels:
              severity: warning
              service: switchyard-api
            annotations:
              summary: "Switchyard API high error rate"
              description: "Error rate is above 2% for 5 minutes."

          # Database Health
          - alert: PostgresDown
            expr: pg_up == 0
            for: 1m
            labels:
              severity: critical
              service: postgres
            annotations:
              summary: "PostgreSQL is down"
              description: "PostgreSQL database is not responding."

          - alert: PostgresHighConnections
            expr: pg_stat_activity_count / pg_settings_max_connections > 0.8
            for: 5m
            labels:
              severity: warning
              service: postgres
            annotations:
              summary: "PostgreSQL high connection usage"
              description: "Connection pool usage is above 80%."

          # PgBouncer userlist drift (availability remediation Tier 0.6, enclii#436/#441).
          # Metrics come from switchyard-api's in-process drift checker
          # (internal/reconciler/pgbouncer_drift_checker.go). Three rules on
          # purpose: (a) the drift itself, (b) the checker erroring, (c) the
          # checker dead — (a) alone can lie if the checker dies with
          # missing_users frozen at 0. Full rationale + synthetic-test recipe:
          # docs/monitoring/pgbouncer-drift-alerts.md.
          # Since 2026-10-21 (auth_query) "missing" means a login role the
          # pooler cannot authenticate by EITHER path (no userlist line and
          # auth_query cannot return it, or auth_query itself is broken);
          # roles declared in pgbouncer-config `direct-connect-roles` are not
          # counted.
          - alert: PgbouncerUserlistDrift
            expr: enclii_pgbouncer_userlist_missing_users > 0
            for: 10m
            labels:
              severity: critical
              service: pgbouncer
            annotations:
              summary: "pgbouncer userlist drift — pooler auth diverged from DB truth (the 2026-08-24 outage class)"
              description: "{{ $value }} Postgres login role(s) that pgbouncer cannot authenticate: no userlist line, and auth_query cannot return them (a superuser, no usable password) or auth_query itself is broken. Every pooled connection as those roles is failing auth right now — the drift class that took fortuna/bloom-scroll/ceq hard-down for days on 2026-08-24. GET /v1/admin/provision/pgbouncer/reconcile on switchyard-api lists them and, when the auth_query path is broken, says why (auth_query_problem: Secret data/pgbouncer-auth, role pgbouncer_auth, or pgbouncer.get_auth; fix with scripts/pgbouncer-auth-query.sh). A role that connects to Postgres directly belongs in pgbouncer-config direct-connect-roles. Otherwise repair needs the role's password from the consuming service's own secret (internal-devops/scripts/restore-pgbouncer-users.py). This alert does NOT self-heal."

          - alert: PgbouncerUserlistCheckErrors
            expr: increase(enclii_pgbouncer_userlist_check_errors_total[15m]) > 0
            for: 5m
            labels:
              severity: warning
              service: pgbouncer
            annotations:
              summary: "pgbouncer userlist drift checker is erroring"
              description: "The periodic userlist drift checker (switchyard-api, ENCLII_PGBOUNCER_DRIFT_CHECK_ENABLED) failed {{ $value }} time(s) in the last 15 minutes instead of completing a comparison. Likely causes: Postgres admin connection down, k8s API access lost, or ENCLII_POSTGRES_ADMIN_URL/k8s client not configured. Missing_users may be stale while this fires."

          - alert: PgbouncerUserlistCheckerDead
            expr: time() - enclii_pgbouncer_userlist_last_check_timestamp_seconds > 900
            for: 5m
            labels:
              severity: warning
              service: pgbouncer
            annotations:
              summary: "pgbouncer userlist drift detector itself is dead"
              description: "No successful userlist drift check has completed in over 15 minutes (checker runs every 5m). Per the availability audit's green-lies doctrine, treat this as UNKNOWN, not healthy — PgbouncerUserlistDrift staying quiet right now proves nothing. Check whether the switchyard-api process is up and whether the checker goroutine panicked/exited; see internal/reconciler/pgbouncer_drift_checker.go."

          # Redis Health
          - alert: RedisDown
            expr: redis_up == 0
            for: 1m
            labels:
              severity: critical
              service: redis
            annotations:
              summary: "Redis is down"
              description: "Redis cache is not responding."

          - alert: RedisHighMemory
            expr: (redis_memory_max_bytes > 0 and redis_memory_used_bytes / redis_memory_max_bytes > 0.85) or (redis_memory_max_bytes == 0 and redis_memory_used_bytes > 170000000)
            for: 5m
            labels:
              severity: warning
              service: redis
            annotations:
              summary: "Redis high memory usage"
              description: "Redis memory usage is above 85%."

          # Redis HA — Sentinel cluster health (P1.3, deployed 2026-04)
          # Scrapes come from the redis_exporter sidecars on the redis-ha StatefulSet.
          # The sidecars carry pod annotations `prometheus.io/scrape=true` +
          # `prometheus.io/port=9121`, so they land in the `kubernetes-pods`
          # job above. The pod label `app=redis-ha` is copied to `app` on the
          # metric via the labelmap rule. This distinguishes the HA pods from
          # the single-instance `redis` Deployment (app=redis) and from any
          # other redis-exporter Services in the cluster.
          - alert: RedisSentinelDown
            # Fewer than 3 redis-ha pods reporting healthy for > 5m. Quorum
            # holds at 2, so this is a warning — but the next failure will
            # break quorum.
            expr: count(redis_up{app="redis-ha"} == 1) < 3
            for: 5m
            labels:
              severity: warning
              service: redis-ha
              component: sentinel
            annotations:
              summary: "Redis Sentinel pod(s) unreachable"
              description: "Expected 3 Sentinel+Redis pods, observed {{ $value }} up. Quorum is still safe at 2; investigate before the next failure."
              runbook_url: "https://github.com/madfam-org/enclii/blob/main/docs/runbooks/redis-sentinel-migration.md#troubleshooting"

          - alert: RedisMasterDown
            # No master detected — this is the failover edge. 30s window
            # lets Sentinel complete auto-failover (down-after=5s, failover-timeout=18s)
            # before we page.
            expr: max(redis_instance_info{role="master", app="redis-ha"}) != 1
            for: 30s
            labels:
              severity: critical
              service: redis-ha
              component: redis
            annotations:
              summary: "Redis HA has no master"
              description: "No Redis pod in the redis-ha StatefulSet is reporting role=master. Sentinel failover may have failed. Page on-call."
              runbook_url: "https://github.com/madfam-org/enclii/blob/main/docs/runbooks/redis-sentinel-migration.md#master-loss-recovery"

          - alert: RedisReplicationLag
            # Replica slave_repl_offset falls > 30s worth of bytes behind master
            # AOF stream. Uses the `redis_master_repl_offset_bytes` +
            # `redis_connected_slave_offset_bytes` deltas exposed by redis_exporter.
            expr: |
              (
                max(redis_master_repl_offset_bytes{app="redis-ha"})
                -
                min(redis_connected_slave_offset_bytes{app="redis-ha"})
              ) > 30 * 1024 * 1024
            for: 2m
            labels:
              severity: warning
              service: redis-ha
              component: replication
            annotations:
              summary: "Redis HA replica behind master"
              description: "A Redis HA replica is >30MB behind master offset for >2m. Check network, replica disk I/O, or replica OOM."
              runbook_url: "https://github.com/madfam-org/enclii/blob/main/docs/runbooks/redis-sentinel-migration.md#replication-lag"

      - name: kubernetes-resources
        interval: 30s
        rules:
          # Node Resources
          - alert: NodeHighCPU
            expr: 100 - (avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 80
            for: 15m
            labels:
              severity: warning
            annotations:
              summary: "Node CPU high"
              description: "Node {{ $labels.instance }} CPU usage is above 80% for 15 minutes."

          - alert: NodeHighMemory
            expr: (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100 > 85
            for: 10m
            labels:
              severity: warning
            annotations:
              summary: "Node memory high"
              description: "Node {{ $labels.instance }} memory usage is above 85%."

          - alert: NodeDiskSpaceWarning
            expr: (1 - node_filesystem_avail_bytes{fstype!~"tmpfs|overlay"} / node_filesystem_size_bytes{fstype!~"tmpfs|overlay"}) * 100 > 85
            for: 10m
            labels:
              severity: warning
            annotations:
              summary: "Node disk space warning (>85%)"
              description: "Node {{ $labels.instance }} disk usage is {{ printf \"%.1f\" $value }}%. Consider cleanup."

          - alert: NodeDiskSpaceCritical
            expr: (1 - node_filesystem_avail_bytes{fstype!~"tmpfs|overlay"} / node_filesystem_size_bytes{fstype!~"tmpfs|overlay"}) * 100 > 90
            for: 5m
            labels:
              severity: critical
            annotations:
              summary: "Node disk space critical (>90%)"
              description: "Node {{ $labels.instance }} disk usage is {{ printf \"%.1f\" $value }}%. Immediate action required!"

          # Pod Resources
          - alert: PodCrashLooping
            expr: rate(kube_pod_container_status_restarts_total[15m]) > 0
            for: 5m
            labels:
              severity: warning
            annotations:
              summary: "Pod crash looping"
              description: "Pod {{ $labels.namespace }}/{{ $labels.pod }} is crash looping."

          - alert: PodNotReady
            # A pod that has Succeeded or Failed is not "not ready" — it is
            # DONE. Without this exclusion every completed CronJob pod in the
            # cluster fires: the first evaluation after kube-state-metrics
            # landed produced 342 PodNotReady alerts, of which 166 were
            # terminal-phase pods. That volume buries the real signal and is
            # how an alert stops being read, which is the same outcome as the
            # alert being dead — just arrived at from the other direction.
            expr: |
              kube_pod_status_ready{condition="true"} == 0
              unless on(namespace, pod)
              kube_pod_status_phase{phase=~"Succeeded|Failed"} == 1
            for: 5m
            labels:
              severity: warning
            annotations:
              summary: "Pod not ready"
              description: "Pod {{ $labels.namespace }}/{{ $labels.pod }} is not ready."

      - name: roundhouse-builds
        interval: 30s
        rules:
          # Build Queue Health
          - alert: RoundhouseBuildQueueBacklog
            expr: roundhouse_build_queue_depth > 10
            for: 10m
            labels:
              severity: warning
              service: roundhouse
            annotations:
              summary: "Build queue backlog growing"
              description: "Build queue has {{ $value }} pending builds for more than 10 minutes."

          - alert: RoundhouseBuildQueueStalled
            expr: roundhouse_build_queue_depth > 0 and rate(roundhouse_builds_completed_total[15m]) == 0
            for: 15m
            labels:
              severity: critical
              service: roundhouse
            annotations:
              summary: "Build queue stalled"
              description: "Builds are queued but no builds have completed in 15 minutes."

          # Build Failures
          - alert: RoundhouseBuildFailureRate
            expr: sum(rate(roundhouse_builds_failed_total[30m])) / sum(rate(roundhouse_builds_total[30m])) > 0.2
            for: 10m
            labels:
              severity: warning
              service: roundhouse
            annotations:
              summary: "High build failure rate"
              description: "Build failure rate is above 20% for the last 10 minutes."

          - alert: RoundhouseBuildFailureRateCritical
            expr: sum(rate(roundhouse_builds_failed_total[30m])) / sum(rate(roundhouse_builds_total[30m])) > 0.5
            for: 5m
            labels:
              severity: critical
              service: roundhouse
            annotations:
              summary: "Critical build failure rate"
              description: "Build failure rate is above 50% - immediate attention required."

          # Build Duration
          - alert: RoundhouseBuildSlow
            expr: histogram_quantile(0.95, rate(roundhouse_build_duration_seconds_bucket[1h])) > 600
            for: 30m
            labels:
              severity: warning
              service: roundhouse
            annotations:
              summary: "Builds running slow"
              description: "95th percentile build duration is above 10 minutes."

          # Worker Health
          - alert: RoundhouseWorkerDown
            expr: up{job="roundhouse"} == 0
            for: 2m
            labels:
              severity: critical
              service: roundhouse
            annotations:
              summary: "Roundhouse worker is down"
              description: "Roundhouse build worker has been down for more than 2 minutes."

          - alert: RoundhouseWorkerHighMemory
            expr: container_memory_working_set_bytes{namespace="enclii",container="roundhouse"} / container_spec_memory_limit_bytes{namespace="enclii",container="roundhouse"} > 0.85
            for: 10m
            labels:
              severity: warning
              service: roundhouse
            annotations:
              summary: "Roundhouse worker high memory usage"
              description: "Roundhouse worker is using more than 85% of its memory limit."

      - name: argocd-gitops
        interval: 30s
        rules:
          # Application Sync Status
          - alert: ArgoCDAppOutOfSync
            expr: argocd_app_info{sync_status!="Synced"} == 1
            for: 15m
            labels:
              severity: warning
              service: argocd
            annotations:
              summary: "ArgoCD application out of sync"
              description: "Application {{ $labels.name }} has been out of sync for more than 15 minutes."

          # SIGNAL-TO-NOISE (money-machine audit 2026-10-11, M2 F6/F12/F13).
          # These two rules paged critical every 4h on standing conditions
          # nobody acts on, so a real revenue page landed in that noise:
          #   - staging apps (karafiel-staging, selva-office-staging, ...);
          #   - apps whose only Degraded cause is a Job that failed long ago
          #     (forgesight read Degraded from 2026-08-01 while every CronJob
          #     run since had succeeded; rondelio from one failed baseline Job).
          # Both now page only for production apps whose Degraded is NOT
          # explained by stale failed Jobs alone. Nothing goes dark: each
          # excluded case has a warning twin below, in the warning digest.
          #
          # "Explained by stale failed Jobs alone" is the recording rule
          # below, per destination namespace:
          #   at least one Job in it ended Failed more than 6h ago (by
          #   creation time), AND
          #   no Job in it ended Failed within the last 6h, AND
          #   no workload in it is unhealthy: no Deployment, StatefulSet or
          #   DaemonSet short of replicas, and no Deployment whose rollout
          #   is stuck (Progressing=False, e.g. a new ReplicaSet in
          #   ImagePullBackOff while the old pod still serves: replicas look
          #   full, Argo reads Degraded, and that must keep paging).
          # So a FRESH failed Job (a migration, a backup) still pages, for 6h
          # (one page and one 4h repeat), and then drops to the digest. An
          # unhealthy workload always pages. Apps with an empty
          # dest_namespace never match the recording rule, so they keep
          # paging: the exclusion fails toward paging, not toward silence.
          # Known blind spot, accepted: an app with stale failed Jobs AND a
          # second Degraded cause that is not a workload shortfall (a
          # Degraded ExternalSecret, say) is demoted with them; the warning
          # twin still lists it. The lasting fix for stale Jobs is
          # `ttlSecondsAfterFinished` / `failedJobsHistoryLimit` in each
          # product repo's manifests.
          - record: argocd:namespace_degraded_only_by_stale_failed_jobs
            expr: |
              label_replace(
                count by (namespace) (
                  (kube_job_status_condition{condition="Failed", status="true"} == 1)
                  and on (namespace, job_name)
                  ((time() - kube_job_created) > 21600)
                ),
                "dest_namespace", "$1", "namespace", "(.+)"
              )
              unless on (dest_namespace)
              label_replace(
                (
                  count by (namespace) (kube_deployment_status_replicas_available < kube_deployment_spec_replicas)
                  or
                  count by (namespace) (kube_deployment_status_condition{condition="Progressing", status="false"} == 1)
                  or
                  count by (namespace) (kube_statefulset_status_replicas_ready < kube_statefulset_status_replicas)
                  or
                  count by (namespace) (kube_daemonset_status_number_unavailable > 0)
                  or
                  count by (namespace) (
                    (kube_job_status_condition{condition="Failed", status="true"} == 1)
                    and on (namespace, job_name)
                    ((time() - kube_job_created) <= 21600)
                  )
                ),
                "dest_namespace", "$1", "namespace", "(.+)"
              )

          - alert: ArgoCDAppDegraded
            expr: |
              (argocd_app_info{health_status="Degraded", name!~".+-staging(-.+)?"} == 1)
              unless on (dest_namespace)
              argocd:namespace_degraded_only_by_stale_failed_jobs
            for: 5m
            labels:
              severity: critical
              service: argocd
            annotations:
              summary: "ArgoCD application degraded"
              description: "Application {{ $labels.name }} health status is Degraded."

          - alert: ArgoCDAppDegradedByStaleFailedJobs
            expr: |
              (argocd_app_info{health_status="Degraded", name!~".+-staging(-.+)?"} == 1)
              and on (dest_namespace)
              argocd:namespace_degraded_only_by_stale_failed_jobs
            for: 5m
            labels:
              severity: warning
              service: argocd
            annotations:
              summary: "ArgoCD application degraded only by Jobs that failed over 6h ago"
              description: "Application {{ $labels.name }} is Degraded, and the only cause found in {{ $labels.dest_namespace }} is Jobs that ended Failed more than 6h ago; every Deployment, StatefulSet and DaemonSet there has its replicas and no rollout is stuck. Delete the stale failed Jobs once read (enclii ops pods diagnose -n {{ $labels.dest_namespace }}), and set ttlSecondsAfterFinished in the product repo."

          - alert: ArgoCDStagingAppDegraded
            expr: argocd_app_info{health_status="Degraded", name=~".+-staging(-.+)?"} == 1
            for: 30m
            labels:
              severity: warning
              service: argocd
            annotations:
              summary: "ArgoCD staging application degraded"
              description: "Staging application {{ $labels.name }} health status is Degraded. Staging never pages; fix it or retire it."

          - alert: ArgoCDAppMissing
            expr: argocd_app_info{health_status="Missing", name!~".+-staging(-.+)?"} == 1
            for: 5m
            labels:
              severity: critical
              service: argocd
            annotations:
              summary: "ArgoCD application missing"
              description: "Application {{ $labels.name }} health status is Missing."

          - alert: ArgoCDStagingAppMissing
            expr: argocd_app_info{health_status="Missing", name=~".+-staging(-.+)?"} == 1
            for: 30m
            labels:
              severity: warning
              service: argocd
            annotations:
              summary: "ArgoCD staging application missing"
              description: "Staging application {{ $labels.name }} health status is Missing. Staging never pages; fix it or retire it."

          # Sync Failures
          - alert: ArgoCDSyncFailed
            expr: increase(argocd_app_sync_total{phase="Failed"}[1h]) > 3
            for: 5m
            labels:
              severity: warning
              service: argocd
            annotations:
              summary: "ArgoCD sync failures"
              description: "Application {{ $labels.name }} has failed to sync more than 3 times in the last hour."

          # Controller Health
          - alert: ArgoCDControllerDown
            expr: up{job="argocd",service="argocd-application-controller"} == 0
            for: 2m
            labels:
              severity: critical
              service: argocd
            annotations:
              summary: "ArgoCD application controller is down"
              description: "ArgoCD application controller has been down for more than 2 minutes."

      - name: kyverno-policies
        interval: 30s
        rules:
          # Policy Violations
          - alert: KyvernoPolicyViolations
            expr: increase(kyverno_policy_results_total{rule_result="fail"}[1h]) > 10
            for: 10m
            labels:
              severity: warning
              service: kyverno
            annotations:
              summary: "Kyverno policy violations detected"
              description: "Policy {{ $labels.policy_name }} has been violated more than 10 times in the last hour."

          - alert: KyvernoAdmissionBlocked
            expr: increase(kyverno_admission_requests_total{request_allowed="false"}[30m]) > 5
            for: 5m
            labels:
              severity: warning
              service: kyverno
            annotations:
              summary: "Kyverno blocking admissions"
              description: "Kyverno has blocked more than 5 admission requests in the last 30 minutes."

          # Controller Health
          - alert: KyvernoControllerDown
            expr: up{job="kyverno"} == 0
            for: 2m
            labels:
              severity: critical
              service: kyverno
            annotations:
              summary: "Kyverno controller is down"
              description: "Kyverno admission controller has been down for more than 2 minutes."

      - name: deployment-health
        interval: 30s
        rules:
          # Deployment Rollout
          - alert: DeploymentRolloutStuck
            expr: kube_deployment_status_condition{condition="Progressing",status="false"} == 1
            for: 10m
            labels:
              severity: warning
            annotations:
              summary: "Deployment rollout stuck"
              description: "Deployment {{ $labels.namespace }}/{{ $labels.deployment }} rollout is stuck."

          - alert: DeploymentReplicasMismatch
            expr: kube_deployment_spec_replicas != kube_deployment_status_available_replicas
            for: 10m
            labels:
              severity: warning
            annotations:
              summary: "Deployment replicas mismatch"
              description: "Deployment {{ $labels.namespace }}/{{ $labels.deployment }} does not have the expected number of replicas."

          # StatefulSet Health
          - alert: StatefulSetReplicasMismatch
            expr: kube_statefulset_status_replicas != kube_statefulset_status_replicas_ready
            for: 10m
            labels:
              severity: warning
            annotations:
              summary: "StatefulSet replicas not ready"
              description: "StatefulSet {{ $labels.namespace }}/{{ $labels.statefulset }} replicas are not ready."

      - name: cronjob-health
        interval: 60s
        rules:
          # CronJob Failures
          - alert: CronJobFailed
            expr: kube_job_status_failed{namespace=~"enclii|monitoring|data"} > 0
            for: 5m
            labels:
              severity: warning
            annotations:
              summary: "CronJob failed"
              description: "Job {{ $labels.namespace }}/{{ $labels.job_name }} has failed."

          # The LATEST scheduled run has not succeeded: scheduled more than 2h
          # ago (the Job's own deadline is 30m) with no success since. This
          # used to be `kube_job_status_failed > 0`, which matched every failed
          # Job object still in the cluster and never resolved: after Courier
          # was armed on 2026-09-25 it paged for runs from 2026-08-02 and
          # 08-09 although every weekly run since had passed.
          - alert: BackupVerifyFailed
            expr: |
              (
                kube_cronjob_status_last_schedule_time{namespace="data",cronjob="backup-verify"}
                > on (namespace, cronjob)
                kube_cronjob_status_last_successful_time{namespace="data",cronjob="backup-verify"}
              )
              and on (namespace, cronjob)
              (time() - kube_cronjob_status_last_schedule_time{namespace="data",cronjob="backup-verify"}) > 7200
            for: 5m
            labels:
              severity: critical
              service: backup
            annotations:
              summary: "Backup verification's latest run did not succeed"
              description: "The latest scheduled run of {{ $labels.namespace }}/{{ $labels.cronjob }} has not succeeded (failed, or still running past its deadline). DR readiness at risk. Find it with: kubectl -n data get jobs --sort-by=.metadata.creationTimestamp | grep backup-verify"

          - alert: PostgresBackupMissing
            expr: time() - max(kube_job_status_completion_time{job_name=~"postgres-backup.*"}) > 90000
            for: 5m
            labels:
              severity: critical
              service: postgres
            annotations:
              summary: "PostgreSQL backup missing"
              description: "No successful PostgreSQL backup job completed in the last 25 hours."

          - alert: K3sBackupMissing
            expr: time() - max(kube_job_status_completion_time{job_name=~"k3s-datastore-backup.*"}) > 90000
            for: 5m
            labels:
              severity: critical
              service: backup
            annotations:
              summary: "K3s datastore backup missing"
              description: "No successful k3s backup in 25 hours."

          - alert: GitHubBackupMissing
            expr: time() - max(kube_job_status_completion_time{job_name=~"github-repos-backup.*"}) > 90000
            for: 5m
            labels:
              severity: critical
              service: backup
            annotations:
              summary: "GitHub repository backup missing"
              description: "No successful GitHub repo backup in 25 hours."

          - alert: CloudflareBackupMissing
            expr: time() - max(kube_job_status_completion_time{job_name=~"cloudflare-config-backup.*"}) > 90000
            for: 5m
            labels:
              severity: warning
              service: backup
            annotations:
              summary: "Cloudflare config backup missing"
              description: "No successful Cloudflare config backup in 25 hours."

          # The LATEST scheduled run has not succeeded: scheduled more than 2h
          # ago (the longest Job deadline here is 1h) with no success since.
          # Resolves on the next good run. This used to be
          # `kube_job_status_failed > 0`, which matched every failed Job object
          # still in the cluster and never resolved: after Courier was armed on
          # 2026-09-25 it paged nine times for runs from June to August,
          # although every run of all four CronJobs since had succeeded.
          - alert: BackupJobFailed
            expr: |
              (
                kube_cronjob_status_last_schedule_time{namespace="data",cronjob=~"(k3s-datastore|github-repos|cloudflare-config|argocd-secrets)-backup"}
                > on (namespace, cronjob)
                kube_cronjob_status_last_successful_time{namespace="data",cronjob=~"(k3s-datastore|github-repos|cloudflare-config|argocd-secrets)-backup"}
              )
              and on (namespace, cronjob)
              (time() - kube_cronjob_status_last_schedule_time{namespace="data",cronjob=~"(k3s-datastore|github-repos|cloudflare-config|argocd-secrets)-backup"}) > 7200
            for: 5m
            labels:
              severity: critical
              service: backup
            annotations:
              summary: "Backup {{ $labels.cronjob }}: latest run did not succeed"
              description: "The latest scheduled run of {{ $labels.namespace }}/{{ $labels.cronjob }} has not succeeded (failed, or still running past its deadline). Find it with: kubectl -n data get jobs --sort-by=.metadata.creationTimestamp | grep {{ $labels.cronjob }}"

          # HPA Scaling
          - alert: HPAMaxedOut
            expr: kube_horizontalpodautoscaler_status_current_replicas == kube_horizontalpodautoscaler_spec_max_replicas
            for: 30m
            labels:
              severity: warning
            annotations:
              summary: "HPA at maximum replicas"
              description: "HPA {{ $labels.namespace }}/{{ $labels.horizontalpodautoscaler }} has been at max replicas for 30 minutes."

  maintenance-alerts.yml: |
    groups:
      - name: maintenance-health
        interval: 60s
        rules:
          # CronJob failure detection
          - alert: MaintenanceCronJobFailed
            expr: kube_job_status_failed{namespace="enclii",job_name=~"node-maintenance.*"} > 0
            for: 10m
            labels:
              severity: warning
              service: maintenance
            annotations:
              summary: "Node maintenance job failed"
              description: "Job {{ $labels.job_name }} failed — disk cleanup not running."

          # Stale metrics = CronJob not running at all
          - alert: NodeMaintenanceStale
            expr: (time() - node_maintenance_last_run_timestamp_seconds) > 172800
            for: 10m
            labels:
              severity: warning
              service: maintenance
            annotations:
              summary: "Node maintenance hasn't run in 48h on {{ $labels.instance }}"
              description: "Last run was {{ $value | humanizeDuration }} ago. CronJob may be suspended or failing silently."

      - name: predictive-disk
        interval: 60s
        rules:
          - alert: NodeDiskWillFillIn7Days
            expr: predict_linear(node_filesystem_avail_bytes{mountpoint="/",fstype!~"tmpfs|overlay"}[7d], 86400 * 7) < 0
            for: 1h
            labels:
              severity: warning
              service: node
            annotations:
              summary: "Disk will be full within 7 days on {{ $labels.instance }}"
              description: "Linear projection of root filesystem shows exhaustion within 7 days. Current avail: {{ $value | humanize1024 }}B."

      - name: storage-health
        interval: 60s
        rules:
          - alert: LonghornOrphanedVolume
            expr: longhorn_volume_robustness{robustness="unknown"} == 1
            for: 24h
            labels:
              severity: warning
              service: longhorn
            annotations:
              summary: "Longhorn volume {{ $labels.volume }} detached >24h"
              description: "Volume may be orphaned. Check with: kubectl get volumes.longhorn.io -n longhorn-system"

          - alert: LonghornVolumedegraded
            expr: longhorn_volume_robustness{robustness="degraded"} == 1
            for: 30m
            labels:
              severity: warning
              service: longhorn
            annotations:
              summary: "Longhorn volume {{ $labels.volume }} is degraded"
              description: "Volume has fewer healthy replicas than expected for 30m."

  longhorn-filesystem-health.yml: |
    groups:
      - name: longhorn-filesystem-health
        interval: 60s
        rules:
          # Detect disk I/O saturation before EXT4 errors
          - alert: LonghornVolumeIOSaturation
            expr: rate(node_disk_io_time_weighted_seconds_total[5m]) > 0.95
            for: 10m
            labels:
              severity: warning
              service: longhorn
            annotations:
              summary: "Disk I/O saturation on {{ $labels.instance }} device {{ $labels.device }}"
              description: "I/O weighted time ratio is {{ $value | humanizePercentage }} for 10m. EXT4 corruption risk increases under sustained I/O pressure."

          # Heuristic: FS corruption causing pod crash loops in stateful namespaces
          - alert: PodWriteFailureCrashLoop
            expr: increase(kube_pod_container_status_restarts_total{namespace=~"data|enclii|monitoring"}[30m]) > 5 and on(namespace, pod) kube_pod_container_status_last_terminated_reason{reason="Error"}
            for: 5m
            labels:
              severity: critical
              service: longhorn
            annotations:
              summary: "Pod {{ $labels.namespace }}/{{ $labels.pod }} crash-looping with errors (possible FS corruption)"
              description: "{{ $value }} restarts in 30m with Error termination in a stateful namespace. Check volume health: kubectl get volumes.longhorn.io -n longhorn-system"

          # Volume capacity exhaustion
          - alert: LonghornVolumeNearFull
            expr: (longhorn_volume_actual_size_bytes / longhorn_volume_capacity_bytes) > 0.9
            for: 1h
            labels:
              severity: warning
              service: longhorn
            annotations:
              summary: "Longhorn volume {{ $labels.volume }} is {{ $value | humanizePercentage }} full"
              description: "Volume is above 90% capacity for 1h. Expand or clean up data to prevent write failures."

          # Snapshot bloat (2026-10-17). actualSize counts every snapshot in the
          # volume's chain, so on a volume that rewrites its data (TSDB, WAL,
          # index) it climbs far past the claim while the filesystem is fine:
          # prometheus-rules-eval read 5.8x, prometheus-data 3.2x, loki 2.0x,
          # the shared postgres 1.8x. That eats node disk that Longhorn then
          # cannot schedule replicas onto. Expanding the claim does not help
          # (a bigger volume grows bigger snapshots); the fix is the volume's
          # recurring-job group and pruning stranded snapshots, per
          # infra/helm/longhorn/recurring-jobs.yaml. Warning: digest only.
          - alert: LonghornSnapshotBloat
            expr: (longhorn_volume_actual_size_bytes / longhorn_volume_capacity_bytes) > 1.5
            for: 6h
            labels:
              severity: warning
              service: longhorn
            annotations:
              summary: "Longhorn volume {{ $labels.volume }} holds {{ $value | humanize }}x its size in snapshots"
              description: "actualSize / capacity has been above 1.5 for 6h. The excess is snapshot history, not data. Move the volume to the recurring-job group that matches its churn (high-churn for TSDB/WAL/index volumes) and delete the snapshots the old group stranded: procedure in infra/helm/longhorn/recurring-jobs.yaml."

  chronic-restart-rules.yml: |
    # Chronic crash-loop detection across the entire MADFAM platform.
    # Existing PodWriteFailureCrashLoop catches 30m bursts; this group
    # catches long-tail accumulators that the audit (2026-05-04) flagged:
    # forj-api at 1999 restarts in 7 days, nuit-one-web at 1611 over
    # 5d16h, redis-ha sentinel at 403 over 16d. Those slipped because
    # no rule operated on a 24h+ window.
    groups:
      - name: chronic-restart
        interval: 1m
        rules:
          # 24-hour window — early signal that a service is degrading
          # before it shows up in the multi-day chronic counter.
          - alert: PodChronicRestart24h
            expr: |
              sum by (namespace, pod) (
                increase(kube_pod_container_status_restarts_total[24h])
              ) > 50
            for: 15m
            labels:
              severity: warning
              category: chronic-restart
              window: 24h
            annotations:
              summary: "{{ $labels.namespace }}/{{ $labels.pod }} restarted >50 times in 24h"
              description: "{{ $value }} restarts in 24h. Investigate via `kubectl logs -n {{ $labels.namespace }} {{ $labels.pod }} --previous` and triage before it becomes a multi-day chronic."
              runbook: "https://github.com/madfam-org/internal-devops/blob/main/runbooks/chronic-restart-triage.md"

          # 7-day window — explicit catch for the long-tail crash-loops
          # the audit found rotting in the cluster.
          #
          # Staging namespaces are excluded from this critical rule
          # (money-machine audit 2026-10-11, M2 F6/F13): karafiel-staging's
          # admin at 1,104 restarts paged every 4h. PodChronicRestart24h above
          # (warning, every namespace) still reports a staging crash loop in
          # the digest.
          #
          # ONLY PODS THAT STILL EXIST (infra-stability audit 2026-10-17). A 7d
          # range keeps a deleted pod's samples for 7 days, so a pod that
          # crash-looped and was REPLACED kept this critical firing for a week
          # after the loop ended. The logging namespace paged 38 times that
          # way: every fluent-bit pod was replaced on 10-14 and has 0 restarts
          # since, while the old pods' counters stayed in the window. loki-0
          # shows the second half: a StatefulSet pod comes back under the SAME
          # name, so the join is on `uid` (kube-state-metrics puts it on both
          # series), not on the name. A pod that is still restarting is still
          # caught, under its current uid.
          - alert: PodChronicRestart7d
            expr: |
              sum by (namespace, pod) (
                increase(kube_pod_container_status_restarts_total{namespace!~".+-staging"}[7d])
                and on (uid) kube_pod_info
              ) > 200
            for: 30m
            labels:
              severity: critical
              category: chronic-restart
              window: 7d
            annotations:
              summary: "{{ $labels.namespace }}/{{ $labels.pod }} restarted >200 times in 7d"
              description: "{{ $value }} restarts over 7 days. Service is in chronic crash-loop. Either fix the root cause, scale to 0, or remove the deployment. Persistent crash-loops consume scheduler attention + alert noise + PVC slots."
              runbook: "https://github.com/madfam-org/internal-devops/blob/main/runbooks/chronic-restart-triage.md"

          # Pod has been Pending or ContainerCreating for too long.
          # Caught the sim4d-studio :latest 16d / 102K-failed-pull issue.
          - alert: PodStuckNotRunning
            expr: |
              kube_pod_status_phase{phase=~"Pending|Unknown"} == 1
              unless
              on(namespace, pod) kube_pod_status_ready{condition="true"} == 1
            for: 6h
            labels:
              severity: warning
              category: chronic-restart
            annotations:
              summary: "{{ $labels.namespace }}/{{ $labels.pod }} not Running for 6h+"
              description: "Pod has been in Pending/Unknown phase for over 6 hours. Common causes: image pull failure (check `kubectl describe pod` events), PVC unbindable, taint mismatch. The sim4d-studio :latest tag missing-from-registry incident (102,575 failed pulls over 16 days) would have fired here."
              runbook: "https://github.com/madfam-org/internal-devops/blob/main/runbooks/chronic-restart-triage.md"

  # =========================================================================
  # SLO-selector fix (availability remediation Tier 0.3, 2026-08-26).
  #
  # The selector below was `namespace=~"tenant-.*"` until this fix. No code
  # has ever created a `tenant-*` namespace (see internal-devops audit #3),
  # so every rule in this group was inert from the day it was written — a
  # live rule with a dead selector is a different flavor of the same "green
  # lie" as a rule that never loads at all. The corrected enumerated-namespace
  # selector was already written and committed, correctly, in the dead
  # PrometheusRule copy at prometheus-client-slo-rules.yaml (enclii #416
  # follow-up) — but because that object is a PrometheusRule CRD with no
  # operator to reconcile it, the fix never reached the running evaluator.
  # Ported here verbatim from that CRD's spec.
  #
  # Keep this selector in sync with any future client-namespace scheme
  # change. When a new client onboards under a bare namespace, add it here,
  # to EVERY rule in the group: the five rules share one selector so that a
  # namespace is either fully covered or not covered at all.
  # tests/scripts/test_client_slo_rules.py fails if the copies drift apart.
  #
  # `voxa` added 2026-10-05: the production namespace had kube-state-metrics
  # series but no critical availability rule, so a voxa Deployment below its
  # desired replicas paged nobody (only PodCrashLooping, ArgoCDAppDegraded and
  # the shared-dependency rules covered it). PromQL anchors `=~` at both ends,
  # so `voxa` does NOT match `voxa-staging`. Staging stays out on purpose: it
  # can run an old build for weeks and would page falsely. Add a staging
  # namespace here only once it is held to production's availability bar.
  #
  # 2026-10-11 (money-machine audit M2 F5): seven revenue namespaces were not
  # covered at all, so a Deployment below its desired replicas in any of them
  # paged nobody: `digifab-quoting` (Cotiza), `yantra4d`, `kalya`,
  # `madfam-site` (madfam.io), `avala`, `factlas`, `routecraft`. Names verified
  # against the Argo applications' resource namespaces (`enclii ops apps
  # status --json`). Added to every rule in the group.
  #
  # Same day, the `namespace!~".+-staging"` matcher: `enclii-.*` also matched
  # `enclii-dhanam-staging` and `enclii-karafiel-staging`, so a staging
  # Deployment short of replicas paged critical exactly like production (M2 F6,
  # F13). PromQL accepts two matchers on one label; the series must satisfy
  # both. Every rule carries the pair, and the test checks that too.
  #
  # 2026-10-17 (infra-stability audit E3 F4): `enclii` itself, the self-serve
  # front door (enclii.dev, app.enclii.dev, docs.enclii.dev, the API and the
  # status pages run there). `enclii-.*` needs a dash, and `=~` is anchored at
  # both ends, so the bare namespace was never matched and a Deployment short
  # of replicas there paged nobody. Added as its own alternative to every
  # rule in the group; `enclii-<app>-staging` stays excluded by the pair.
  #
  # Same day (infra-stability W1): `crea-map`, Crea Tu Mundo's MAP (the vCTO
  # client). Its namespace also runs the rehearsal deployment
  # `crea-map-ensayo-web` (Argo app crea-map-ensayo), which must never page:
  # every rule that has a per-workload label carries
  # `deployment|pod|service!~"crea-map-ensayo(-.*)?"`. A series without that
  # label has it empty, which the matcher passes, so nothing else is hidden.
  # TenantResourceQuotaNearLimit is namespace-scoped and cannot tell the two
  # apart; the quota is shared, so ensayo usage counts toward it (warning).
  # =========================================================================
  client-slo-rules.yml: |
    groups:
      - name: client-slo
        interval: 30s
        rules:
          - alert: ClientServiceErrorRate
            expr: |
              (
                sum by (namespace) (rate(http_requests_total{code=~"5..", namespace=~"enclii|enclii-.*|project-.*|nauta|janua|karafiel|coupler|dhanam|tezca|pravara-mes|primavera3d|fortuna|forgesight|selva|voxa|digifab-quoting|yantra4d|kalya|madfam-site|avala|factlas|routecraft|crea-map", namespace!~".+-staging", pod!~"crea-map-ensayo(-.*)?", service!~"crea-map-ensayo(-.*)?"}[5m]))
                /
                sum by (namespace) (rate(http_requests_total{namespace=~"enclii|enclii-.*|project-.*|nauta|janua|karafiel|coupler|dhanam|tezca|pravara-mes|primavera3d|fortuna|forgesight|selva|voxa|digifab-quoting|yantra4d|kalya|madfam-site|avala|factlas|routecraft|crea-map", namespace!~".+-staging", pod!~"crea-map-ensayo(-.*)?", service!~"crea-map-ensayo(-.*)?"}[5m]))
              ) > 0.01
            for: 5m
            labels:
              severity: warning
              category: client-slo
            annotations:
              summary: "High error rate in client namespace {{ $labels.namespace }}"
              description: "Error rate {{ $value | humanizePercentage }} exceeds 1% threshold for 5m."

          - alert: ClientServiceLatencyP95
            expr: |
              histogram_quantile(0.95,
                sum by (namespace, le) (rate(http_request_duration_seconds_bucket{namespace=~"enclii|enclii-.*|project-.*|nauta|janua|karafiel|coupler|dhanam|tezca|pravara-mes|primavera3d|fortuna|forgesight|selva|voxa|digifab-quoting|yantra4d|kalya|madfam-site|avala|factlas|routecraft|crea-map", namespace!~".+-staging", pod!~"crea-map-ensayo(-.*)?", service!~"crea-map-ensayo(-.*)?"}[5m]))
              ) > 2
            for: 5m
            labels:
              severity: warning
              category: client-slo
            annotations:
              summary: "High P95 latency in client namespace {{ $labels.namespace }}"
              description: "P95 latency {{ $value | humanizeDuration }} exceeds 2s threshold."

          - alert: ClientPodRestartRate
            expr: |
              sum by (namespace) (
                increase(kube_pod_container_status_restarts_total{namespace=~"enclii|enclii-.*|project-.*|nauta|janua|karafiel|coupler|dhanam|tezca|pravara-mes|primavera3d|fortuna|forgesight|selva|voxa|digifab-quoting|yantra4d|kalya|madfam-site|avala|factlas|routecraft|crea-map", namespace!~".+-staging", pod!~"crea-map-ensayo(-.*)?"}[1h])
              ) > 3
            for: 5m
            labels:
              severity: warning
              category: client-slo
            annotations:
              summary: "Excessive pod restarts in {{ $labels.namespace }}"
              description: "{{ $value }} restarts in the last hour (threshold: 3)."

          - alert: ClientDeploymentUnavailable
            expr: |
              kube_deployment_status_replicas_available{namespace=~"enclii|enclii-.*|project-.*|nauta|janua|karafiel|coupler|dhanam|tezca|pravara-mes|primavera3d|fortuna|forgesight|selva|voxa|digifab-quoting|yantra4d|kalya|madfam-site|avala|factlas|routecraft|crea-map", namespace!~".+-staging", deployment!~"crea-map-ensayo(-.*)?"}
              <
              kube_deployment_spec_replicas{namespace=~"enclii|enclii-.*|project-.*|nauta|janua|karafiel|coupler|dhanam|tezca|pravara-mes|primavera3d|fortuna|forgesight|selva|voxa|digifab-quoting|yantra4d|kalya|madfam-site|avala|factlas|routecraft|crea-map", namespace!~".+-staging", deployment!~"crea-map-ensayo(-.*)?"}
            for: 5m
            labels:
              severity: critical
              category: client-slo
            annotations:
              summary: "Deployment {{ $labels.deployment }} unavailable in {{ $labels.namespace }}"
              description: "Available replicas ({{ $value }}) < desired for 5m."

          - alert: TenantResourceQuotaNearLimit
            expr: |
              (
                kube_resourcequota{type="used", namespace=~"enclii|enclii-.*|project-.*|nauta|janua|karafiel|coupler|dhanam|tezca|pravara-mes|primavera3d|fortuna|forgesight|selva|voxa|digifab-quoting|yantra4d|kalya|madfam-site|avala|factlas|routecraft|crea-map", namespace!~".+-staging"}
                /
                kube_resourcequota{type="hard", namespace=~"enclii|enclii-.*|project-.*|nauta|janua|karafiel|coupler|dhanam|tezca|pravara-mes|primavera3d|fortuna|forgesight|selva|voxa|digifab-quoting|yantra4d|kalya|madfam-site|avala|factlas|routecraft|crea-map", namespace!~".+-staging"}
              ) > 0.9
            for: 5m
            labels:
              severity: warning
              category: client-slo
            annotations:
              summary: "Quota {{ $labels.resource }} near limit in {{ $labels.namespace }}"
              description: "Usage at {{ $value | humanizePercentage }} of quota."

  # =========================================================================
  # Secret integrity + probe-target correctness (added 2026-08-06)
  # -------------------------------------------------------------------------
  # These rules live HERE, in the ConfigMap, and not in a PrometheusRule CR,
  # because this cluster has no prometheus-operator: `monitoring/prometheus`
  # is a plain Deployment started with `rule_files: /etc/prometheus/rules/
  # *.yml`, which is this ConfigMap. Verified 2026-08-06 against the running
  # Prometheus: /api/v1/rules lists 18 groups, every one of them from
  # /etc/prometheus/rules/*.yml, and none from any PrometheusRule object.
  #
  # NOTE: adding a key here does not reload Prometheus by itself. The kubelet
  # propagates the ConfigMap to the pod within ~60s, then Prometheus must be
  # told to re-read: `curl -X POST http://prometheus.monitoring:9090/-/reload`
  # (--web.enable-lifecycle is on) or restart the pod.
  # =========================================================================
  secret-integrity-rules.yml: |
    groups:
      - name: secret-key-count
        interval: 30s
        rules:
          # THE 2026-06-13 / 2026-08-06 CONTROL.
          # dhanam-secrets is written by three ExternalSecrets. While one of
          # them used a non-Merge creationPolicy, the target Secret cycled
          # 23 -> 2 -> 10 -> 23 keys every 15m, and any pod starting inside
          # that window came up with no DATABASE_URL and CrashLooped.
          #
          # This deliberately does NOT look at
          # ExternalSecret.status.conditions[Ready]: every writer reported
          # Ready=True for the entire incident. It counts keys on the Secret
          # itself, via the secret-key-count-exporter.
          - alert: SecretKeyCountBelowExpected
            expr: |
              secret_key_count
                < on(secret_namespace, secret_name)
              secret_key_count_min_expected
            for: 1m
            labels:
              severity: critical
              category: platform
            annotations:
              summary: "Secret {{ $labels.secret_namespace }}/{{ $labels.secret_name }} lost keys ({{ $value }} present)"
              description: |
                {{ $labels.secret_namespace }}/{{ $labels.secret_name }} is
                holding {{ $value }} keys, below the minimum this Secret is
                expected to carry. The usual cause is a multi-writer
                ExternalSecret target where at least one writer does NOT use
                creationPolicy: Merge — Owner and Orphan both reconcile the
                Secret down to just that writer's keys, wiping the others
                until they re-reconcile.

                Pods that start inside the window come up with missing env and
                CrashLoop. The ExternalSecrets will all still say Ready=True.

                Triage:
                  kubectl get externalsecret -n {{ $labels.secret_namespace }} \
                    -o custom-columns=NAME:.metadata.name,TARGET:.spec.target.name,POLICY:.spec.target.creationPolicy
                Every writer of this Secret must be Merge.
                Docs: docs/infrastructure/EXTERNAL_SECRETS.md

          # "Are we still looking?" Without this, deleting the target, losing
          # RBAC or the exporter dying reads exactly like a healthy Secret.
          - alert: DhanamSecretsKeyCountUnmonitored
            expr: |
              absent(secret_key_count{secret_namespace="dhanam",secret_name="dhanam-secrets"})
            for: 15m
            labels:
              severity: critical
              category: platform
            annotations:
              summary: "No key-count signal for dhanam/dhanam-secrets"
              description: |
                secret_key_count for dhanam/dhanam-secrets has been absent for
                15m, so the multi-writer wipe that broke production on
                2026-06-13 and again on 2026-08-06 is currently undetectable.
                Check the secret-key-count-exporter Deployment in the
                monitoring namespace and its scrape target.

          # A read failure must be visible as a read failure. The exporter
          # deliberately emits NO count when it cannot read, so a lost
          # RoleBinding would otherwise be silent.
          - alert: SecretKeyCountCheckFailing
            expr: |
              secret_key_count_check_success == 0
            for: 10m
            labels:
              severity: warning
              category: platform
            annotations:
              summary: "Cannot read {{ $labels.secret_namespace }}/{{ $labels.secret_name }} to count keys"
              description: |
                The secret-key-count-exporter has failed to read this Secret
                for 10m — usually a missing/removed RoleBinding, a renamed
                Secret, or an API problem. The key-count alert cannot fire
                while this is true.

      - name: cloudflared-probe-misconfigured
        interval: 30s
        rules:
          # THE 2026-08-06 FAULT 2 CONTROL.
          # The probe dialed dhanam-api:3000 and janua-api:8080 — ports those
          # Services do not publish. Dialing a nonexistent Service port times
          # out exactly like a CNI drop, so the probe blamed NetworkPolicy and
          # a real outage became indistinguishable from standing noise.
          - alert: CloudflaredProbeTargetMisconfigured
            expr: |
              cloudflared_probe_target_misconfigured == 1
            for: 5m
            labels:
              severity: warning
              category: platform
            annotations:
              summary: "Probe target {{ $labels.service }}:{{ $labels.port }} dials a port the Service does not publish"
              description: |
                The synthetic probe compared its target against the live
                Service and found reason={{ $labels.reason }}. This is a
                CONFIGURATION fault, not a network fault: fix the entry in the
                cloudflared-probe-targets ConfigMap (or publish the port on
                the Service in its own repo). Until then this target's
                reachability signal is meaningless.

                Note: the target's own namespace is in the `exported_namespace`
                label — `namespace` here is the probe's own namespace, which
                the scrape overwrites.

          # If the cross-check cannot run, "no misconfigured targets" means
          # "never looked". Make that state visible rather than reassuring.
          - alert: CloudflaredProbeServiceCheckUnavailable
            expr: |
              cloudflared_probe_service_check_unavailable == 1
            for: 30m
            labels:
              severity: warning
              category: platform
            annotations:
              summary: "cloudflared-probe cannot verify Service ports"
              description: |
                The probe could not read target Services from the Kubernetes
                API for 30m (missing ClusterRole/ServiceAccount, API
                unreachable, or SERVICE_PORT_CHECK disabled). While this is 1,
                a target dialing an unpublished Service port is
                indistinguishable from a NetworkPolicy drop — the exact
                confusion of 2026-08-06.

  # =========================================================================
  # THE 2026-08-11 CONTROL — a rollout that never landed.
  #
  # avala-services failed its PreSync migrate hook on 2026-08-07T19:18:34Z,
  # Argo retried 5 times and gave up, and prod served two-commit-old pods for
  # four days. Nothing alerted, because every available signal was green:
  #
  #   - Argo health stayed `Healthy` — a failed sync leaves the PREVIOUS pods
  #     running, and those pods were fine.
  #   - Every HTTP surface returned 200, for the same reason.
  #   - `argo_main_parity_drift_sources` stayed 0, because Argo records
  #     `sync.revision` for a sync that FAILED, so revision parity held.
  #   - The repo's own post-deploy gate asserts live behaviour, not which
  #     commit is live, so old-but-working also reads as pass.
  #
  # The missing question was never "is prod healthy" or "is the revision
  # right" but "did the rollout actually land". `argo_main_rollout_ok`
  # answers it: revision parity AND Synced AND last operation not failed.
  #
  # These rules live HERE and not in the PrometheusRule in
  # deploy-pipeline-monitor.yaml: there is no prometheus-operator on this
  # cluster, so PrometheusRule objects are inert. Prometheus reads
  # rule_files: /etc/prometheus/rules/*.yml, which is this ConfigMap.
  #
  # After editing: kubelet propagates the ConfigMap within ~60s, then
  # `curl -X POST http://prometheus.monitoring:9090/-/reload`.
  # =========================================================================
  deploy-parity-alerts.yml: |
    groups:
      - name: argo-rollout-truth
        interval: 1m
        rules:
          # WARNING, NOT CRITICAL (infra-stability audit 2026-10-17, pager
          # noise plan). Both rollout rules below page nobody: they go to the
          # warning email digest. Their own text says why: a failed sync
          # leaves the previous pods serving, so nothing a client sees is down
          # while they fire. In the 14 days to 10-17 they sent 171 of 772
          # Telegram pages (87 + 84, the second all for a staging app), almost
          # all for standing conditions. A real outage behind a failed rollout
          # still pages through ClientDeploymentUnavailable, ArgoCDAppDegraded
          # or the revenue probes, which stay critical.
          - alert: ArgoMainRolloutNotLanded
            expr: |
              argo_main_rollout_failed_sources > 0
            for: 15m
            labels:
              severity: warning
              category: deploy-parity
            annotations:
              summary: "An ArgoCD app tracking main has not rolled out its target revision"
              description: |
                At least one Git-backed prod Argo source is not genuinely
                running GitHub main: either it is OutOfSync, or its last sync
                operation failed. Inspect `argo_main_rollout_ok` labels for the
                offending application/repo/path.

                Argo health and HTTP probes will BOTH look fine while this is
                firing — a failed sync leaves the previous pods serving. Do not
                dismiss this because the site is up.

                Triage:
                  kubectl -n argocd get application <app> \
                    -o jsonpath='{.status.sync.status}{" "}{.status.operationState.phase}{" "}{.status.operationState.message}'
              runbook: docs/runbooks/deploy-pipeline-monitor.md

          # Escalates the same condition on duration. 15m catches the incident;
          # this catches the "nobody looked at the ticket" tail — the actual
          # 2026-08-07 failure mode, where Argo's automated sync will not retry
          # a revision it already failed, so a stuck app stays stuck silently
          # until the next commit lands.
          - alert: ArgoMainRolloutStuckForTooLong
            expr: |
              max(argo_main_rollout_stuck_seconds) by (application, repo) > 7200
            for: 10m
            labels:
              severity: warning
              category: deploy-parity
            annotations:
              summary: "{{ $labels.application }} has had a failed sync for over 2h"
              description: |
                The last sync operation for {{ $labels.application }}
                ({{ $labels.repo }}) failed {{ $value | humanizeDuration }} ago
                and has not been retried successfully.

                Argo's automated sync does NOT retry a revision that already
                failed, so this will not clear on its own — it needs either a
                new commit on main or a manual sync.
              runbook: docs/runbooks/deploy-pipeline-monitor.md

          # The monitor emits rollout metrics only when it completes. Absence
          # must read as "not measured", never as "nothing wrong".
          - alert: ArgoRolloutTruthUnavailable
            expr: |
              absent(argo_main_rollout_failed_sources)
            for: 30m
            labels:
              severity: warning
              category: deploy-parity
            annotations:
              summary: "No rollout-truth signal from the argo-main-parity monitor"
              description: |
                `argo_main_rollout_failed_sources` has been absent for 30m, so
                a stuck rollout is currently undetectable. Check the
                argo-main-parity-monitor CronJob in the monitoring namespace
                and its Pushgateway target.
              runbook: docs/runbooks/deploy-pipeline-monitor.md

  # =========================================================================
  # Backup and restore freshness (rewritten 2026-09-24, estate blocker A1).
  #
  # WHY THE PREVIOUS RULES COULD NOT DO THEIR JOB
  #   - PgBackRestCheckUnhealthy and PgBackRestRestoreDrillOverdue read
  #     pgbackrest_check_* / pgbackrest_restore_drill_* textfile metrics.
  #     Those were never collected: the check and drill pods mount no
  #     node-exporter textfile directory, so `[ -d "$METRICS_DIR" ]` was
  #     always false and nothing was written. Both rules were therefore
  #     permanently firing on `absent()`, which is as useless as never
  #     firing: a page that is always on teaches everyone to ignore it.
  #   - PostgresWALArchiveBehind / PostgresWALLagHigh read
  #     pg_stat_archiver_last_archive_age_seconds. postgres-exporter v0.15.0
  #     exports pg_stat_archiver_last_archive_age (no `_seconds`; see
  #     cmd/postgres_exporter/queries.go and postgres_exporter.go at that
  #     tag), so both could never fire.
  #   - PostgresBackupJobsStale took max(kube_job_status_completion_time)
  #     over retained Jobs. When history rotates the Jobs away the series
  #     vanishes and the rule goes silent, exactly when it matters.
  #   - PgBackRestCronJobFailed fired on every RETAINED failed Job, so it
  #     kept firing for days after recovery and said nothing about staleness.
  #
  # WHAT THESE READ NOW (verified exporters, no new metrics)
  #   - kube-state-metrics v2.15.0 (`--resources` includes cronjobs):
  #     kube_cronjob_created and kube_cronjob_status_last_successful_time,
  #     labels {namespace, cronjob}. The success timestamp lives on the
  #     CronJob, so it survives Job history rotation and TTL deletion. It is
  #     ABSENT for a CronJob that has never succeeded, which is what the
  #     `created unless last_successful_time` form detects.
  #     kube_pod_status_reason{reason="Evicted"} for the 2026-09-18 incident.
  #   - postgres-exporter v0.15.0: pg_stat_archiver_last_archive_age
  #     (gauge, seconds) and pg_stat_archiver_failed_count (counter).
  #   These alerts add only severity/category/component labels. None of them
  #   defines a series labelled job, instance or namespace.
  #
  # WHAT THESE DO NOT SAY
  #   Freshness of an artefact is not proof that it restores. Only a passing
  #   restore drill is, which is why the drills have their own rules here.
  # =========================================================================
  pgbackrest-health-rules.yml: |
    groups:
      - name: pgbackrest-operational-health
        interval: 60s
        rules:
          # Every rule below depends on kube-state-metrics exporting CronJob
          # state. If it stops, they all go quiet at once; say so.
          - alert: BackupFreshnessSignalMissing
            expr: absent(kube_cronjob_created{namespace="data",cronjob="pgbackrest-check"})
            for: 15m
            labels:
              severity: critical
              category: platform
              component: backup
            annotations:
              summary: "Backup freshness alerts are blind (no CronJob metrics for data/pgbackrest-check)"
              description: |
                kube-state-metrics is not exporting kube_cronjob_created for
                data/pgbackrest-check. Every backup-freshness and restore-drill
                alert in this group depends on it and cannot fire. Check the
                kube-state-metrics Deployment in monitoring and its scrape job.

          # pgbackrest check runs every 15 min and forces a WAL switch, so it
          # proves archive_command + repo reachability end to end. 45 min =
          # three consecutive missed or failed runs.
          - alert: PgBackRestCheckNotSucceeding
            expr: |
              (time() - kube_cronjob_status_last_successful_time{namespace="data",cronjob="pgbackrest-check"}) > 2700
              or
              (
                kube_cronjob_created{namespace="data",cronjob="pgbackrest-check"}
                unless on (namespace, cronjob)
                kube_cronjob_status_last_successful_time{namespace="data",cronjob="pgbackrest-check"}
              )
            for: 5m
            labels:
              severity: critical
              category: platform
              component: pgbackrest
            annotations:
              summary: "pgBackRest check has not succeeded for over 45 minutes"
              description: |
                data/pgbackrest-check (every 15 min) has no successful run in
                45 minutes. The repo may be unreachable, credentials may have
                rotated, or the check may be targeting a dead pod (the
                2026-09-18 incident). WAL archiving can still be healthy; see
                PostgresWALArchiveStale.
                Runbook: docs/runbooks/POSTGRES_WAL_ARCHIVING.md#check-failures

          # Newest of full (Sunday) or diff (Mon-Sat): one should succeed
          # every day. 36h = a whole missed day plus 12h of slack.
          - alert: PgBackRestBackupStale
            expr: |
              (
                time() - max by (namespace) (
                  kube_cronjob_status_last_successful_time{namespace="data",cronjob=~"pgbackrest-backup-(full|diff)"}
                )
              ) > 129600
            for: 15m
            labels:
              severity: critical
              category: platform
              component: pgbackrest
            annotations:
              summary: "No successful pgBackRest full or diff backup for {{ $value | humanizeDuration }}"
              description: |
                Neither data/pgbackrest-backup-full nor data/pgbackrest-backup-diff
                has succeeded in over 36 hours. Point-in-time recovery still
                works from the last good backup plus archived WAL, but restore
                time grows with every day of WAL to replay.
                Runbook: docs/runbooks/POSTGRES_WAL_ARCHIVING.md#backup-cadence

          # Weekly full. 8 days = one missed Sunday plus a day of slack.
          # Diffs depend on the last full, so a stale full is its own alert.
          - alert: PgBackRestFullBackupStale
            expr: |
              (time() - kube_cronjob_status_last_successful_time{namespace="data",cronjob="pgbackrest-backup-full"}) > 691200
              or
              (
                kube_cronjob_created{namespace="data",cronjob="pgbackrest-backup-full"}
                unless on (namespace, cronjob)
                kube_cronjob_status_last_successful_time{namespace="data",cronjob="pgbackrest-backup-full"}
              )
            for: 30m
            labels:
              severity: critical
              category: platform
              component: pgbackrest
            annotations:
              summary: "No successful pgBackRest FULL backup in over 8 days"
              description: |
                data/pgbackrest-backup-full (weekly) has not succeeded in over
                8 days, or never has. Run one manually after checking why the
                last run failed.
                Runbook: docs/runbooks/POSTGRES_WAL_ARCHIVING.md#backup-cadence

          # A restore drill that has NEVER passed means recovery is unproven.
          # This fires until the first pass, by design.
          - alert: RestoreDrillNeverSucceeded
            expr: |
              kube_cronjob_created{namespace="data",cronjob=~"(pgbackrest|postgres)-restore-drill"}
              unless on (namespace, cronjob)
              kube_cronjob_status_last_successful_time{namespace="data",cronjob=~"(pgbackrest|postgres)-restore-drill"}
            for: 1h
            labels:
              severity: warning
              category: platform
              component: restore-drill
            annotations:
              summary: "Restore drill {{ $labels.cronjob }} has never succeeded"
              description: |
                {{ $labels.namespace }}/{{ $labels.cronjob }} has no successful
                run on record, so restoring from this backup path is unproven.
                Run it on demand and read its log; it states which check failed.
                Runbook: docs/runbooks/RESTORE_DRILL_LOG.md

          # Monthly drills. 35 days = one missed month plus slack.
          - alert: RestoreDrillOverdue
            expr: |
              (time() - kube_cronjob_status_last_successful_time{namespace="data",cronjob=~"(pgbackrest|postgres)-restore-drill"}) > 3024000
            for: 1h
            labels:
              severity: warning
              category: platform
              component: restore-drill
            annotations:
              summary: "Restore drill {{ $labels.cronjob }} last passed {{ $value | humanizeDuration }} ago"
              description: |
                {{ $labels.namespace }}/{{ $labels.cronjob }} has not passed in
                over 35 days (it runs monthly). Without a recent pass the backup
                cannot be treated as verified for recovery.
                Runbook: docs/runbooks/RESTORE_DRILL_LOG.md

          # Tenant-scoped logical DB backup (daily) owned by the tezca repo,
          # which ships no PrometheusRule of its own. karafiel's legalgen
          # object backup is already covered by karafiel's own PrometheusRule
          # (KarafielScheduledJobFailed + absence), so it is not repeated here.
          - alert: TenantDBBackupStale
            expr: |
              (time() - kube_cronjob_status_last_successful_time{namespace="tezca",cronjob="tezca-db-backup"}) > 129600
              or
              (
                kube_cronjob_created{namespace="tezca",cronjob="tezca-db-backup"}
                unless on (namespace, cronjob)
                kube_cronjob_status_last_successful_time{namespace="tezca",cronjob="tezca-db-backup"}
              )
            for: 1h
            labels:
              severity: warning
              category: platform
              component: backup
            annotations:
              summary: "Tenant backup {{ $labels.namespace }}/{{ $labels.cronjob }} is stale or has never succeeded"
              description: |
                The daily tenant backup has not succeeded in 36 hours, or has
                never succeeded. The shared instance's pgBackRest backups still
                cover this data; this alert is about the tenant's own
                fast-restore artefact.

          # 2026-09-18: the kubelet evicted data/postgres when the
          # pgbackrest-logs emptyDir hit its sizeLimit. The Evicted object then
          # misdirected every backup job for six days.
          - alert: PostgresPodEvicted
            expr: kube_pod_status_reason{namespace="data",pod=~"postgres-.*",reason="Evicted"} == 1
            for: 5m
            labels:
              severity: warning
              category: platform
              component: postgres
            annotations:
              summary: "Shared Postgres pod {{ $labels.pod }} was evicted"
              description: |
                A data/postgres pod object is in phase Failed with reason
                Evicted. Find the cause (usually an emptyDir over its
                sizeLimit), then delete the Evicted object; the ReplicaSet does
                not remove it.
                Runbook: docs/runbooks/POSTGRES_WAL_ARCHIVING.md

  # =========================================================================
  # WAL archiving (rewritten 2026-09-24; see the header above
  # pgbackrest-health-rules.yml for why the old metric name never matched).
  #
  # archive_timeout=60 and a pgbackrest check every 15 min (which forces a
  # WAL switch) keep a healthy archive's age at minutes. The thresholds allow
  # for that without paging on an ordinary quiet stretch.
  #
  # 2026-09-19 lesson kept: annotations are Go templates. Keep `{{` out of
  # them unless it is a real expression, and run `promtool check rules`.
  # =========================================================================
  postgres-wal-archive-rules.yml: |
    groups:
      - name: postgres-wal-archive
        interval: 30s
        rules:
          - alert: PostgresWALArchiveFailing
            expr: |
              increase(pg_stat_archiver_failed_count[10m]) > 0
              and
              pg_stat_archiver_last_archive_age > 600
            for: 5m
            labels:
              severity: critical
              category: platform
              component: postgres-wal-archive
            annotations:
              summary: "Postgres archive_command is failing"
              description: |
                pg_stat_archiver.failed_count is increasing and no WAL segment
                has been archived for over 10 minutes. The recovery point is
                falling behind. Check the postgres container log for
                archive-push errors.
                Runbook: docs/runbooks/POSTGRES_WAL_ARCHIVING.md#failure-modes

          - alert: PostgresWALArchiveLag
            expr: pg_stat_archiver_last_archive_age > 900
            for: 10m
            labels:
              severity: warning
              category: platform
              component: postgres-wal-archive
            annotations:
              summary: "Last WAL archive was {{ $value | humanizeDuration }} ago"
              description: |
                No WAL segment has been archived for over 15 minutes although
                archive_timeout is 60s. If failed_count is also rising,
                PostgresWALArchiveFailing pages.
                Runbook: docs/runbooks/POSTGRES_WAL_ARCHIVING.md#wal-lag

          - alert: PostgresWALArchiveStale
            expr: pg_stat_archiver_last_archive_age > 3600
            for: 5m
            labels:
              severity: critical
              category: platform
              component: postgres-wal-archive
            annotations:
              summary: "No WAL archived for {{ $value | humanizeDuration }}"
              description: |
                The newest archived WAL segment is over an hour old, so a
                restore now would lose over an hour of writes.
                Runbook: docs/runbooks/POSTGRES_WAL_ARCHIVING.md#wal-lag

          - alert: PostgresWALArchiveSignalMissing
            expr: absent(pg_stat_archiver_last_archive_age)
            for: 30m
            labels:
              severity: warning
              category: platform
              component: postgres-wal-archive
            annotations:
              summary: "WAL archive alerts are blind (pg_stat_archiver_last_archive_age absent)"
              description: |
                postgres-exporter is not exporting pg_stat_archiver, so the
                WAL archive alerts above cannot fire. Check the
                postgres-exporter Deployment in data and the `postgres` scrape job.

          - alert: PostgresWALSpoolDiskHigh
            expr: |
              kubelet_volume_stats_used_bytes{namespace="data",persistentvolumeclaim="pgbackrest-spool-pvc"}
              /
              kubelet_volume_stats_capacity_bytes{namespace="data",persistentvolumeclaim="pgbackrest-spool-pvc"}
              > 0.80
            for: 5m
            labels:
              severity: warning
              category: platform
              component: postgres-wal-archive
            annotations:
              summary: "pgBackRest spool PVC over 80%"
              description: |
                Spool usage is {{ $value | humanizePercentage }} of 20Gi. If R2
                is unreachable, this PVC will fill and archive_command will
                start failing. Investigate R2 reachability first, then consider
                an emergency resize.
                Runbook: docs/runbooks/POSTGRES_WAL_ARCHIVING.md#spool-pressure

  # =========================================================================
  # Resurrected 2026-08-26 (availability remediation Tier 0.3). Two sources:
  #
  #   CloudflaredTunnelDown ported from the dead
  #   prometheus-platform-rules.yaml (PrometheusRule platform-infrastructure-
  #   rules). This is the "Cloudflare tunnel monitoring" the audit flagged —
  #   the live cloudflared-probe-misconfigured group above only detects
  #   misconfigured probe TARGETS, not the tunnel itself being unreachable.
  #
  #   CloudflaredProbeBackendUnreachable / CloudflaredProbeNotRunning ported
  #   from the dead infra/k8s/production/cloudflared-probe.yaml
  #   PrometheusRule (cloudflared-probe-rules) — that file's own header
  #   comment already documented it as unloaded (verified 2026-08-06) and
  #   pointed here as the fix. Distinct alert names from the misconfigured-
  #   target group above: these fire on the probe finding the backend
  #   actually unreachable, not on the probe's target list being wrong.
  # =========================================================================
  cloudflared-tunnel-rules.yml: |
    groups:
      - name: cloudflared
        interval: 30s
        rules:
          # cloudflared is scraped by the kubernetes-pods job (pod
          # annotations), so its series carry job="kubernetes-pods" and there
          # is no job="cloudflared" at all: the old selector made absent()
          # fire permanently. Select the connectors by namespace and pod label
          # instead (app="cloudflared" excludes cloudflared-probe). Pages only
          # when the tunnel as a whole is gone: no connector scraped, every
          # connector down, or no connector holding an edge connection.
          - alert: CloudflaredTunnelDown
            expr: |
              absent(up{namespace="cloudflare-tunnel", app="cloudflared"})
              or max(up{namespace="cloudflare-tunnel", app="cloudflared"}) == 0
              or sum(cloudflared_tunnel_ha_connections{namespace="cloudflare-tunnel", app="cloudflared"}) == 0
            for: 2m
            labels:
              severity: critical
              category: platform
            annotations:
              summary: "Cloudflare tunnel is down"
              description: "All cloudflared instances are unreachable or hold no edge connection for more than 2 minutes. External traffic cannot reach the cluster."

          # One connector down while the others carry the traffic. The old
          # rule paged critical for this case too; it is a warning now.
          - alert: CloudflaredConnectorDown
            expr: |
              up{namespace="cloudflare-tunnel", app="cloudflared"} == 0
              or cloudflared_tunnel_ha_connections{namespace="cloudflare-tunnel", app="cloudflared"} == 0
            for: 5m
            labels:
              severity: warning
              category: platform
            annotations:
              summary: "cloudflared connector {{ $labels.pod }} is down or has no edge connection"
              description: "One cloudflared connector has not been serving for more than 5 minutes. The tunnel still runs on the others; check the pod's logs and restarts."

      - name: cloudflared-probe
        interval: 30s
        rules:
          - alert: CloudflaredProbeBackendUnreachable
            expr: |
              cloudflared_probe_reachable_total == 0
            for: 2m
            labels:
              severity: critical
              category: platform
            annotations:
              summary: "cloudflared cannot reach {{ $labels.namespace }}/{{ $labels.service }}:{{ $labels.port }}"
              description: |
                In-cluster synthetic probe in the cloudflare-tunnel namespace
                failed to reach {{ $labels.namespace }}/{{ $labels.service }}:{{ $labels.port }}
                for >2m. Because the probe pod mirrors cloudflared's labels,
                cloudflared itself cannot reach this Service either. Likely
                cause: NetworkPolicy denies cloudflare-tunnel egress to that
                namespace, the Service has no endpoints, or the underlying
                pod is failing health checks.
                Runbook: docs/runbooks/cloudflared-probe.md

          - alert: CloudflaredProbeNotRunning
            expr: |
              absent(cloudflared_probe_runs_total) or rate(cloudflared_probe_runs_total[5m]) == 0
            for: 5m
            labels:
              severity: warning
              category: platform
            annotations:
              summary: "cloudflared-probe is not emitting metrics"
              description: |
                No probe iterations recorded in the last 5 minutes. The probe
                itself may be crashlooping or unscheduled. Without it we lose
                visibility into in-cluster cloudflared reachability.

  # =========================================================================
  # Resurrected 2026-08-26 (availability remediation Tier 0.3) from the dead
  # infra/k8s/production/synthetic-flow-probe.yaml PrometheusRule
  # (synthetic-flow-probe-rules). Not referenced by any kustomization and
  # never reconciled by an operator — same dead-on-arrival story.
  # =========================================================================
  synthetic-flow-probe-rules.yml: |
    groups:
      - name: synthetic-flow-probe
        interval: 30s
        rules:
          - alert: SyntheticJourneyConsecutivelyFailing
            expr: |
              synthetic_journey_consecutive_failures >= 3
            for: 1m
            labels:
              severity: critical
              category: synthetic-flow
            annotations:
              summary: "Synthetic journey {{ $labels.platform }}/{{ $labels.journey }} is broken"
              description: |
                The synthetic-flow-probe has reported {{ $value }} consecutive failures
                for the journey {{ $labels.platform }}/{{ $labels.journey }}.
                At the default 5-min schedule that's ~15+ minutes of broken user flow.

                Inspect the failing step:
                  kubectl -n cloudflare-tunnel logs deploy/synthetic-flow-probe --tail=100 | \
                    jq -c 'select(.event=="journey_failed" and .platform=="{{ $labels.platform }}")'

                Cross-correlate with cloudflared-probe: if `cloudflared_probe_reachable_total` for
                the same backend is 1 (Service reachable) but this journey is failing, the issue is
                application-layer (CSP, CORS, SSO callback, session, redirect). If the cloudflared
                probe is also 0 the issue is in-cluster network reachability — fix that first.

                Runbook: docs/runbooks/synthetic-flow-probe.md

          - alert: SyntheticJourneyStepLatencyRegression
            expr: |
              histogram_quantile(0.95,
                sum by (platform, journey, step, le) (
                  rate(synthetic_journey_step_latency_seconds_bucket[5m])
                )
              )
              >
              2 * histogram_quantile(0.95,
                sum by (platform, journey, step, le) (
                  rate(synthetic_journey_step_latency_seconds_bucket[1h] offset 5m)
                )
              )
            for: 10m
            labels:
              severity: warning
              category: synthetic-flow
            annotations:
              summary: "Synthetic journey step {{ $labels.platform }}/{{ $labels.journey }}/{{ $labels.step }} is >2x slower than baseline"
              description: |
                p95 latency for step `{{ $labels.step }}` in journey
                {{ $labels.platform }}/{{ $labels.journey }} has been more than 2x its prior 1h
                baseline for 10+ minutes. Likely cause: backend slowness, network congestion,
                or a recently-deployed change that added latency.

          - alert: SyntheticFlowProbeNotRunning
            expr: |
              absent(synthetic_journey_last_run_timestamp)
              or
              (time() - max by (platform, journey) (synthetic_journey_last_run_timestamp)) > 600
            for: 5m
            labels:
              severity: warning
              category: synthetic-flow
            annotations:
              summary: "synthetic-flow-probe is not emitting metrics"
              description: |
                No journey runs recorded in the last 10 minutes for at least one journey.
                The probe pod may be crashlooping, the ConfigMap may be malformed, or scrapes
                may be broken. Check:
                  kubectl -n cloudflare-tunnel get pod -l app=synthetic-flow-probe
                  kubectl -n cloudflare-tunnel logs deploy/synthetic-flow-probe --tail=50

  # =========================================================================
  # Revenue probes (money-machine audit 2026-10-11, M2 F1/F2/F5). Reads the
  # `blackbox-revenue` scrape job above (targets) and blackbox-exporter.yaml
  # (modules). All three page: a revenue flow failing, Dhanam pricing off its
  # hardcoded FX table, and the prober itself gone, which would otherwise
  # look exactly like "everything is fine".
  #
  # Expected on arrival, from the 2026-10-11 state (both are real, live
  # faults this group exists to catch, not noise):
  #   RevenueEndpointDown  cotiza web-api-proxy and quote-via-web, until the
  #                        Cotiza web build fix (F1) ships;
  #   DhanamFXEmergencyFallback  until Dhanam's FX source is restored (F2).
  #
  # Paging shape. Every rule here carries `category: revenue-probe`, and
  # alertmanager.yaml routes that label, above the generic critical route,
  # grouped by [alertname, product]: a second product failing opens its own
  # group and notifies after group_wait (10s) instead of joining a group that
  # is already firing for another product. The routing relies on BOTH labels:
  # `category` on each rule below, `product` on each scrape target above
  # (RevenueProbesNotRunning has no product and is one group of its own).
  # Several endpoints of ONE product failing together are still one group.
  # Courier (outside this repo) keys each page
  # `alarm:<alertname>[:<identity>]:<hour>[:<phase>]` (angelia#40, #41;
  # apps/api/src/courier/alertmanager.ts). For these rules the identity is
  # the `product` label and <hour> is the UTC hour the episode began, so each
  # failing product pages once when it starts, gets a reminder every 24h
  # while it keeps failing, and one resolved notice. A second product failing
  # is its own page. Email carries every group.
  #
  # Annotations use $labels and $value only: no `query` template functions.
  # =========================================================================
  revenue-probe-rules.yml: |
    groups:
      - name: revenue-probes
        interval: 30s
        rules:
          # Any revenue probe failing for 3 minutes (three 60s probes in a
          # row): a 5xx, a timeout, a TLS failure, a redirect, a wrong status
          # (e.g. 200 where 401 is expected) or a body that fails its check.
          # The FX source probe's REGEX failure is excluded here because it
          # has its own alert below; that probe's HTTP failure still counts.
          # Steps of a money path (`money_path` set) page as MoneyPathDown in
          # the `money-paths` group instead, once per broken path, and
          # `paging: warning` targets go to RevenueEndpointDegraded.
          - alert: RevenueEndpointDown
            expr: |
              probe_success{job="blackbox-revenue", paging!="warning", money_path=""} == 0
              unless on (instance)
              (probe_failed_due_to_regex{job="blackbox-revenue", check="fx-source"} == 1)
            for: 3m
            labels:
              severity: critical
              category: revenue-probe
            annotations:
              summary: "{{ $labels.product }} {{ $labels.flow }} is failing: {{ $labels.instance }}"
              description: |
                The synthetic probe of {{ $labels.instance }} (product
                {{ $labels.product }}, flow {{ $labels.flow }}, blackbox module
                {{ $labels.module }}) has failed for 3 minutes. It probes the
                public URL, through Cloudflare and the tunnel, as a customer
                would. Argo and the replica alerts can read healthy while this
                fires: that is the failure it exists to catch.

                Triage:
                  1. Reproduce: curl -sS -o /dev/null -w '%{http_code}\n' '{{ $labels.instance }}'
                     (the module's pass condition is in
                     infra/k8s/production/monitoring/blackbox-exporter.yaml).
                  2. Pods and logs: enclii ops pods diagnose -n {{ $labels.target_namespace }}
                  3. If many products fail at once, check CloudflaredTunnelDown
                     first: the probes share the public edge path.
                In Grafana: probe_http_status_code{instance="{{ $labels.instance }}"}.

          # A `paging: warning` target failing for 10 minutes. These are the
          # pages and checks of SKUs that cannot be bought self-serve today
          # (their buy links end at the Kalya booking page), plus Dhanam FX
          # degraded and Karafiel's broker. Warning, so it reaches the
          # digest and not Telegram: the journeys plan's decision 6
          # recommendation (UNRULED at the time of writing) pages only for
          # money paths that work today.
          - alert: RevenueEndpointDegraded
            expr: |
              probe_success{job="blackbox-revenue", paging="warning"} == 0
            for: 10m
            labels:
              severity: warning
              category: revenue-probe
            annotations:
              summary: "{{ $labels.product }} {{ $labels.flow }} is failing (warning only): {{ $labels.instance }}"
              description: |
                The synthetic probe of {{ $labels.instance }} (product
                {{ $labels.product }}, flow {{ $labels.flow }}, blackbox module
                {{ $labels.module }}) has failed for 10 minutes.

                WHY THIS IS A WARNING AND NOT A PAGE: this target is not a step
                of a money path that takes money today. Its SKU's buy link ends
                at the Kalya booking page, so a broken page here loses a lead,
                not a sale (decision 6 of the money-engine journeys plan, as
                recommended; promote the target to a money path when its
                checkout works).

                Triage:
                  1. curl -sS -o /dev/null -w '%{http_code}\n' '{{ $labels.instance }}'
                     (the module's pass condition is in blackbox-exporter.yaml).
                  2. enclii ops pods diagnose -n {{ $labels.target_namespace }}

          # Dhanam is pricing off its hardcoded emergency FX table. The
          # endpoint is up (HTTP 2xx), so nothing else pages, but every
          # USD/MXN conversion uses a fixed estimate. 15 minutes so a single
          # provider blip between the 15-minute spot refreshes does not page.
          - alert: DhanamFXEmergencyFallback
            expr: |
              probe_failed_due_to_regex{job="blackbox-revenue", check="fx-source"} == 1
            for: 15m
            labels:
              severity: critical
              category: revenue-probe
              service: dhanam
            annotations:
              summary: "Dhanam FX is serving the hardcoded emergency rate table"
              description: |
                {{ $labels.instance }} reports `"source":"emergency_fallback"`
                for 15 minutes: no provider rate and no recent stored rate is
                reaching the rate path, so USD/MXN comes from a fixed estimate
                that Dhanam's own fx-rates README calls never authoritative.

                Triage:
                  1. curl -sS '{{ $labels.instance }}' (read testRate.source and asOf).
                  2. enclii ops pods logs <dhanam-api pod> -n dhanam (the provider error).
                  3. enclii ops jobs list -n dhanam --json: is dhanam-fx-spot-refresh
                     succeeding? Its rate must reach the stored-rate fallback.

          # The prober is gone: blackbox-exporter down, unscheduled, refused by
          # the network policy, or the scrape job missing. Every probe series
          # disappears and RevenueEndpointDown can no longer fire, so this is
          # critical: the revenue flows are unwatched while it lasts.
          - alert: RevenueProbesNotRunning
            expr: |
              absent(up{job="blackbox-revenue"} == 1)
            for: 10m
            labels:
              severity: critical
              category: revenue-probe
            annotations:
              summary: "Revenue probes are not running: the revenue flows are unwatched"
              description: |
                No target of the blackbox-revenue scrape job has been scraped
                successfully for 10 minutes, so RevenueEndpointDown and
                DhanamFXEmergencyFallback cannot fire.

                Triage:
                  1. enclii ops pods diagnose -n monitoring (blackbox-exporter pod).
                  2. Grafana: up{job="blackbox-revenue"}. Absent means the scrape
                     job is not loaded (prometheus-config ConfigMap, reload);
                     0 means Prometheus cannot reach blackbox-exporter:9115
                     (blackbox-exporter-ingress NetworkPolicy, Service).

      # One page per broken MONEY PATH (money-engine wave 2, 2026-10-18).
      # A money path is the chain of public steps a payment goes through
      # today; its steps are the blackbox-revenue targets whose `money_path`
      # label names it (prometheus-config, scrape job blackbox-revenue).
      # Any step failing for 3 minutes breaks the path. The page carries
      # `money_path` and, as `product`, the same name: Alertmanager's revenue
      # route groups by [alertname, product] and Courier keys its
      # once-per-episode page on `product`, so two broken paths are two
      # pages and one broken path is one page however many steps fail.
      # Which steps: the MoneyPathStepFailing warnings, or
      # `python3 scripts/money-engine-status.py`.
      - name: money-paths
        interval: 30s
        rules:
          - alert: MoneyPathDown
            expr: |
              label_replace(label_replace(
                count(probe_success{job="blackbox-revenue", money_path=~".*,retainer,.*"} == 0),
                "money_path", "retainer", "", ""), "product", "retainer", "", "")
              or
              label_replace(label_replace(
                count(probe_success{job="blackbox-revenue", money_path=~".*,dhanam-self-serve,.*"} == 0),
                "money_path", "dhanam-self-serve", "", ""), "product", "dhanam-self-serve", "", "")
              or
              label_replace(label_replace(
                count(probe_success{job="blackbox-revenue", money_path=~".*,sales-booking,.*"} == 0),
                "money_path", "sales-booking", "", ""), "product", "sales-booking", "", "")
            for: 3m
            labels:
              severity: critical
              category: revenue-probe
            annotations:
              summary: "Money path {{ $labels.money_path }} is broken: {{ $value }} step(s) failing"
              description: |
                {{ $value }} step(s) of the {{ $labels.money_path }} money path
                have failed their synthetic probe for 3 minutes. A customer or
                the retainer cycle cannot complete this path right now.

                  retainer           Nauta cockpit, Karafiel API (CFDI), Janua
                  dhanam-self-serve  dhan.am/pricing, app.dhan.am/register,
                                     Janua sign-in (discovery, keys, CORS),
                                     the Dhanam catalog and API
                  sales-booking      madfam.io, kalya.app and its booking page

                Triage:
                  1. Which step: python3 scripts/money-engine-status.py (from an
                     enclii checkout; public GETs, the same pass conditions), or
                     the MoneyPathStepFailing warnings in Alertmanager.
                  2. If several paths break at once, check CloudflaredTunnelDown
                     and Janua first: they are shared by every path.
                In Grafana: the "Money engine" dashboard.

          # Each failing step of a money path, for the digest and the status
          # read: it names the step that MoneyPathDown counts. Warning, so the
          # path pages once (MoneyPathDown) and the steps do not page again.
          - alert: MoneyPathStepFailing
            expr: |
              probe_success{job="blackbox-revenue", money_path!=""} == 0
            for: 3m
            labels:
              severity: warning
              category: revenue-probe
            annotations:
              summary: "Money path step failing ({{ $labels.money_path }}): {{ $labels.product }} {{ $labels.flow }} {{ $labels.instance }}"
              description: |
                {{ $labels.instance }} (product {{ $labels.product }}, flow
                {{ $labels.flow }}, module {{ $labels.module }}) is a step of the
                money paths {{ $labels.money_path }} and has failed its probe for
                3 minutes. MoneyPathDown pages for the path; this names the step.

                Triage:
                  1. curl -sS -o /dev/null -w '%{http_code}\n' '{{ $labels.instance }}'
                  2. enclii ops pods diagnose -n {{ $labels.target_namespace }}

  # =========================================================================
  # Geometry-factory probes (geometry stability pass 2026-10-18, lane O1).
  # Reads the `blackbox-geometry` scrape job above (targets) and
  # blackbox-exporter.yaml (modules). The geometry offering is up only if
  # someone is told when it is down, so all three page.
  #
  # Paging shape. No `category: revenue-probe`: these take the generic
  # critical route in alertmanager.yaml (critical-receiver, Courier + email,
  # grouped by alertname, email re-sent every 4h). Each target carries a
  # `product` label and no rule here sets one, so Courier keys each page
  # `alarm:<alertname>:<product>:<hour>`: one page per failing product per
  # episode, a reminder every 24h, one resolved notice. A second product
  # failing while the first is paging joins the alertname's email group at
  # its next 15m tick and still pages on its own in chat. The `product`
  # label also keeps these out of the staging routes.
  #
  # Annotations use $labels and $value only: no `query` template functions.
  # =========================================================================
  geometry-probe-rules.yml: |
    groups:
      - name: geometry-probes
        interval: 30s
        rules:
          # Any geometry host failing for 3 minutes (three 60s probes in a
          # row): a 5xx, a timeout, a TLS failure (an expired certificate
          # fails the handshake and lands here), a redirect, a wrong status
          # or a body that fails its module's check.
          - alert: GeometryHostDown
            expr: |
              probe_success{job="blackbox-geometry"} == 0
            for: 3m
            labels:
              severity: critical
              category: geometry-probe
            annotations:
              summary: "{{ $labels.product }} {{ $labels.flow }} is down: {{ $labels.instance }}"
              description: |
                The synthetic probe of {{ $labels.instance }} (product
                {{ $labels.product }}, flow {{ $labels.flow }}, blackbox module
                {{ $labels.module }}) has failed for 3 minutes. It probes the
                public URL, through Cloudflare and the tunnel, as a visitor
                would; Argo and the replica alerts can read healthy while this
                fires.

                Triage:
                  1. Reproduce: curl -sS -o /dev/null -w '%{http_code}\n' '{{ $labels.instance }}'
                     (the module's pass condition is in
                     infra/k8s/production/monitoring/blackbox-exporter.yaml).
                  2. Pods and logs: enclii ops pods diagnose -n {{ $labels.target_namespace }}
                  3. If many products fail at once, check CloudflaredTunnelDown
                     and RevenueEndpointDown first: the probes share the public
                     edge path.
                In Grafana: probe_http_status_code{instance="{{ $labels.instance }}"}.

          # The certificate a geometry host serves expires within 14 days.
          # Cloudflare renews its edge certificates weeks ahead of expiry (on
          # 2026-10-18 the shortest of these 13 had 32 days left), so under
          # 14 days means renewal has failed, and the host goes down on a
          # known date. One hour so a certificate swap mid-probe does not
          # page. probe_ssl_earliest_cert_expiry is the earliest expiry in
          # the verified chain, as a Unix time.
          - alert: GeometryTLSCertExpiring
            expr: |
              probe_ssl_earliest_cert_expiry{job="blackbox-geometry"} - time() < 14 * 86400
            for: 1h
            labels:
              severity: critical
              category: geometry-probe
            annotations:
              summary: "{{ $labels.product }} {{ $labels.flow }}: TLS certificate expires within 14 days ({{ $labels.instance }})"
              description: |
                The certificate served for {{ $labels.instance }} expires in
                {{ $value }} seconds. Cloudflare renews edge certificates weeks
                ahead of expiry, so renewal has likely failed for this hostname.

                Triage:
                  1. echo | openssl s_client -connect <host>:443 -servername <host> 2>/dev/null | openssl x509 -noout -enddate -issuer
                  2. Cloudflare dashboard → SSL/TLS → Edge Certificates for the
                     zone: the certificate's status and validation records.

          # The geometry probes are not running: the scrape job is not loaded
          # (a merged prometheus-config that never reloaded), or Prometheus
          # cannot reach blackbox-exporter. Every probe series disappears and
          # GeometryHostDown can no longer fire, so this pages.
          - alert: GeometryProbesNotRunning
            expr: |
              absent(up{job="blackbox-geometry"} == 1)
            for: 10m
            labels:
              severity: critical
              category: geometry-probe
            annotations:
              summary: "Geometry probes are not running: the geometry hosts are unwatched"
              description: |
                No target of the blackbox-geometry scrape job has been scraped
                successfully for 10 minutes, so GeometryHostDown and
                GeometryTLSCertExpiring cannot fire.

                Triage:
                  1. If RevenueProbesNotRunning fires too, the exporter is down:
                     enclii ops pods diagnose -n monitoring (blackbox-exporter pod).
                  2. Otherwise the job is not loaded: Grafana up{job="blackbox-geometry"}
                     is absent. Check the prometheus-config ConfigMap and that
                     Prometheus reloaded it (/api/v1/status/runtimeinfo
                     lastConfigTime, reloadConfigSuccess).

  # =========================================================================
  # Resurrected 2026-08-26 (availability remediation Tier 0.3): the 5 of 8
  # "decoration" rules from deploy-pipeline-monitor.yaml's PrometheusRule
  # (deploy-pipeline-monitor-rules, group `deploy-pipeline-monitor`) whose
  # metrics are genuinely emitted by check_main_ci.py (confirmed against
  # infra/deploy-pipeline-monitor/check_main_ci.py and its tests) and have
  # no live equivalent.
  #
  # The other 3 rules in that PrometheusRule (group `argo-main-parity-
  # monitor`: ArgoMainParityDrift, ArgoMainParityMonitorFailed,
  # ArgoMainParityMonitorStale) are DELETED, not ported: their metrics
  # (argo_main_parity_drift_sources etc., from check_argo_main_parity.py)
  # are real, but deploy-parity-alerts.yml above already covers this exact
  # monitor with a redesigned, more accurate signal
  # (argo_main_rollout_ok/argo_main_rollout_failed_sources) — see that
  # key's own header comment for why the drift-sources approach missed the
  # 2026-08-07 avala-services incident. Porting the superseded metric
  # verbatim would double-alert on every real rollout failure.
  #
  # MainCIFailingForTooLong IS A WARNING since 2026-10-17 (infra-stability
  # audit, pager noise plan). It sent 209 of the 772 Telegram pages in the 14
  # days to 10-17, the largest single source. A red main CI means merged code
  # is not built; the previous image keeps serving, so it is a digest item,
  # not a 03:00 page. A client-facing outage pages through the client-slo,
  # Argo health and revenue rules, which stay critical.
  # =========================================================================
  deploy-pipeline-freshness-rules.yml: |
    groups:
      - name: deploy-pipeline-monitor
        interval: 1m
        rules:
          - alert: MainCIFailingForTooLong
            expr: repo_main_blocked_seconds > 1800
            for: 0m
            # The metric drops to 0 while a new main run is in flight and
            # jumps back when it fails again. On 2026-09-24 that made 12
            # series fire 173 separate times in 18.6h (enclii's alone dropped
            # below threshold 43 times), and each re-fire re-paged: about 234
            # emails a day from this rule by itself. Holding the alert 1h past
            # a drop absorbs an in-flight run without hiding a real fix: a
            # repo that stays green resolves 1h later.
            keep_firing_for: 1h
            labels:
              severity: warning
              category: deploy-pipeline
            annotations:
              summary: "{{ $labels.repo }} main CI has been failing for >30 min"
              description: |
                Latest push CI run on `{{ $labels.branch }}` of `{{ $labels.repo }}`
                is failed (scheduled canaries are MainCanaryFailing). The failing commit was pushed {{ $value | humanizeDuration }}
                ago — no image has been rebuilt → no deploys are reaching ArgoCD
                → live pods are drifting from `main`.
                Open the Actions tab on the repo, identify the failing run,
                fix or rerun it.
                Runbook: docs/runbooks/deploy-pipeline-monitor.md

          - alert: MainCommitsAccumulatingNotDeployed
            expr: |
              (repo_main_latest_commit_age_seconds
               - repo_main_latest_ci_age_seconds) > 1800
            for: 5m
            labels:
              severity: warning
              category: deploy-pipeline
            annotations:
              summary: "{{ $labels.repo }} main has unbuilt commits (>30 min)"
              description: |
                `{{ $labels.repo }}` main HEAD is {{ $value | humanizeDuration }}
                newer than the most recent completed CI run. Either CI is
                stalled, the workflow filter isn't matching, or the runner
                fleet is starved. ArgoCD will reconcile the *previous* image
                until this clears.

          - alert: MainCIConsecutiveFailures
            expr: repo_main_ci_failure_streak_count >= 3
            for: 15m
            labels:
              severity: warning
              category: deploy-pipeline
            annotations:
              summary: "{{ $labels.repo }} main CI: 3+ consecutive failures"
              description: |
                `{{ $labels.repo }}` has {{ $value }} consecutive non-success
                CI runs on `{{ $labels.branch }}`. Likely a real defect rather
                than a flake.

          - alert: DeployPipelineMonitorNotRunning
            expr: |
              time() - deploy_pipeline_monitor_last_run_timestamp_seconds > 900
              or absent(deploy_pipeline_monitor_last_run_timestamp_seconds)
            for: 5m
            labels:
              severity: warning
              category: deploy-pipeline
            annotations:
              summary: "deploy-pipeline-monitor has not pushed metrics in >15 min"
              description: |
                The CronJob is supposed to push every 5 min. Either it is not
                scheduling (check `kubectl -n monitoring get cronjob`), the
                GitHub token expired, or pushgateway is unreachable.

          - alert: DeployPipelineMonitorRepoProbeFailing
            expr: repo_main_probe_ok == 0
            for: 30m
            labels:
              severity: warning
              category: deploy-pipeline
            annotations:
              summary: "deploy-pipeline-monitor cannot probe {{ $labels.repo }}"
              description: |
                The monitor has been unable to fetch state from
                `{{ $labels.repo }}` for 30+ minutes. Likely causes: PAT scope
                missing the repo, repo renamed, or branch deleted. The monitor
                keeps running for the other repos.

          # Scheduled production canaries, kept apart from the build signal
          # above (infra-stability audit 2026-10-17, W1O-1). check_main_ci.py
          # reads push runs for MainCIFailingForTooLong and schedule runs, per
          # workflow, for this. A canary failing twice running is a production
          # signal worth reading in the digest; it is not merged-but-unbuilt
          # code, which is what the build alert names.
          - alert: MainCanaryFailing
            expr: repo_main_scheduled_failure_streak_count >= 2
            for: 30m
            labels:
              severity: warning
              category: deploy-pipeline
            annotations:
              summary: "{{ $labels.repo }} scheduled workflow \"{{ $labels.workflow }}\" failed {{ $value }} times running"
              description: |
                The scheduled workflow `{{ $labels.workflow }}` on
                `{{ $labels.branch }}` of `{{ $labels.repo }}` has failed
                {{ $value }} consecutive runs (cancelled and skipped runs are
                passed over). Push CI is read separately, so this is a
                production check failing, not a build that did not happen.
                Open the workflow's latest run in the Actions tab.
                Runbook: docs/runbooks/deploy-pipeline-monitor.md

          - alert: DeployPipelineMonitorScheduledProbeFailing
            expr: repo_main_scheduled_probe_ok == 0
            for: 30m
            labels:
              severity: warning
              category: deploy-pipeline
            annotations:
              summary: "deploy-pipeline-monitor cannot read scheduled runs of {{ $labels.repo }}"
              description: |
                The schedule-event runs query for `{{ $labels.repo }}` has
                failed for 30+ minutes, so MainCanaryFailing cannot fire for
                it. The push signal is unaffected.

  # =========================================================================
  # ARC pool health (added 2026-09-04)
  # -------------------------------------------------------------------------
  # These evaluate the gauges that infra/k8s/production/arc/pool-health-alert.yaml
  # pushes to the pushgateway every 5 minutes. They are NOT a replacement for
  # that detector's direct POST to Alertmanager — they are the half of the
  # problem the POST cannot solve, plus one deliberate redundancy:
  #
  #   ARCPoolHealthDetectorStale / Missing — the detector's own death. A
  #     CronJob that stops scheduling is silent in exactly the way a healthy
  #     fleet is silent. That is the shape of the 82-day-dead
  #     ARCNoRunnersAvailable rule and of the OOMKilled stuck-runner watchdog,
  #     and it is why the detector now emits a heartbeat at all.
  #
  #   ARCRunnersOutdatedGauge — the same fact ARCRunnersDeprecated pages on,
  #     reached by a different path (API read -> pushgateway -> scrape ->
  #     rule) instead of (API read -> POST -> Alertmanager). Deliberate
  #     double-paging on one condition, because on 2026-08-10 the alert that
  #     should have caught this was dead four independent ways at once and
  #     each one of them was individually sufficient. Two paths that fail
  #     differently beat one path that looks healthy.
  #
  # Pushgateway values are sticky: if the CronJob dies mid-outage, the last
  # gauge persists and ARCRunnersOutdatedGauge keeps firing. That is the
  # correct direction to be wrong in, and DetectorStale fires alongside it to
  # say the numbers are frozen.
  # =========================================================================
  arc-pool-health-rules.yml: |
    groups:
      - name: arc-pool-health
        interval: 1m
        rules:
          - alert: ARCPoolHealthDetectorStale
            expr: time() - arc_pool_health_last_run_timestamp_seconds > 1200
            for: 5m
            labels:
              severity: critical
              service: arc
              category: ci-capacity
            annotations:
              summary: "ARC pool-health detector has not run in >20 min"
              description: |
                The `arc-pool-health` CronJob in `monitoring` pushes a
                heartbeat every 5 minutes. It has not. Until it runs again the
                runner pool has NO detector: a total CI outage would look
                exactly like this does. Check the CronJob's last jobs and the
                CronJobFailed alert for the same namespace.
              runbook_url: "https://github.com/madfam-org/internal-devops/blob/main/runbooks/arc-runner-image-rebuild.md"

          - alert: ARCPoolHealthDetectorMissing
            expr: absent(arc_pool_health_last_run_timestamp_seconds)
            for: 30m
            labels:
              severity: warning
              service: arc
              category: ci-capacity
            annotations:
              summary: "ARC pool-health detector has never pushed a heartbeat"
              description: |
                No `arc_pool_health_last_run_timestamp_seconds` series exists
                at all. Either the CronJob has never run since this rule
                landed, its egress to the pushgateway is blocked, or the
                pushgateway lost its state. This is the "applied and healthy
                but never actually running" failure the detector itself was
                written to end.
              runbook_url: "https://github.com/madfam-org/internal-devops/blob/main/runbooks/arc-runner-image-rebuild.md"

          - alert: ARCRunnersOutdatedGauge
            expr: arc_pool_outdated_runners > 0
            for: 5m
            labels:
              severity: critical
              service: arc
              category: ci-capacity
            annotations:
              summary: "ARC runners are being rejected at registration (metrics path)"
              description: |
                {{ $value }} EphemeralRunner(s) are in phase=Outdated. GitHub
                is refusing the runner agent — typically the pinned
                actions/runner base has aged past the ~60-day deprecation
                window. Every private repo's CI will sit QUEUED until the base
                image is bumped AND the overlay digest is repinned in
                infra/k8s/production/arc/runner-blue/rendered.yaml.
                ARCRunnersDeprecated normally pages first; if only this one
                fired, the detector's direct POST to Alertmanager is broken
                and that is a second incident.
              runbook_url: "https://github.com/madfam-org/internal-devops/blob/main/runbooks/arc-runner-image-rebuild.md"

  # The messaging last mile watching itself. Migration item M1 / required
  # mitigation 2 of internal-devops
  # decisions/2026-09-05-third-party-messaging-via-angelia-courier.md § 4:
  # every third-party message this estate sends now goes through Angelia
  # Courier, which means angelia-api down is the pager down. That cost is
  # accepted and it is mitigated here.
  #
  # CourierReceiverDown is routed by alertname to `default-receiver` — EMAIL —
  # by the first route in alertmanager.yaml, above the severity routes, with
  # continue: false. The failure of the messaging path must be reported on a
  # path that does not use it; routing it by severity would send the alert
  # about the broken receiver to the broken receiver.
  courier-receiver-rules.yml: |
    groups:
      - name: courier-receiver
        interval: 1m
        rules:
          - alert: CourierReceiverDown
            expr: increase(alertmanager_notifications_failed_total{integration="webhook"}[15m]) > 0
            for: 5m
            labels:
              severity: critical
              service: alertmanager
              category: alerting-last-mile
            annotations:
              summary: "Alertmanager cannot deliver to the Courier receiver"
              description: |
                Alertmanager has failed at least one `webhook` notification in
                the last 15 minutes. The only webhook receiver configured is
                Angelia Courier (`/v1/courier/alertmanager`). The Alertmanager
                log line `Notify for alerts failed` names the receiver: a
                failure on `critical-receiver` or `courier-only-receiver` means
                pages are reaching people by EMAIL ONLY; one on
                `warning-receiver` loses no page (Courier skips warnings).

                Four causes, in the order they are worth checking:
                  1. TOO LARGE — 413 `FST_ERR_CTP_BODY_TOO_LARGE`. A batch
                     outgrew the receiver's 1 MiB body limit and was refused
                     whole. Every Courier webhook carries `max_alerts` for
                     this (alertmanager.yaml, note above critical-receiver);
                     a 413 means that cap was removed or alerts grew past its
                     per-alert budget. Before the cap this fired falsely about
                     every 3h on the warning digest (2026-10-05).
                  2. NOT PROVISIONED — 503 not_provisioned. The intake target
                     `angelia/courier-alertmanager` (or the receiver's
                     recipient) is missing. It was provisioned and
                     delivering on 2026-10-05, so this now means the secret
                     was lost, not that it was never armed.
                  3. UNAUTHORIZED — 401. The mounted credential and the value
                     angelia-api holds have diverged; re-run the intake target
                     so both sides re-sync from the one copy in Vault.
                  4. UNREACHABLE — angelia-api is down, or the alertmanager
                     egress rule to the `angelia` namespace on TCP 8787 was
                     changed. A combined namespaceSelector+podSelector in that
                     rule silently denies on k3s.

                This alert is deliberately routed to the email receiver and
                never to the webhook. If you are reading it in a chat message,
                the routing is wrong.
              runbook_url: "https://github.com/madfam-org/angelia/blob/main/docs/runbooks/courier-provisioning.md"

  # The other half of the pair, and the pipeline's own pulse.
  #
  # On 2026-09-24 every notification this estate tried to send had been
  # failing for weeks: email with Gmail `535 BadCredentials`, then `454 Too
  # many login attempts`, and the webhook with no credential. CourierReceiverDown
  # covered the webhook half and was itself routed to the broken email. Nothing
  # reported the EMAIL half at all, so the fallback could die silently.
  #
  # AlertmanagerEmailDeliveryFailing is the mirror of CourierReceiverDown: it
  # is routed by alertname to `courier-only-receiver` (webhook, no email) in
  # alertmanager.yaml. Each last mile reports the other's failure, so one
  # working path is enough to learn the other is dead. If BOTH are dead no
  # in-cluster rule can tell anyone; that is what Watchdog is for.
  #
  # Watchdog always fires. It proves rule evaluation and the push to every
  # Alertmanager peer, end to end. It routes to `watchdog-sink` (no
  # integrations), so it pages nobody. Its presence on all three peers is the
  # check an operator runs by hand today, and the hook an outside-the-cluster
  # heartbeat attaches to once one is sanctioned. Absent from any peer means
  # the pipeline from this Prometheus to that peer is broken.
  alert-delivery-rules.yml: |
    groups:
      - name: alert-delivery
        interval: 1m
        rules:
          - alert: Watchdog
            expr: vector(1)
            labels:
              severity: none
              service: alertmanager
              category: alerting-pipeline
            annotations:
              summary: "Alerting pipeline heartbeat (always firing, pages nobody)"
              description: |
                This alert fires permanently. It exists to be seen, not
                delivered: Alertmanager routes it to `watchdog-sink`, which
                has no integrations. If it is missing from an Alertmanager
                peer's /api/v2/alerts, this Prometheus is not reaching that
                peer and every other alert is missing there too.

          - alert: AlertmanagerEmailDeliveryFailing
            expr: sum by (pod) (increase(alertmanager_notifications_failed_total{integration="email"}[15m])) > 0
            for: 10m
            labels:
              severity: critical
              service: alertmanager
              category: alerting-last-mile
            annotations:
              summary: "Alertmanager {{ $labels.pod }} cannot deliver email"
              description: |
                {{ $labels.pod }} failed at least one email notification in
                the last 15 minutes, for 10 minutes running. Email is the
                fallback that does not depend on angelia-api. While this
                fires, alerts reach people only through Angelia Courier.

                Read the reason in the pod log:
                  kubectl -n monitoring logs {{ $labels.pod }} --since=30m | grep 'email\['
                  535 BadCredentials    the Gmail app password was revoked or
                                        rotated; mint a new one and submit it:
                                        `enclii secrets intake submit monitoring/alertmanager-smtp`.
                  could not read        the alertmanager-smtp Secret has not
                  .../smtp-password     synced: same intake submit, then
                                        check the ExternalSecret's status.
                  454 Too many login    Google is throttling the retry storm
                                        from a bad password. It clears once
                                        logins succeed.
                  550 5.4.5 / quota     Gmail's daily sending limit. Volume,
                                        not credentials: reduce the firing set
                                        or move SMTP to a relay.

                This alert is deliberately routed to the Courier webhook and
                never to email. If you are reading it in an email, the routing
                is wrong.

          # Cross-watch, half 1 of 2. A Prometheus that is down evaluates
          # nothing, including an alert about itself, so each instance watches
          # the other: this one pages when rules-eval is down, and rules-eval
          # pages MainPrometheusDown (prometheus-watchdog-rules.yaml). The
          # absent() branch catches a deleted StatefulSet, and only while
          # kube-state-metrics is up, so a KSM outage does not page as this.
          - alert: RulesEvalPrometheusDown
            expr: |
              (kube_statefulset_status_replicas_ready{namespace="monitoring", statefulset="prometheus-rules-eval"} < 1)
              or on ()
              (
                absent(kube_statefulset_status_replicas_ready{namespace="monitoring", statefulset="prometheus-rules-eval"})
                and on () (count(up{job="kube-state-metrics"} == 1) > 0)
              )
            for: 10m
            labels:
              severity: critical
              service: prometheus
              category: alerting-pipeline
            annotations:
              summary: "rules-eval Prometheus is down: no PrometheusRule alert is being evaluated"
              description: |
                The operator-managed rules-eval Prometheus has had no Ready
                replica for 10 minutes. It evaluates every PrometheusRule in
                the cluster (the alerts each app ships, addon database
                backups, weighbridge), so none of those can fire while this
                one does. This Prometheus and its own rules are unaffected.

                On 2026-09-26 it stayed down for about 18 hours with only
                warnings: first OOM-killed in WAL replay, then its volume
                filled and every start died within a second.

                Read the last termination first:
                  kubectl -n monitoring get pod prometheus-rules-eval-0 -o wide
                  kubectl -n monitoring logs prometheus-rules-eval-0 -c prometheus --previous --tail=30
                  OOMKilled              raise resources in
                                         prometheus-operator/rules-eval-prometheus.yaml
                  SIGBUS / unexpected    the volume is full: check
                  fault address          kubelet_volume_stats_used_bytes, then
                                         expand the PVC (Longhorn resizes online)
                  Pending, quota         monitoring-quota in namespace.yaml

                If the series is absent while kube-state-metrics is up, the
                StatefulSet itself is gone: check the Prometheus CR
                `rules-eval` and the prometheus-operator log.

          # A rule file this Prometheus evaluates that is not a key of the
          # prometheus-rules ConfigMap in git. The list is the ConfigMap's
          # keys (tests/scripts/test_alert_noise_rules.py fails when they
          # differ), so adding a key in a PR means adding it here too.
          - alert: PrometheusRuleFileNotInGit
            expr: |
              count by (rule_group) (
                prometheus_rule_group_rules{job="prometheus", rule_group!~"/etc/prometheus/rules/(alert-delivery-rules|arc-pool-health-rules|chronic-restart-rules|client-slo-rules|cloudflared-tunnel-rules|courier-page-budget-rules|courier-receiver-rules|deploy-parity-alerts|deploy-pipeline-freshness-rules|enclii-alerts|geometry-probe-rules|longhorn-filesystem-health|maintenance-alerts|pager-path-drill-rules|pgbackrest-health-rules|postgres-wal-archive-rules|retainer-cycle-rules|revenue-probe-rules|secret-integrity-rules|synthetic-flow-probe-rules)\\.yml;.*"}
              ) > 0
            for: 15m
            labels:
              severity: warning
              service: prometheus
              category: alerting-pipeline
            annotations:
              summary: "Prometheus evaluates a rule file that is not in git: {{ $labels.rule_group }}"
              description: |
                The main Prometheus loads every key of ConfigMap
                monitoring/prometheus-rules. This group comes from a key that
                is not in infra/k8s/production/monitoring/prometheus.yaml, so
                its rules fire without ever having been reviewed. On
                2026-10-21 two such keys, written by `kubectl patch` six
                months earlier, were found: one held an unfiltered
                PodNotReady that fired for every finished Job pod.

                The ConfigMap syncs with Replace=true, so the next merged
                change to prometheus.yaml removes the key. If the rules are
                wanted, move them into git in that change.

  # THE PAGE BUDGET (infra-stability audit 2026-10-17, pager noise plan
  # step 5). A pager that sends more than a handful of critical pages a day
  # is being trained to be ignored: in the 14 days to 10-17 it sent 772,
  # 31-92 a day at every hour. Courier counts what it actually sent
  # (angelia apps/api/src/courier/metrics.ts, `courier_alarm_pages_total`,
  # first attempts only, never ledger replays) and this rule reads it.
  #
  # WARNING, NOT CRITICAL, on purpose: a page about too many pages must not be
  # one more page. It lands in the warning digest, where the fix (clear or
  # demote the standing causes) is read.
  #
  # What counts as a page: phase opened, reminder or reopened, outcome sent,
  # severity critical. Resolved notices are not pages. The two angelia-api
  # replicas each count their own sends; the sum is the estate's.
  #
  # The scrape is the kubernetes-pods annotation job (angelia-api's pod
  # template carries prometheus.io/scrape, port 9464) through the
  # prometheus-egress rule to angelia:9464 in network-policies.yaml.
  # CourierPageCounterMissing fires (warning) until the angelia image that
  # serves the counter is live: land this after angelia's Courier change is
  # deployed.
  courier-page-budget-rules.yml: |
    groups:
      - name: courier-page-budget
        interval: 1m
        rules:
          - alert: CourierPageBudgetExceeded
            expr: |
              sum(
                increase(courier_alarm_pages_total{severity="critical",outcome="sent",phase=~"opened|reminder|reopened"}[24h])
              ) > 5
            for: 10m
            labels:
              severity: warning
              service: angelia
              category: alerting-last-mile
            annotations:
              summary: "The pager sent {{ $value | printf \"%.0f\" }} critical pages in the last 24h (budget 5)"
              description: |
                Courier sent more than 5 critical pages in 24 hours. Each one
                is a person woken or interrupted; past a handful a day the
                pager is read as noise and a real outage is missed.
                Find what paged: Telegram history, or the Courier ledger rows
                with idempotency keys `alarm:*` from the last day. Then clear
                the standing causes, or demote rules that are not client- or
                revenue-facing (severity: warning goes to this digest).
              runbook_url: "https://github.com/madfam-org/angelia/blob/main/docs/runbooks/courier-provisioning.md"

          - alert: CourierPageCounterMissing
            expr: absent(courier_alarm_pages_total)
            for: 1h
            labels:
              severity: warning
              service: angelia
              category: alerting-last-mile
            annotations:
              summary: "Courier's page counter is not being scraped, so the page budget is unmeasured"
              description: |
                No `courier_alarm_pages_total` series for an hour. Either the
                angelia-api image predates the counter, the metrics listener
                is off (COURIER_METRICS_PORT=0), or the scrape is blocked
                (the pod annotations, angelia-api-ingress-metrics.yaml on the
                angelia side, or the prometheus-egress rule to angelia:9464).
                CourierPageBudgetExceeded cannot fire while this does.

  # =========================================================================
  # Pager path drill. Watchdog proves rules reach Alertmanager; nothing
  # proved that a CRITICAL page reaches a person (Alertmanager route ->
  # critical-receiver -> Courier chat + email) except a real outage. This
  # fires on a schedule so the whole path is exercised while nothing is
  # broken, and a drill that does NOT arrive is the finding.
  #
  # WHEN. Every Monday 16:00-16:05 UTC (10:00-10:05 in Mexico City), plus the
  # one-off window in the expression below.
  #
  # SHAPE. Two series, product="drill-a" and product="drill-b", with
  # `category: revenue-probe`, the label the per-product revenue route in
  # alertmanager.yaml matches (it groups by [alertname, product]). With that
  # route live the drill is two Alertmanager groups: two emails
  # "[CRITICAL] PagerPathDrill" and two Courier webhook posts. Chat shows TWO
  # pages, one per product, because Courier keys each alert on its product
  # (`alarm:PagerPathDrill:<product>:<hour>`, angelia#40), and since
  # angelia#41 each is followed by one resolved notice after 16:05. Either
  # way it pages through critical-receiver.
  #
  # ONE-OFF WINDOW. The second `or` branch fires once, for 5 minutes, at the
  # epoch-second constants in it (UTC). Whoever merges this sets START to
  # the moment the drill should run and END to START + 300 (the test pins
  # the 300), e.g. START=$(date -u -d '2026-10-14 17:00' +%s) with GNU date.
  # A window in the past is inert, so leaving it after the drill pages nobody.
  #
  # No `for:`: the window is the duration. A Prometheus restart or a reload
  # across 16:00 delays the page by at most the group interval.
  # =========================================================================
  pager-path-drill-rules.yml: |
    groups:
      - name: pager-path-drill
        interval: 1m
        rules:
          - alert: PagerPathDrill
            expr: |
              (
                label_replace(vector(1), "product", "drill-a", "", "")
                or
                label_replace(vector(1), "product", "drill-b", "", "")
              )
              and on ()
              (
                (day_of_week() == 1 and hour() == 16 and minute() < 5)
                or
                # ONE-OFF DRILL WINDOW — coordinator sets before merge (START, END = START + 300)
                (vector(time()) >= 1791956700 and vector(time()) < 1791957000)
              )
            labels:
              severity: critical
              category: revenue-probe
              service: alertmanager
            annotations:
              summary: "DRILL — pager path test, no action needed ({{ $labels.product }})"
              description: |
                Scheduled drill of the critical paging path, not an outage.
                It fires every Monday 16:00-16:05 UTC as two series,
                product drill-a and drill-b, and resolves by itself.

                Expected: two emails "[CRITICAL] PagerPathDrill" (one per
                product; their resolved twins follow after 16:05) and two
                chat pages, one per product, each followed by one resolved
                notice (Courier keys pages per product and episode). If
                either never arrives, that last mile is broken: check
                AlertmanagerEmailDeliveryFailing and CourierReceiverDown,
                then the Alertmanager log.
  # =========================================================================
  # The vCTO retainer billing cycle (money-engine wave 2, 2026-10-18).
  #
  # WAITING ON nauta#351. These rules read the `nauta_retainer_cycle_*` and
  # `nauta_retainer_status_*` gauges that nauta#351 publishes on the nauta
  # worker's /metrics (port 3001, scraped by the annotation-based
  # `kubernetes-pods` job; Prometheus reaches the `nauta` namespace through
  # its `enclii.dev/data-access` egress rule). Land this AFTER nauta#351 is
  # deployed and its first scrape is in: before that, RetainerMetricsMissing
  # fires (a warning, the digest) and nothing else can.
  #
  # The gauges (unix seconds, 0 = not yet; labels workspace_id, cycle):
  #   ..._corte_timestamp_seconds, ..._cfdi_deadline_timestamp_seconds (the
  #   end of the 3rd business day from the corte, computed by nauta),
  #   ..._cfdi_stamped_timestamp_seconds, ..._cfdi_sent_timestamp_seconds,
  #   ..._cfdi_delivery_failed (0/1), ..._payment_due_timestamp_seconds,
  #   ..._payment_recorded_timestamp_seconds, ..._paid_in_full (0/1).
  # Status (no labels): nauta_retainer_status_last_success_timestamp_seconds,
  #   nauta_retainer_status_read_ok, nauta_retainer_status_workspaces.
  #
  # WHY CRITICAL: the retainer is the money path that pays the bills today,
  # and its CFDI is a promise to the client with a date on it (3 business
  # days from the corte). The other retainer rules are warnings: a late
  # payment or a stuck mail needs a person this week, not at 03:00.
  #
  # Every cycle rule is a join on (workspace_id, cycle), so it is empty, and
  # cannot fire, while the gauges are absent. Absence is its own warning.
  # `product` is written as retainer-<workspace_id>-<cycle> so Courier pages
  # once per cycle and episode, and two cycles are two pages. `keep_firing_for`
  # bridges a worker restart (the gauges return at the next hourly read)
  # without a resolve and a second page.
  # =========================================================================
  retainer-cycle-rules.yml: |
    groups:
      - name: retainer-cycle
        interval: 1m
        rules:
          - alert: RetainerCfdiOverdue
            expr: |
              label_replace(label_join(
                (
                  max by (workspace_id, cycle) (nauta_retainer_cycle_cfdi_deadline_timestamp_seconds) > 0
                  and max by (workspace_id, cycle) (nauta_retainer_cycle_cfdi_deadline_timestamp_seconds) < time()
                )
                and on (workspace_id, cycle)
                (max by (workspace_id, cycle) (nauta_retainer_cycle_cfdi_stamped_timestamp_seconds) == 0),
                "retainer_key", "-", "workspace_id", "cycle"),
                "product", "retainer-$1", "retainer_key", "(.+)")
            for: 30m
            keep_firing_for: 90m
            labels:
              severity: critical
              category: retainer
            annotations:
              summary: "Retainer CFDI overdue: cycle {{ $labels.cycle }} is past its deadline with no stamp"
              description: |
                Retainer cycle {{ $labels.cycle }} of workspace
                {{ $labels.workspace_id }} passed its CFDI deadline (3 business
                days from the corte) and nauta has no stamped CFDI for it. The
                client was promised the comprobante by that date.

                Next:
                  1. Read the cycle: python3 scripts/money-engine-status.py --cluster
                     (enclii checkout), or the nauta worker's
                     `retainer-cycle-status` log line (nauta OPERATOR_CHECKLIST E3d).
                  2. Stamp from the Nauta cockpit (Timbrar), per the cycle's
                     billing runbook in internal-devops. A late client payment
                     can delay the stamp by ruling; if so, this page is the
                     reminder to record it.
                  3. If the cockpit cannot stamp: Karafiel
                     (enclii ops pods diagnose -n karafiel) and the PAC.

          - alert: RetainerCfdiStampedNotSent
            expr: |
              label_replace(label_join(
                (max by (workspace_id, cycle) (nauta_retainer_cycle_cfdi_stamped_timestamp_seconds) > 0)
                and on (workspace_id, cycle)
                (max by (workspace_id, cycle) (nauta_retainer_cycle_cfdi_sent_timestamp_seconds) == 0)
                and on (workspace_id, cycle)
                (time() - max by (workspace_id, cycle) (nauta_retainer_cycle_cfdi_stamped_timestamp_seconds) > 3600),
                "retainer_key", "-", "workspace_id", "cycle"),
                "product", "retainer-$1", "retainer_key", "(.+)")
            for: 15m
            keep_firing_for: 90m
            labels:
              severity: warning
              category: retainer
            annotations:
              summary: "Retainer CFDI stamped but not sent: cycle {{ $labels.cycle }}"
              description: |
                Cycle {{ $labels.cycle }} of workspace {{ $labels.workspace_id }}
                has a stamped CFDI and, an hour later, no record of the mail
                that delivers it. Check the cycle's delivery in the Nauta
                cockpit and Janua's transactional mail.

          - alert: RetainerCfdiDeliveryFailed
            expr: |
              label_replace(label_join(
                max by (workspace_id, cycle) (nauta_retainer_cycle_cfdi_delivery_failed) == 1,
                "retainer_key", "-", "workspace_id", "cycle"),
                "product", "retainer-$1", "retainer_key", "(.+)")
            for: 5m
            keep_firing_for: 90m
            labels:
              severity: warning
              category: retainer
            annotations:
              summary: "Retainer CFDI delivery failed: cycle {{ $labels.cycle }}"
              description: |
                nauta recorded a FAILED delivery of cycle {{ $labels.cycle }}'s
                CFDI (workspace {{ $labels.workspace_id }}). Resend it from the
                Nauta cockpit after fixing the cause (Janua mail).

          - alert: RetainerPaymentOverdue
            expr: |
              label_replace(label_join(
                (
                  max by (workspace_id, cycle) (nauta_retainer_cycle_payment_due_timestamp_seconds) > 0
                  and max by (workspace_id, cycle) (nauta_retainer_cycle_payment_due_timestamp_seconds) + 86400 < time()
                )
                and on (workspace_id, cycle)
                (max by (workspace_id, cycle) (nauta_retainer_cycle_payment_recorded_timestamp_seconds) == 0),
                "retainer_key", "-", "workspace_id", "cycle"),
                "product", "retainer-$1", "retainer_key", "(.+)")
            for: 30m
            keep_firing_for: 90m
            labels:
              severity: warning
              category: retainer
            annotations:
              summary: "Retainer payment overdue: cycle {{ $labels.cycle }} is a day past due with no payment recorded"
              description: |
                Cycle {{ $labels.cycle }} of workspace {{ $labels.workspace_id }}
                was due a day ago and nauta has no payment record for it. Either
                the client has not paid (follow up) or the payment arrived and
                was not captured in the cockpit («pago recibido»).

          - alert: RetainerMetricsMissing
            expr: |
              absent(nauta_retainer_status_last_success_timestamp_seconds)
            for: 2h
            labels:
              severity: warning
              category: retainer
            annotations:
              summary: "Retainer cycle metrics are missing: the retainer rules cannot fire"
              description: |
                Prometheus has no nauta_retainer_status_* series for 2 hours.
                Until they return, RetainerCfdiOverdue and the other retainer
                rules cannot fire, so an overdue CFDI would go unnoticed.

                Triage:
                  1. enclii ops pods diagnose -n nauta (is nauta-worker running,
                     on an image with nauta#351?).
                  2. Its prometheus.io scrape annotations and the
                     allow-monitoring-ingress-worker NetworkPolicy (nauta repo).

          - alert: RetainerStatusNotRead
            expr: |
              (
                time() - max(nauta_retainer_status_last_success_timestamp_seconds) > 7200
              )
              or (max(nauta_retainer_status_read_ok) == 0)
              or (max(nauta_retainer_status_workspaces) == 0)
            for: 75m
            labels:
              severity: warning
              category: retainer
            annotations:
              summary: "The nauta worker is not reading the retainer cycles (gauges are stale or empty)"
              description: |
                The nauta worker's hourly retainer read has not succeeded for
                two hours, reports a failure, or found no retainer workspace.
                The cycle gauges are stale or empty, so the retainer rules see
                nothing. Read the worker's log (retainer-cycle-status job).

  # =========================================================================
  # cv (cv.madfam.io, cv-app.madfam.io, cv-api.madfam.io) availability and
  # delivery (added 2026-10-22). Reviewed source: internal-devops
  # grafana/alerts/cv.yaml (madfam-org/internal-devops#886), runbook
  # runbooks/cv-alerts.md there. Scrape: the existing `kubernetes-pods`
  # annotation job reads the pods' internal 9090 listener
  # (ai-portfolio-builder#16); no job was added and no selector widened.
  # Verified before landing (2026-10-22, about 19:06Z, main Prometheus):
  # count(up{job="kubernetes-pods",namespace="cv",app="cv"}) = 2,
  # min(cv_ready) = 1, kube_namespace_status_phase{namespace="cv"} present,
  # no kube_job_failed{namespace="cv",condition="true"}, so nothing fires on
  # load. Main Prometheus only: rules-eval scrapes the same pods, and a
  # second copy there would page twice through its other external labels.
  # 503 never pages (dormant sign-in answers 503 by design).
  # =========================================================================
  cv-rules.yml: |
    groups:
      - name: cv.availability
        interval: 30s
        rules:
          - alert: CVTargetDown
            # No cv pod can be scraped for 2 minutes: every pod is down, or none exists, or the scrape path
            # (NetworkPolicy, annotations, the listener) is broken. The metrics listener runs in the app process, so a
            # dead process is a dead target; a scrape-path break is blindness, which also deserves a person.
            expr: |
              absent(up{job="kubernetes-pods", namespace="cv", app="cv"})
              or max(up{job="kubernetes-pods", namespace="cv", app="cv"}) == 0
            for: 2m
            labels:
              severity: critical
              product: cv
              service: cv
            annotations:
              summary: "cv is down or unobservable: no cv pod answers a scrape on 9090 (2m)"
              description: |
                No pod of Deployment cv/cv has answered GET /metrics on its internal port 9090 for 2 minutes.
                Either no pod runs (crash loop, failed pull, scaled to 0) and cv.madfam.io, cv-app.madfam.io and
                cv-api.madfam.io are down, or the scrape path broke (NetworkPolicy allow-monitoring-ingress, the
                prometheus.io annotations, the namespace's data-access label). Check `enclii ops pods diagnose -n cv`
                and the public /health first, then the target list (lastError) on the main Prometheus.
              runbook_url: https://github.com/madfam-org/internal-devops/blob/main/runbooks/cv-alerts.md#cvtargetdown

          - alert: CVReadinessFailing
            # Every scraped pod reports its last /ready as failed for 3 minutes, so Service cv has no ready endpoint and
            # the edge answers 502/503 on every host. /ready fails when the configuration is invalid or when the
            # configured database does not answer `select 1` within 2 s.
            expr: |
              max(cv_ready{job="kubernetes-pods", namespace="cv", app="cv"}) == 0
            for: 3m
            labels:
              severity: critical
              product: cv
              service: cv
            annotations:
              summary: "cv has no ready pod: /ready fails on every pod (3m)"
              description: |
                cv_ready is 0 on every scraped cv pod for 3 minutes, so the Service has no ready endpoint. The
                readiness body names the failing check (config or database). If cv_db_readiness_checks_total
                {outcome="error"} is rising, PgBouncer/Postgres in `data` is unreachable from cv (NetworkPolicy
                allow-pgbouncer-egress, the cv_app role, the shared connection budget).
              runbook_url: https://github.com/madfam-org/internal-devops/blob/main/runbooks/cv-alerts.md#cvreadinessfailing

          - alert: CVHigh5xxRate
            # More than 5% of a host role's requests end in a 5xx other than 503, with at least 5 such errors in the
            # last 5 minutes, for 5 minutes. Per host role, so a broken API is not diluted by landing traffic.
            expr: |
              (
                sum by (host_role) (rate(cv_http_requests_total{job="kubernetes-pods", namespace="cv", host_role!="none", status=~"5..", status!="503"}[5m]))
                /
                sum by (host_role) (rate(cv_http_requests_total{job="kubernetes-pods", namespace="cv", host_role!="none"}[5m]))
              ) > 0.05
              and
              sum by (host_role) (increase(cv_http_requests_total{job="kubernetes-pods", namespace="cv", host_role!="none", status=~"5..", status!="503"}[5m])) >= 5
            for: 5m
            labels:
              severity: critical
              product: cv
              service: cv
            annotations:
              summary: "cv {{ $labels.host_role }}: {{ $value | humanizePercentage }} of requests fail with a 5xx (5m)"
              description: |
                Requests to the {{ $labels.host_role }} host (landing = cv.madfam.io, app = cv-app.madfam.io,
                api = cv-api.madfam.io, pages = the user-pages host) are failing with 500/502/504 above 5% for
                5 minutes. 503 is excluded on purpose (dormant features and the readiness path). The JSON request
                log names the failing route template: `"level":"error"` lines with this host_role.
              runbook_url: https://github.com/madfam-org/internal-devops/blob/main/runbooks/cv-alerts.md#cvhigh5xxrate

      - name: cv.delivery
        interval: 60s
        rules:
          - alert: CVPreSyncMigrateFailing
            # The Argo PreSync migrate Job (cv-migrate) failed terminally (backoffLimit exhausted or its 300 s deadline
            # passed), so the sync is blocked and no new image rolls, including a fix. kube_job_failed{condition="true"}
            # is the Job's Failed CONDITION, not kube_job_status_failed (failed pod count), which is already 1 when a
            # first attempt fails and a retry succeeds. The hook policy BeforeHookCreation replaces the Job on the next
            # sync, and the Job's TTL is 24 h, so the alert clears on a successful sync or after a day.
            expr: |
              max by (namespace, job_name) (kube_job_failed{namespace="cv", job_name="cv-migrate", condition="true"}) == 1
            for: 1m
            labels:
              severity: critical
              product: cv
              service: cv
            annotations:
              summary: "cv deploys are blocked: the PreSync migrate Job failed"
              description: |
                Job cv/cv-migrate failed terminally, so the Argo sync of cv-services stopped before the Deployment.
                The running pods keep serving the previous image. Its log ends with "cv migrate: failed: <reason>"
                (no URL or value is printed). Verify applied migrations in drizzle.__drizzle_migrations, never only
                the Job status.
              runbook_url: https://github.com/madfam-org/internal-devops/blob/main/runbooks/cv-alerts.md#cvpresyncmigratefailing

          - alert: CVMigrateJobUnobservable
            # Read-proof for the rule above: kube-state-metrics exports Job series only while a Job object exists, so
            # absence is normal between syncs. What must exist is the namespace itself; if kube_namespace_status_phase
            # has no `cv` series, every kube_* rule for cv is blind.
            expr: |
              absent(kube_namespace_status_phase{namespace="cv", phase="Active"})
            for: 15m
            labels:
              severity: warning
              product: cv
              service: cv
            annotations:
              summary: "cv kube-state rules are blind (no kube-state-metrics series for namespace cv)"
              description: |
                kube-state-metrics exports nothing for namespace cv, so CVPreSyncMigrateFailing cannot fire. Either
                kube-state-metrics is not scraped, or the namespace was renamed or deleted.
              runbook_url: https://github.com/madfam-org/internal-devops/blob/main/runbooks/cv-alerts.md#cvmigratejobunobservable

---
# Prometheus PVC
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: prometheus-data
  namespace: monitoring
  labels:
    app.kubernetes.io/name: prometheus
    app.kubernetes.io/component: monitoring
    app.kubernetes.io/part-of: enclii
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 20Gi
  storageClassName: longhorn
---
# Prometheus Deployment
apiVersion: apps/v1
kind: Deployment
metadata:
  name: prometheus
  namespace: monitoring
  labels:
    app.kubernetes.io/name: prometheus
    app.kubernetes.io/component: monitoring
    app.kubernetes.io/part-of: enclii
spec:
  replicas: 1
  strategy:
    type: Recreate  # Prevents PVC lock contention during rollouts
  selector:
    matchLabels:
      app: prometheus
  template:
    metadata:
      labels:
        app: prometheus
        app.kubernetes.io/name: prometheus
        app.kubernetes.io/component: monitoring
        app.kubernetes.io/part-of: enclii
    spec:
      serviceAccountName: prometheus
      securityContext:
        fsGroup: 65534
        runAsUser: 65534
        runAsNonRoot: true
      containers:
        - name: prometheus
          image: docker.io/prom/prometheus:v2.53.3@sha256:c62e2f333beae2fdac8c3c7a3daaa7ac81110023cbc5857b0ec541f09d997951
          securityContext:
            privileged: false
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: false
            capabilities:
              drop:
                - ALL
          args:
            - "--config.file=/etc/prometheus/prometheus.yml"
            - "--storage.tsdb.path=/prometheus"
            - "--storage.tsdb.retention.time=7d"
            - "--storage.tsdb.retention.size=8GB"
            - "--web.console.libraries=/usr/share/prometheus/console_libraries"
            - "--web.console.templates=/usr/share/prometheus/consoles"
            - "--web.enable-lifecycle"
          ports:
            - containerPort: 9090
              name: http
          # 2026-09-23: 2Gi -> 4Gi. After #572 fixed the rule-template crash,
          # Prometheus still restarted ~7.4k times (exit 137, SIGKILL): WAL
          # replay finishes after ~60s, and the kill comes ~7s later. Sampled with
          # `kubectl top`, the pod went 968Mi -> 1516Mi -> 1825Mi within ~45s of
          # replay, against the 2Gi limit, and was killed before the next sample.
          # The WAL has grown through 4 weeks of crash-looping. The request stays
          # at 768Mi, so scheduling is unchanged; monitoring-quota limits.memory
          # is raised in namespace.yaml to fit.
          # 2026-09-27: 4Gi -> 6Gi. The working set reached 3.79Gi of the 4Gi
          # limit (95%) over 24h at about 677k head series. The request goes
          # 768Mi -> 3Gi: a pod using 3.6Gi against a 768Mi request is the
          # first one evicted under node memory pressure, and this one carries
          # the paging rules. monitoring-quota is raised to fit.
          resources:
            requests:
              memory: "3Gi"
              cpu: "200m"
            limits:
              memory: "6Gi"
              cpu: "500m"
          volumeMounts:
            - name: config
              mountPath: /etc/prometheus
            - name: rules
              mountPath: /etc/prometheus/rules
            - name: data
              mountPath: /prometheus
          startupProbe:
            httpGet:
              path: /-/ready
              port: 9090
            initialDelaySeconds: 15
            periodSeconds: 10
            failureThreshold: 30
            timeoutSeconds: 5
          readinessProbe:
            httpGet:
              path: /-/ready
              port: 9090
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /-/healthy
              port: 9090
            initialDelaySeconds: 30
            periodSeconds: 15
            timeoutSeconds: 5
            failureThreshold: 3
        # Applies merged config and rule changes. The kubelet refreshes both
        # ConfigMap directory mounts on its own, but Prometheus reads them only
        # at start or on POST /-/reload, and nothing called it: #626 (Watchdog,
        # dead-email reporting) and #627 (backup freshness alerts) sat merged
        # and synced for 23 hours on 2026-09-24/25 while the old rules kept
        # paging on stale Job objects. This watches both directories and posts
        # /-/reload when their contents change. The image is the one the
        # prometheus-operator injects into rules-eval (operator.yaml), pinned
        # by digest.
        - name: config-reloader
          image: quay.io/prometheus-operator/prometheus-config-reloader:v0.93.1@sha256:428f088fe6fe07ab138bda92113664b04848a1dc408e4d3680a60ecdb55d1a65
          args:
            - --listen-address=:8080
            - --reload-url=http://127.0.0.1:9090/-/reload
            - --watched-dir=/etc/prometheus
            - --watched-dir=/etc/prometheus/rules
          securityContext:
            privileged: false
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          resources:
            requests:
              memory: "32Mi"
              cpu: "10m"
            limits:
              memory: "64Mi"
              cpu: "50m"
          volumeMounts:
            - name: config
              mountPath: /etc/prometheus
              readOnly: true
            - name: rules
              mountPath: /etc/prometheus/rules
              readOnly: true
      volumes:
        - name: config
          configMap:
            name: prometheus-config
        - name: rules
          configMap:
            name: prometheus-rules
        - name: data
          persistentVolumeClaim:
            claimName: prometheus-data
---
# Prometheus Service
apiVersion: v1
kind: Service
metadata:
  name: prometheus
  namespace: monitoring
  labels:
    app.kubernetes.io/name: prometheus
    app.kubernetes.io/component: monitoring
    app.kubernetes.io/part-of: enclii
  annotations:
    prometheus.io/scrape: "true"
    prometheus.io/port: "9090"
spec:
  type: ClusterIP
  ports:
    - port: 9090
      targetPort: 9090
      name: http
  selector:
    app: prometheus
