---
# Prometheus RBAC
apiVersion: v1
kind: ServiceAccount
metadata:
  name: prometheus
  namespace: monitoring
  labels:
    app.kubernetes.io/name: prometheus
    app.kubernetes.io/component: monitoring
    app.kubernetes.io/part-of: enclii
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: prometheus
  labels:
    app.kubernetes.io/name: prometheus
    app.kubernetes.io/component: monitoring
    app.kubernetes.io/part-of: enclii
rules:
  - apiGroups: [""]
    resources:
      - nodes
      - nodes/proxy
      - nodes/metrics
      - services
      - endpoints
      - pods
    verbs: ["get", "list", "watch"]
  - apiGroups: ["extensions", "networking.k8s.io"]
    resources:
      - ingresses
    verbs: ["get", "list", "watch"]
  - nonResourceURLs: ["/metrics", "/metrics/cadvisor"]
    verbs: ["get"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: prometheus
  labels:
    app.kubernetes.io/name: prometheus
    app.kubernetes.io/component: monitoring
    app.kubernetes.io/part-of: enclii
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: prometheus
subjects:
  - kind: ServiceAccount
    name: prometheus
    namespace: monitoring
---
# Prometheus Configuration
apiVersion: v1
kind: ConfigMap
metadata:
  name: prometheus-config
  namespace: monitoring
  labels:
    app.kubernetes.io/name: prometheus
    app.kubernetes.io/component: monitoring
    app.kubernetes.io/part-of: enclii
data:
  prometheus.yml: |
    global:
      scrape_interval: 30s
      evaluation_interval: 30s
      external_labels:
        cluster: enclii-production
        environment: production

    alerting:
      alertmanagers:
        - static_configs:
            - targets:
              - alertmanager:9093

    rule_files:
      - /etc/prometheus/rules/*.yml

    scrape_configs:
      # Prometheus self-monitoring
      - job_name: 'prometheus'
        static_configs:
          - targets: ['localhost:9090']

      # Kubernetes API server
      - job_name: 'kubernetes-apiservers'
        kubernetes_sd_configs:
          - role: endpoints
        scheme: https
        tls_config:
          ca_file: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
        bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token
        relabel_configs:
          - source_labels: [__meta_kubernetes_namespace, __meta_kubernetes_service_name, __meta_kubernetes_endpoint_port_name]
            action: keep
            regex: default;kubernetes;https

      # Kubernetes nodes
      - job_name: 'kubernetes-nodes'
        kubernetes_sd_configs:
          - role: node
        scheme: https
        tls_config:
          ca_file: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
        bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token
        relabel_configs:
          - action: labelmap
            regex: __meta_kubernetes_node_label_(.+)

      # Kubernetes node cadvisor metrics
      - job_name: 'kubernetes-cadvisor'
        kubernetes_sd_configs:
          - role: node
        scheme: https
        tls_config:
          ca_file: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
        bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token
        metrics_path: /metrics/cadvisor
        relabel_configs:
          - action: labelmap
            regex: __meta_kubernetes_node_label_(.+)

      # Kubernetes pods with prometheus.io annotations
      - job_name: 'kubernetes-pods'
        kubernetes_sd_configs:
          - role: pod
        relabel_configs:
          - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_scrape]
            action: keep
            regex: true
          - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_path]
            action: replace
            target_label: __metrics_path__
            regex: (.+)
          - source_labels: [__address__, __meta_kubernetes_pod_annotation_prometheus_io_port]
            action: replace
            regex: ([^:]+)(?::\d+)?;(\d+)
            replacement: $1:$2
            target_label: __address__
          - action: labelmap
            regex: __meta_kubernetes_pod_label_(.+)
          - source_labels: [__meta_kubernetes_namespace]
            action: replace
            target_label: namespace
          - source_labels: [__meta_kubernetes_pod_name]
            action: replace
            target_label: pod

      # Kubernetes services with prometheus.io annotations
      - job_name: 'kubernetes-services'
        kubernetes_sd_configs:
          - role: endpoints
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_annotation_prometheus_io_scrape]
            action: keep
            regex: true
          - source_labels: [__meta_kubernetes_service_annotation_prometheus_io_path]
            action: replace
            target_label: __metrics_path__
            regex: (.+)
          - source_labels: [__address__, __meta_kubernetes_service_annotation_prometheus_io_port]
            action: replace
            target_label: __address__
            regex: ([^:]+)(?::\d+)?;(\d+)
            replacement: $1:$2
          - action: labelmap
            regex: __meta_kubernetes_service_label_(.+)
          - source_labels: [__meta_kubernetes_namespace]
            action: replace
            target_label: namespace
          - source_labels: [__meta_kubernetes_service_name]
            action: replace
            target_label: service

      # Switchyard API metrics
      - job_name: 'switchyard-api'
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names:
                - enclii
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_label_app]
            action: keep
            regex: switchyard-api
          - source_labels: [__meta_kubernetes_endpoint_port_name]
            action: keep
            regex: http
        metrics_path: /metrics

      # Pushgateway — batch/CronJob metrics.
      #
      # ADDED 2026-08-11. The pushgateway has existed for 96 days and NOTHING
      # HAS EVER SCRAPED IT: there was no job here, so every metric the
      # CronJob monitors push has been written to a gateway Prometheus never
      # read. That silently voided every alert built on them, including
      # ArgoMainParityDrift and the whole deploy-pipeline-monitor alert family.
      #
      # It was found on 2026-08-11 while arming a new rollout-truth alert: the
      # rules loaded, the monitor ran, the metric sat on the gateway, and the
      # series count in Prometheus was zero. An alert is usually dead in more
      # than one way at once — this was the second way.
      #
      # honor_labels: true is REQUIRED, not stylistic. Pushed samples already
      # carry their own `job` (e.g. argo_main_parity_monitor) and `instance`.
      # Without it Prometheus overwrites both with this scrape's job/instance,
      # so every pusher collapses into one series set and alert expressions
      # that group by application/repo silently lose their identity.
      - job_name: 'pushgateway'
        honor_labels: true
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names:
                - monitoring
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_label_app_kubernetes_io_name]
            action: keep
            regex: pushgateway
          # The Service and its headless twin share every label, so without
          # this the same gateway is scraped twice and each sample arrives
          # duplicated. Keep the stable ClusterIP Service only.
          - source_labels: [__meta_kubernetes_service_name]
            action: keep
            regex: pushgateway

      # Node exporter metrics (host CPU, memory, disk, network)
      - job_name: 'node-exporter'
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names:
                - monitoring
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_label_app_kubernetes_io_name]
            action: keep
            regex: node-exporter

      # Kubernetes OBJECT state (jobs, pods, deployments) — the series that the
      # kube_job_*/kube_pod_*/kube_deployment_* alert rules query.
      #
      # honor_labels: true is LOAD-BEARING, not style. Every sample here already
      # carries the `namespace`, `pod` and `job` of the object it DESCRIBES.
      # Without honor_labels those are overwritten by the scrape target's own
      # identity (namespace="monitoring", pod="kube-state-metrics-…") and the
      # originals are pushed to exported_*. BackupJobFailed{namespace="data"}
      # would then never match and would stay silently dead — the exact failure
      # this exporter is being deployed to end.
      #
      # For the same reason this uses endpoints discovery with no namespace/pod
      # relabeling, rather than the annotation-based kubernetes-pods job.
      - job_name: 'kube-state-metrics'
        honor_labels: true
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names:
                - monitoring
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_label_app_kubernetes_io_name]
            action: keep
            regex: kube-state-metrics
          # Metrics port only; drop the self-telemetry endpoint target.
          - source_labels: [__meta_kubernetes_endpoint_port_name]
            action: keep
            regex: http-metrics

      # Redis metrics (redis-exporter in data namespace)
      - job_name: 'redis'
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names:
                - data
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_label_app_kubernetes_io_name]
            action: keep
            regex: redis-exporter

      # PostgreSQL metrics (postgres-exporter in data namespace)
      - job_name: 'postgres'
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names:
                - data
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_label_app_kubernetes_io_name]
            action: keep
            regex: postgres-exporter

      # Roundhouse Build Worker metrics
      - job_name: 'roundhouse'
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names:
                - enclii
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_label_app]
            action: keep
            regex: roundhouse
          - source_labels: [__meta_kubernetes_endpoint_port_name]
            action: keep
            regex: metrics
        metrics_path: /metrics

      # ArgoCD metrics
      - job_name: 'argocd'
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names:
                - argocd
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_annotation_prometheus_io_scrape]
            action: keep
            regex: true
          - source_labels: [__meta_kubernetes_service_annotation_prometheus_io_port]
            action: replace
            target_label: __address__
            regex: ([^:]+)(?::\d+)?;(\d+)
            replacement: $1:$2
          - source_labels: [__address__, __meta_kubernetes_service_annotation_prometheus_io_port]
            action: replace
            regex: ([^:]+)(?::\d+)?;(\d+)
            replacement: $1:$2
            target_label: __address__

      # Kyverno metrics
      - job_name: 'kyverno'
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names:
                - kyverno
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_label_app_kubernetes_io_component]
            action: keep
            regex: admission-controller|background-controller
        metrics_path: /metrics

      # External Secrets metrics
      - job_name: 'external-secrets'
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names:
                - external-secrets
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_annotation_prometheus_io_scrape]
            action: keep
            regex: true
---
# Alert Rules ConfigMap
apiVersion: v1
kind: ConfigMap
metadata:
  name: prometheus-rules
  namespace: monitoring
  labels:
    app.kubernetes.io/name: prometheus
    app.kubernetes.io/component: monitoring
    app.kubernetes.io/part-of: enclii
data:
  enclii-alerts.yml: |
    groups:
      - name: enclii-platform
        interval: 30s
        rules:
          # API Health
          - alert: SwitchyardAPIDown
            expr: up{job="switchyard-api"} == 0
            for: 2m
            labels:
              severity: critical
              service: switchyard-api
            annotations:
              summary: "Switchyard API is down"
              description: "Switchyard API has been down for more than 2 minutes."

          - alert: SwitchyardAPIHighLatency
            expr: histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job="switchyard-api"}[5m])) > 0.5
            for: 5m
            labels:
              severity: warning
              service: switchyard-api
            annotations:
              summary: "Switchyard API high latency"
              description: "95th percentile latency is above 500ms for 5 minutes."

          - alert: SwitchyardAPIHighErrorRate
            expr: sum(rate(http_requests_total{job="switchyard-api",status=~"5.."}[5m])) / sum(rate(http_requests_total{job="switchyard-api"}[5m])) > 0.02
            for: 5m
            labels:
              severity: warning
              service: switchyard-api
            annotations:
              summary: "Switchyard API high error rate"
              description: "Error rate is above 2% for 5 minutes."

          # Database Health
          - alert: PostgresDown
            expr: pg_up == 0
            for: 1m
            labels:
              severity: critical
              service: postgres
            annotations:
              summary: "PostgreSQL is down"
              description: "PostgreSQL database is not responding."

          - alert: PostgresHighConnections
            expr: pg_stat_activity_count / pg_settings_max_connections > 0.8
            for: 5m
            labels:
              severity: warning
              service: postgres
            annotations:
              summary: "PostgreSQL high connection usage"
              description: "Connection pool usage is above 80%."

          # PgBouncer userlist drift (availability remediation Tier 0.6, enclii#436/#441).
          # Metrics come from switchyard-api's in-process drift checker
          # (internal/reconciler/pgbouncer_drift_checker.go). Three rules on
          # purpose: (a) the drift itself, (b) the checker erroring, (c) the
          # checker dead — (a) alone can lie if the checker dies with
          # missing_users frozen at 0. Full rationale + synthetic-test recipe:
          # docs/monitoring/pgbouncer-drift-alerts.md.
          - alert: PgbouncerUserlistDrift
            expr: enclii_pgbouncer_userlist_missing_users > 0
            for: 10m
            labels:
              severity: critical
              service: pgbouncer
            annotations:
              summary: "pgbouncer userlist drift — pooler auth diverged from DB truth (the 2026-08-24 outage class)"
              description: "{{ $value }} Postgres login role(s) exist that pgbouncer's userlist does not have a line for. Every pooled connection as those roles is failing auth right now — this is the exact drift class that took fortuna/bloom-scroll/ceq hard-down for days on 2026-08-24. Check GET /v1/admin/provision/pgbouncer/reconcile on switchyard-api for the current missing-role list; repair requires the role's password from the consuming service's own secret (see internal-devops/scripts/restore-pgbouncer-users.py) — this alert does NOT self-heal."

          - alert: PgbouncerUserlistCheckErrors
            expr: increase(enclii_pgbouncer_userlist_check_errors_total[15m]) > 0
            for: 5m
            labels:
              severity: warning
              service: pgbouncer
            annotations:
              summary: "pgbouncer userlist drift checker is erroring"
              description: "The periodic userlist drift checker (switchyard-api, ENCLII_PGBOUNCER_DRIFT_CHECK_ENABLED) failed {{ $value }} time(s) in the last 15 minutes instead of completing a comparison. Likely causes: Postgres admin connection down, k8s API access lost, or ENCLII_POSTGRES_ADMIN_URL/k8s client not configured. Missing_users may be stale while this fires."

          - alert: PgbouncerUserlistCheckerDead
            expr: time() - enclii_pgbouncer_userlist_last_check_timestamp_seconds > 900
            for: 5m
            labels:
              severity: warning
              service: pgbouncer
            annotations:
              summary: "pgbouncer userlist drift detector itself is dead"
              description: "No successful userlist drift check has completed in over 15 minutes (checker runs every 5m). Per the availability audit's green-lies doctrine, treat this as UNKNOWN, not healthy — PgbouncerUserlistDrift staying quiet right now proves nothing. Check whether the switchyard-api process is up and whether the checker goroutine panicked/exited; see internal/reconciler/pgbouncer_drift_checker.go."

          # Redis Health
          - alert: RedisDown
            expr: redis_up == 0
            for: 1m
            labels:
              severity: critical
              service: redis
            annotations:
              summary: "Redis is down"
              description: "Redis cache is not responding."

          - alert: RedisHighMemory
            expr: (redis_memory_max_bytes > 0 and redis_memory_used_bytes / redis_memory_max_bytes > 0.85) or (redis_memory_max_bytes == 0 and redis_memory_used_bytes > 170000000)
            for: 5m
            labels:
              severity: warning
              service: redis
            annotations:
              summary: "Redis high memory usage"
              description: "Redis memory usage is above 85%."

          # Redis HA — Sentinel cluster health (P1.3, deployed 2026-04)
          # Scrapes come from the redis_exporter sidecars on the redis-ha StatefulSet.
          # The sidecars carry pod annotations `prometheus.io/scrape=true` +
          # `prometheus.io/port=9121`, so they land in the `kubernetes-pods`
          # job above. The pod label `app=redis-ha` is copied to `app` on the
          # metric via the labelmap rule. This distinguishes the HA pods from
          # the single-instance `redis` Deployment (app=redis) and from any
          # other redis-exporter Services in the cluster.
          - alert: RedisSentinelDown
            # Fewer than 3 redis-ha pods reporting healthy for > 5m. Quorum
            # holds at 2, so this is a warning — but the next failure will
            # break quorum.
            expr: count(redis_up{app="redis-ha"} == 1) < 3
            for: 5m
            labels:
              severity: warning
              service: redis-ha
              component: sentinel
            annotations:
              summary: "Redis Sentinel pod(s) unreachable"
              description: "Expected 3 Sentinel+Redis pods, observed {{ $value }} up. Quorum is still safe at 2; investigate before the next failure."
              runbook_url: "https://github.com/madfam-org/enclii/blob/main/docs/runbooks/redis-sentinel-migration.md#troubleshooting"

          - alert: RedisMasterDown
            # No master detected — this is the failover edge. 30s window
            # lets Sentinel complete auto-failover (down-after=5s, failover-timeout=18s)
            # before we page.
            expr: max(redis_instance_info{role="master", app="redis-ha"}) != 1
            for: 30s
            labels:
              severity: critical
              service: redis-ha
              component: redis
            annotations:
              summary: "Redis HA has no master"
              description: "No Redis pod in the redis-ha StatefulSet is reporting role=master. Sentinel failover may have failed. Page on-call."
              runbook_url: "https://github.com/madfam-org/enclii/blob/main/docs/runbooks/redis-sentinel-migration.md#master-loss-recovery"

          - alert: RedisReplicationLag
            # Replica slave_repl_offset falls > 30s worth of bytes behind master
            # AOF stream. Uses the `redis_master_repl_offset_bytes` +
            # `redis_connected_slave_offset_bytes` deltas exposed by redis_exporter.
            expr: |
              (
                max(redis_master_repl_offset_bytes{app="redis-ha"})
                -
                min(redis_connected_slave_offset_bytes{app="redis-ha"})
              ) > 30 * 1024 * 1024
            for: 2m
            labels:
              severity: warning
              service: redis-ha
              component: replication
            annotations:
              summary: "Redis HA replica behind master"
              description: "A Redis HA replica is >30MB behind master offset for >2m. Check network, replica disk I/O, or replica OOM."
              runbook_url: "https://github.com/madfam-org/enclii/blob/main/docs/runbooks/redis-sentinel-migration.md#replication-lag"

      - name: kubernetes-resources
        interval: 30s
        rules:
          # Node Resources
          - alert: NodeHighCPU
            expr: 100 - (avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 80
            for: 15m
            labels:
              severity: warning
            annotations:
              summary: "Node CPU high"
              description: "Node {{ $labels.instance }} CPU usage is above 80% for 15 minutes."

          - alert: NodeHighMemory
            expr: (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100 > 85
            for: 10m
            labels:
              severity: warning
            annotations:
              summary: "Node memory high"
              description: "Node {{ $labels.instance }} memory usage is above 85%."

          - alert: NodeDiskSpaceWarning
            expr: (1 - node_filesystem_avail_bytes{fstype!~"tmpfs|overlay"} / node_filesystem_size_bytes{fstype!~"tmpfs|overlay"}) * 100 > 85
            for: 10m
            labels:
              severity: warning
            annotations:
              summary: "Node disk space warning (>85%)"
              description: "Node {{ $labels.instance }} disk usage is {{ printf \"%.1f\" $value }}%. Consider cleanup."

          - alert: NodeDiskSpaceCritical
            expr: (1 - node_filesystem_avail_bytes{fstype!~"tmpfs|overlay"} / node_filesystem_size_bytes{fstype!~"tmpfs|overlay"}) * 100 > 90
            for: 5m
            labels:
              severity: critical
            annotations:
              summary: "Node disk space critical (>90%)"
              description: "Node {{ $labels.instance }} disk usage is {{ printf \"%.1f\" $value }}%. Immediate action required!"

          # Pod Resources
          - alert: PodCrashLooping
            expr: rate(kube_pod_container_status_restarts_total[15m]) > 0
            for: 5m
            labels:
              severity: warning
            annotations:
              summary: "Pod crash looping"
              description: "Pod {{ $labels.namespace }}/{{ $labels.pod }} is crash looping."

          - alert: PodNotReady
            # A pod that has Succeeded or Failed is not "not ready" — it is
            # DONE. Without this exclusion every completed CronJob pod in the
            # cluster fires: the first evaluation after kube-state-metrics
            # landed produced 342 PodNotReady alerts, of which 166 were
            # terminal-phase pods. That volume buries the real signal and is
            # how an alert stops being read, which is the same outcome as the
            # alert being dead — just arrived at from the other direction.
            expr: |
              kube_pod_status_ready{condition="true"} == 0
              unless on(namespace, pod)
              kube_pod_status_phase{phase=~"Succeeded|Failed"} == 1
            for: 5m
            labels:
              severity: warning
            annotations:
              summary: "Pod not ready"
              description: "Pod {{ $labels.namespace }}/{{ $labels.pod }} is not ready."

      - name: roundhouse-builds
        interval: 30s
        rules:
          # Build Queue Health
          - alert: RoundhouseBuildQueueBacklog
            expr: roundhouse_build_queue_depth > 10
            for: 10m
            labels:
              severity: warning
              service: roundhouse
            annotations:
              summary: "Build queue backlog growing"
              description: "Build queue has {{ $value }} pending builds for more than 10 minutes."

          - alert: RoundhouseBuildQueueStalled
            expr: roundhouse_build_queue_depth > 0 and rate(roundhouse_builds_completed_total[15m]) == 0
            for: 15m
            labels:
              severity: critical
              service: roundhouse
            annotations:
              summary: "Build queue stalled"
              description: "Builds are queued but no builds have completed in 15 minutes."

          # Build Failures
          - alert: RoundhouseBuildFailureRate
            expr: sum(rate(roundhouse_builds_failed_total[30m])) / sum(rate(roundhouse_builds_total[30m])) > 0.2
            for: 10m
            labels:
              severity: warning
              service: roundhouse
            annotations:
              summary: "High build failure rate"
              description: "Build failure rate is above 20% for the last 10 minutes."

          - alert: RoundhouseBuildFailureRateCritical
            expr: sum(rate(roundhouse_builds_failed_total[30m])) / sum(rate(roundhouse_builds_total[30m])) > 0.5
            for: 5m
            labels:
              severity: critical
              service: roundhouse
            annotations:
              summary: "Critical build failure rate"
              description: "Build failure rate is above 50% - immediate attention required."

          # Build Duration
          - alert: RoundhouseBuildSlow
            expr: histogram_quantile(0.95, rate(roundhouse_build_duration_seconds_bucket[1h])) > 600
            for: 30m
            labels:
              severity: warning
              service: roundhouse
            annotations:
              summary: "Builds running slow"
              description: "95th percentile build duration is above 10 minutes."

          # Worker Health
          - alert: RoundhouseWorkerDown
            expr: up{job="roundhouse"} == 0
            for: 2m
            labels:
              severity: critical
              service: roundhouse
            annotations:
              summary: "Roundhouse worker is down"
              description: "Roundhouse build worker has been down for more than 2 minutes."

          - alert: RoundhouseWorkerHighMemory
            expr: container_memory_working_set_bytes{namespace="enclii",container="roundhouse"} / container_spec_memory_limit_bytes{namespace="enclii",container="roundhouse"} > 0.85
            for: 10m
            labels:
              severity: warning
              service: roundhouse
            annotations:
              summary: "Roundhouse worker high memory usage"
              description: "Roundhouse worker is using more than 85% of its memory limit."

      - name: argocd-gitops
        interval: 30s
        rules:
          # Application Sync Status
          - alert: ArgoCDAppOutOfSync
            expr: argocd_app_info{sync_status!="Synced"} == 1
            for: 15m
            labels:
              severity: warning
              service: argocd
            annotations:
              summary: "ArgoCD application out of sync"
              description: "Application {{ $labels.name }} has been out of sync for more than 15 minutes."

          - alert: ArgoCDAppDegraded
            expr: argocd_app_info{health_status="Degraded"} == 1
            for: 5m
            labels:
              severity: critical
              service: argocd
            annotations:
              summary: "ArgoCD application degraded"
              description: "Application {{ $labels.name }} health status is Degraded."

          - alert: ArgoCDAppMissing
            expr: argocd_app_info{health_status="Missing"} == 1
            for: 5m
            labels:
              severity: critical
              service: argocd
            annotations:
              summary: "ArgoCD application missing"
              description: "Application {{ $labels.name }} health status is Missing."

          # Sync Failures
          - alert: ArgoCDSyncFailed
            expr: increase(argocd_app_sync_total{phase="Failed"}[1h]) > 3
            for: 5m
            labels:
              severity: warning
              service: argocd
            annotations:
              summary: "ArgoCD sync failures"
              description: "Application {{ $labels.name }} has failed to sync more than 3 times in the last hour."

          # Controller Health
          - alert: ArgoCDControllerDown
            expr: up{job="argocd",service="argocd-application-controller"} == 0
            for: 2m
            labels:
              severity: critical
              service: argocd
            annotations:
              summary: "ArgoCD application controller is down"
              description: "ArgoCD application controller has been down for more than 2 minutes."

      - name: kyverno-policies
        interval: 30s
        rules:
          # Policy Violations
          - alert: KyvernoPolicyViolations
            expr: increase(kyverno_policy_results_total{rule_result="fail"}[1h]) > 10
            for: 10m
            labels:
              severity: warning
              service: kyverno
            annotations:
              summary: "Kyverno policy violations detected"
              description: "Policy {{ $labels.policy_name }} has been violated more than 10 times in the last hour."

          - alert: KyvernoAdmissionBlocked
            expr: increase(kyverno_admission_requests_total{request_allowed="false"}[30m]) > 5
            for: 5m
            labels:
              severity: warning
              service: kyverno
            annotations:
              summary: "Kyverno blocking admissions"
              description: "Kyverno has blocked more than 5 admission requests in the last 30 minutes."

          # Controller Health
          - alert: KyvernoControllerDown
            expr: up{job="kyverno"} == 0
            for: 2m
            labels:
              severity: critical
              service: kyverno
            annotations:
              summary: "Kyverno controller is down"
              description: "Kyverno admission controller has been down for more than 2 minutes."

      - name: deployment-health
        interval: 30s
        rules:
          # Deployment Rollout
          - alert: DeploymentRolloutStuck
            expr: kube_deployment_status_condition{condition="Progressing",status="false"} == 1
            for: 10m
            labels:
              severity: warning
            annotations:
              summary: "Deployment rollout stuck"
              description: "Deployment {{ $labels.namespace }}/{{ $labels.deployment }} rollout is stuck."

          - alert: DeploymentReplicasMismatch
            expr: kube_deployment_spec_replicas != kube_deployment_status_available_replicas
            for: 10m
            labels:
              severity: warning
            annotations:
              summary: "Deployment replicas mismatch"
              description: "Deployment {{ $labels.namespace }}/{{ $labels.deployment }} does not have the expected number of replicas."

          # StatefulSet Health
          - alert: StatefulSetReplicasMismatch
            expr: kube_statefulset_status_replicas != kube_statefulset_status_replicas_ready
            for: 10m
            labels:
              severity: warning
            annotations:
              summary: "StatefulSet replicas not ready"
              description: "StatefulSet {{ $labels.namespace }}/{{ $labels.statefulset }} replicas are not ready."

      - name: cronjob-health
        interval: 60s
        rules:
          # CronJob Failures
          - alert: CronJobFailed
            expr: kube_job_status_failed{namespace=~"enclii|monitoring|data"} > 0
            for: 5m
            labels:
              severity: warning
            annotations:
              summary: "CronJob failed"
              description: "Job {{ $labels.namespace }}/{{ $labels.job_name }} has failed."

          - alert: BackupVerifyFailed
            expr: kube_job_status_failed{job_name=~"backup-verify.*"} > 0
            for: 1m
            labels:
              severity: critical
              service: backup
            annotations:
              summary: "Backup verification failed"
              description: "Backup verification job {{ $labels.job_name }} has failed. DR readiness at risk."

          - alert: PostgresBackupMissing
            expr: time() - max(kube_job_status_completion_time{job_name=~"postgres-backup.*"}) > 90000
            for: 5m
            labels:
              severity: critical
              service: postgres
            annotations:
              summary: "PostgreSQL backup missing"
              description: "No successful PostgreSQL backup job completed in the last 25 hours."

          - alert: K3sBackupMissing
            expr: time() - max(kube_job_status_completion_time{job_name=~"k3s-datastore-backup.*"}) > 90000
            for: 5m
            labels:
              severity: critical
              service: backup
            annotations:
              summary: "K3s datastore backup missing"
              description: "No successful k3s backup in 25 hours."

          - alert: GitHubBackupMissing
            expr: time() - max(kube_job_status_completion_time{job_name=~"github-repos-backup.*"}) > 90000
            for: 5m
            labels:
              severity: critical
              service: backup
            annotations:
              summary: "GitHub repository backup missing"
              description: "No successful GitHub repo backup in 25 hours."

          - alert: CloudflareBackupMissing
            expr: time() - max(kube_job_status_completion_time{job_name=~"cloudflare-config-backup.*"}) > 90000
            for: 5m
            labels:
              severity: warning
              service: backup
            annotations:
              summary: "Cloudflare config backup missing"
              description: "No successful Cloudflare config backup in 25 hours."

          - alert: BackupJobFailed
            expr: kube_job_status_failed{namespace="data", job_name=~"(k3s-datastore|github-repos|cloudflare-config|argocd-secrets)-backup.*"} > 0
            for: 0m
            labels:
              severity: critical
              service: backup
            annotations:
              summary: "Backup job {{ $labels.job_name }} failed"
              description: "Check logs: kubectl logs -n data job/{{ $labels.job_name }}"

          # HPA Scaling
          - alert: HPAMaxedOut
            expr: kube_horizontalpodautoscaler_status_current_replicas == kube_horizontalpodautoscaler_spec_max_replicas
            for: 30m
            labels:
              severity: warning
            annotations:
              summary: "HPA at maximum replicas"
              description: "HPA {{ $labels.namespace }}/{{ $labels.horizontalpodautoscaler }} has been at max replicas for 30 minutes."

  maintenance-alerts.yml: |
    groups:
      - name: maintenance-health
        interval: 60s
        rules:
          # CronJob failure detection
          - alert: MaintenanceCronJobFailed
            expr: kube_job_status_failed{namespace="enclii",job_name=~"node-maintenance.*"} > 0
            for: 10m
            labels:
              severity: warning
              service: maintenance
            annotations:
              summary: "Node maintenance job failed"
              description: "Job {{ $labels.job_name }} failed — disk cleanup not running."

          # Stale metrics = CronJob not running at all
          - alert: NodeMaintenanceStale
            expr: (time() - node_maintenance_last_run_timestamp_seconds) > 172800
            for: 10m
            labels:
              severity: warning
              service: maintenance
            annotations:
              summary: "Node maintenance hasn't run in 48h on {{ $labels.instance }}"
              description: "Last run was {{ $value | humanizeDuration }} ago. CronJob may be suspended or failing silently."

      - name: predictive-disk
        interval: 60s
        rules:
          - alert: NodeDiskWillFillIn7Days
            expr: predict_linear(node_filesystem_avail_bytes{mountpoint="/",fstype!~"tmpfs|overlay"}[7d], 86400 * 7) < 0
            for: 1h
            labels:
              severity: warning
              service: node
            annotations:
              summary: "Disk will be full within 7 days on {{ $labels.instance }}"
              description: "Linear projection of root filesystem shows exhaustion within 7 days. Current avail: {{ $value | humanize1024 }}B."

      - name: storage-health
        interval: 60s
        rules:
          - alert: LonghornOrphanedVolume
            expr: longhorn_volume_robustness{robustness="unknown"} == 1
            for: 24h
            labels:
              severity: warning
              service: longhorn
            annotations:
              summary: "Longhorn volume {{ $labels.volume }} detached >24h"
              description: "Volume may be orphaned. Check with: kubectl get volumes.longhorn.io -n longhorn-system"

          - alert: LonghornVolumedegraded
            expr: longhorn_volume_robustness{robustness="degraded"} == 1
            for: 30m
            labels:
              severity: warning
              service: longhorn
            annotations:
              summary: "Longhorn volume {{ $labels.volume }} is degraded"
              description: "Volume has fewer healthy replicas than expected for 30m."

  longhorn-filesystem-health.yml: |
    groups:
      - name: longhorn-filesystem-health
        interval: 60s
        rules:
          # Detect disk I/O saturation before EXT4 errors
          - alert: LonghornVolumeIOSaturation
            expr: rate(node_disk_io_time_weighted_seconds_total[5m]) > 0.95
            for: 10m
            labels:
              severity: warning
              service: longhorn
            annotations:
              summary: "Disk I/O saturation on {{ $labels.instance }} device {{ $labels.device }}"
              description: "I/O weighted time ratio is {{ $value | humanizePercentage }} for 10m. EXT4 corruption risk increases under sustained I/O pressure."

          # Heuristic: FS corruption causing pod crash loops in stateful namespaces
          - alert: PodWriteFailureCrashLoop
            expr: increase(kube_pod_container_status_restarts_total{namespace=~"data|enclii|monitoring"}[30m]) > 5 and on(namespace, pod) kube_pod_container_status_last_terminated_reason{reason="Error"}
            for: 5m
            labels:
              severity: critical
              service: longhorn
            annotations:
              summary: "Pod {{ $labels.namespace }}/{{ $labels.pod }} crash-looping with errors (possible FS corruption)"
              description: "{{ $value }} restarts in 30m with Error termination in a stateful namespace. Check volume health: kubectl get volumes.longhorn.io -n longhorn-system"

          # Volume capacity exhaustion
          - alert: LonghornVolumeNearFull
            expr: (longhorn_volume_actual_size_bytes / longhorn_volume_capacity_bytes) > 0.9
            for: 1h
            labels:
              severity: warning
              service: longhorn
            annotations:
              summary: "Longhorn volume {{ $labels.volume }} is {{ $value | humanizePercentage }} full"
              description: "Volume is above 90% capacity for 1h. Expand or clean up data to prevent write failures."

  chronic-restart-rules.yml: |
    # Chronic crash-loop detection across the entire MADFAM platform.
    # Existing PodWriteFailureCrashLoop catches 30m bursts; this group
    # catches long-tail accumulators that the audit (2026-05-04) flagged:
    # forj-api at 1999 restarts in 7 days, nuit-one-web at 1611 over
    # 5d16h, redis-ha sentinel at 403 over 16d. Those slipped because
    # no rule operated on a 24h+ window.
    groups:
      - name: chronic-restart
        interval: 1m
        rules:
          # 24-hour window — early signal that a service is degrading
          # before it shows up in the multi-day chronic counter.
          - alert: PodChronicRestart24h
            expr: |
              sum by (namespace, pod) (
                increase(kube_pod_container_status_restarts_total[24h])
              ) > 50
            for: 15m
            labels:
              severity: warning
              category: chronic-restart
              window: 24h
            annotations:
              summary: "{{ $labels.namespace }}/{{ $labels.pod }} restarted >50 times in 24h"
              description: "{{ $value }} restarts in 24h. Investigate via `kubectl logs -n {{ $labels.namespace }} {{ $labels.pod }} --previous` and triage before it becomes a multi-day chronic."
              runbook: "https://github.com/madfam-org/internal-devops/blob/main/runbooks/chronic-restart-triage.md"

          # 7-day window — explicit catch for the long-tail crash-loops
          # the audit found rotting in the cluster.
          - alert: PodChronicRestart7d
            expr: |
              sum by (namespace, pod) (
                increase(kube_pod_container_status_restarts_total[7d])
              ) > 200
            for: 30m
            labels:
              severity: critical
              category: chronic-restart
              window: 7d
            annotations:
              summary: "{{ $labels.namespace }}/{{ $labels.pod }} restarted >200 times in 7d"
              description: "{{ $value }} restarts over 7 days. Service is in chronic crash-loop. Either fix the root cause, scale to 0, or remove the deployment. Persistent crash-loops consume scheduler attention + alert noise + PVC slots."
              runbook: "https://github.com/madfam-org/internal-devops/blob/main/runbooks/chronic-restart-triage.md"

          # Pod has been Pending or ContainerCreating for too long.
          # Caught the sim4d-studio :latest 16d / 102K-failed-pull issue.
          - alert: PodStuckNotRunning
            expr: |
              kube_pod_status_phase{phase=~"Pending|Unknown"} == 1
              unless
              on(namespace, pod) kube_pod_status_ready{condition="true"} == 1
            for: 6h
            labels:
              severity: warning
              category: chronic-restart
            annotations:
              summary: "{{ $labels.namespace }}/{{ $labels.pod }} not Running for 6h+"
              description: "Pod has been in Pending/Unknown phase for over 6 hours. Common causes: image pull failure (check `kubectl describe pod` events), PVC unbindable, taint mismatch. The sim4d-studio :latest tag missing-from-registry incident (102,575 failed pulls over 16 days) would have fired here."
              runbook: "https://github.com/madfam-org/internal-devops/blob/main/runbooks/chronic-restart-triage.md"

  # =========================================================================
  # SLO-selector fix (availability remediation Tier 0.3, 2026-08-26).
  #
  # The selector below was `namespace=~"tenant-.*"` until this fix. No code
  # has ever created a `tenant-*` namespace (see internal-devops audit #3),
  # so every rule in this group was inert from the day it was written — a
  # live rule with a dead selector is a different flavor of the same "green
  # lie" as a rule that never loads at all. The corrected enumerated-namespace
  # selector was already written and committed, correctly, in the dead
  # PrometheusRule copy at prometheus-client-slo-rules.yaml (enclii #416
  # follow-up) — but because that object is a PrometheusRule CRD with no
  # operator to reconcile it, the fix never reached the running evaluator.
  # Ported here verbatim from that CRD's spec.
  #
  # Keep this selector in sync with any future client-namespace scheme
  # change. When a new client onboards under a bare namespace, add it here.
  # =========================================================================
  client-slo-rules.yml: |
    groups:
      - name: client-slo
        interval: 30s
        rules:
          - alert: ClientServiceErrorRate
            expr: |
              (
                sum by (namespace) (rate(http_requests_total{code=~"5..", namespace=~"enclii-.*|project-.*|nauta|janua|karafiel|coupler|dhanam|tezca|pravara-mes|primavera3d|fortuna|forgesight|selva"}[5m]))
                /
                sum by (namespace) (rate(http_requests_total{namespace=~"enclii-.*|project-.*|nauta|janua|karafiel|coupler|dhanam|tezca|pravara-mes|primavera3d|fortuna|forgesight|selva"}[5m]))
              ) > 0.01
            for: 5m
            labels:
              severity: warning
              category: client-slo
            annotations:
              summary: "High error rate in client namespace {{ $labels.namespace }}"
              description: "Error rate {{ $value | humanizePercentage }} exceeds 1% threshold for 5m."

          - alert: ClientServiceLatencyP95
            expr: |
              histogram_quantile(0.95,
                sum by (namespace, le) (rate(http_request_duration_seconds_bucket{namespace=~"enclii-.*|project-.*|nauta|janua|karafiel|coupler|dhanam|tezca|pravara-mes|primavera3d|fortuna|forgesight|selva"}[5m]))
              ) > 2
            for: 5m
            labels:
              severity: warning
              category: client-slo
            annotations:
              summary: "High P95 latency in client namespace {{ $labels.namespace }}"
              description: "P95 latency {{ $value | humanizeDuration }} exceeds 2s threshold."

          - alert: ClientPodRestartRate
            expr: |
              sum by (namespace) (
                increase(kube_pod_container_status_restarts_total{namespace=~"enclii-.*|project-.*|nauta|janua|karafiel|coupler|dhanam|tezca|pravara-mes|primavera3d|fortuna|forgesight|selva"}[1h])
              ) > 3
            for: 5m
            labels:
              severity: warning
              category: client-slo
            annotations:
              summary: "Excessive pod restarts in {{ $labels.namespace }}"
              description: "{{ $value }} restarts in the last hour (threshold: 3)."

          - alert: ClientDeploymentUnavailable
            expr: |
              kube_deployment_status_replicas_available{namespace=~"enclii-.*|project-.*|nauta|janua|karafiel|coupler|dhanam|tezca|pravara-mes|primavera3d|fortuna|forgesight|selva"}
              <
              kube_deployment_spec_replicas{namespace=~"enclii-.*|project-.*|nauta|janua|karafiel|coupler|dhanam|tezca|pravara-mes|primavera3d|fortuna|forgesight|selva"}
            for: 5m
            labels:
              severity: critical
              category: client-slo
            annotations:
              summary: "Deployment {{ $labels.deployment }} unavailable in {{ $labels.namespace }}"
              description: "Available replicas ({{ $value }}) < desired for 5m."

          - alert: TenantResourceQuotaNearLimit
            expr: |
              (
                kube_resourcequota{type="used", namespace=~"enclii-.*|project-.*|nauta|janua|karafiel|coupler|dhanam|tezca|pravara-mes|primavera3d|fortuna|forgesight|selva"}
                /
                kube_resourcequota{type="hard", namespace=~"enclii-.*|project-.*|nauta|janua|karafiel|coupler|dhanam|tezca|pravara-mes|primavera3d|fortuna|forgesight|selva"}
              ) > 0.9
            for: 5m
            labels:
              severity: warning
              category: client-slo
            annotations:
              summary: "Quota {{ $labels.resource }} near limit in {{ $labels.namespace }}"
              description: "Usage at {{ $value | humanizePercentage }} of quota."

  # =========================================================================
  # Secret integrity + probe-target correctness (added 2026-08-06)
  # -------------------------------------------------------------------------
  # These rules live HERE, in the ConfigMap, and not in a PrometheusRule CR,
  # because this cluster has no prometheus-operator: `monitoring/prometheus`
  # is a plain Deployment started with `rule_files: /etc/prometheus/rules/
  # *.yml`, which is this ConfigMap. Verified 2026-08-06 against the running
  # Prometheus: /api/v1/rules lists 18 groups, every one of them from
  # /etc/prometheus/rules/*.yml, and none from any PrometheusRule object.
  #
  # NOTE: adding a key here does not reload Prometheus by itself. The kubelet
  # propagates the ConfigMap to the pod within ~60s, then Prometheus must be
  # told to re-read: `curl -X POST http://prometheus.monitoring:9090/-/reload`
  # (--web.enable-lifecycle is on) or restart the pod.
  # =========================================================================
  secret-integrity-rules.yml: |
    groups:
      - name: secret-key-count
        interval: 30s
        rules:
          # THE 2026-06-13 / 2026-08-06 CONTROL.
          # dhanam-secrets is written by three ExternalSecrets. While one of
          # them used a non-Merge creationPolicy, the target Secret cycled
          # 23 -> 2 -> 10 -> 23 keys every 15m, and any pod starting inside
          # that window came up with no DATABASE_URL and CrashLooped.
          #
          # This deliberately does NOT look at
          # ExternalSecret.status.conditions[Ready]: every writer reported
          # Ready=True for the entire incident. It counts keys on the Secret
          # itself, via the secret-key-count-exporter.
          - alert: SecretKeyCountBelowExpected
            expr: |
              secret_key_count
                < on(secret_namespace, secret_name)
              secret_key_count_min_expected
            for: 1m
            labels:
              severity: critical
              category: platform
            annotations:
              summary: "Secret {{ $labels.secret_namespace }}/{{ $labels.secret_name }} lost keys ({{ $value }} present)"
              description: |
                {{ $labels.secret_namespace }}/{{ $labels.secret_name }} is
                holding {{ $value }} keys, below the minimum this Secret is
                expected to carry. The usual cause is a multi-writer
                ExternalSecret target where at least one writer does NOT use
                creationPolicy: Merge — Owner and Orphan both reconcile the
                Secret down to just that writer's keys, wiping the others
                until they re-reconcile.

                Pods that start inside the window come up with missing env and
                CrashLoop. The ExternalSecrets will all still say Ready=True.

                Triage:
                  kubectl get externalsecret -n {{ $labels.secret_namespace }} \
                    -o custom-columns=NAME:.metadata.name,TARGET:.spec.target.name,POLICY:.spec.target.creationPolicy
                Every writer of this Secret must be Merge.
                Docs: docs/infrastructure/EXTERNAL_SECRETS.md

          # "Are we still looking?" Without this, deleting the target, losing
          # RBAC or the exporter dying reads exactly like a healthy Secret.
          - alert: DhanamSecretsKeyCountUnmonitored
            expr: |
              absent(secret_key_count{secret_namespace="dhanam",secret_name="dhanam-secrets"})
            for: 15m
            labels:
              severity: critical
              category: platform
            annotations:
              summary: "No key-count signal for dhanam/dhanam-secrets"
              description: |
                secret_key_count for dhanam/dhanam-secrets has been absent for
                15m, so the multi-writer wipe that broke production on
                2026-06-13 and again on 2026-08-06 is currently undetectable.
                Check the secret-key-count-exporter Deployment in the
                monitoring namespace and its scrape target.

          # A read failure must be visible as a read failure. The exporter
          # deliberately emits NO count when it cannot read, so a lost
          # RoleBinding would otherwise be silent.
          - alert: SecretKeyCountCheckFailing
            expr: |
              secret_key_count_check_success == 0
            for: 10m
            labels:
              severity: warning
              category: platform
            annotations:
              summary: "Cannot read {{ $labels.secret_namespace }}/{{ $labels.secret_name }} to count keys"
              description: |
                The secret-key-count-exporter has failed to read this Secret
                for 10m — usually a missing/removed RoleBinding, a renamed
                Secret, or an API problem. The key-count alert cannot fire
                while this is true.

      - name: cloudflared-probe-misconfigured
        interval: 30s
        rules:
          # THE 2026-08-06 FAULT 2 CONTROL.
          # The probe dialed dhanam-api:3000 and janua-api:8080 — ports those
          # Services do not publish. Dialing a nonexistent Service port times
          # out exactly like a CNI drop, so the probe blamed NetworkPolicy and
          # a real outage became indistinguishable from standing noise.
          - alert: CloudflaredProbeTargetMisconfigured
            expr: |
              cloudflared_probe_target_misconfigured == 1
            for: 5m
            labels:
              severity: warning
              category: platform
            annotations:
              summary: "Probe target {{ $labels.service }}:{{ $labels.port }} dials a port the Service does not publish"
              description: |
                The synthetic probe compared its target against the live
                Service and found reason={{ $labels.reason }}. This is a
                CONFIGURATION fault, not a network fault: fix the entry in the
                cloudflared-probe-targets ConfigMap (or publish the port on
                the Service in its own repo). Until then this target's
                reachability signal is meaningless.

                Note: the target's own namespace is in the `exported_namespace`
                label — `namespace` here is the probe's own namespace, which
                the scrape overwrites.

          # If the cross-check cannot run, "no misconfigured targets" means
          # "never looked". Make that state visible rather than reassuring.
          - alert: CloudflaredProbeServiceCheckUnavailable
            expr: |
              cloudflared_probe_service_check_unavailable == 1
            for: 30m
            labels:
              severity: warning
              category: platform
            annotations:
              summary: "cloudflared-probe cannot verify Service ports"
              description: |
                The probe could not read target Services from the Kubernetes
                API for 30m (missing ClusterRole/ServiceAccount, API
                unreachable, or SERVICE_PORT_CHECK disabled). While this is 1,
                a target dialing an unpublished Service port is
                indistinguishable from a NetworkPolicy drop — the exact
                confusion of 2026-08-06.

  # =========================================================================
  # THE 2026-08-11 CONTROL — a rollout that never landed.
  #
  # avala-services failed its PreSync migrate hook on 2026-08-07T19:18:34Z,
  # Argo retried 5 times and gave up, and prod served two-commit-old pods for
  # four days. Nothing alerted, because every available signal was green:
  #
  #   - Argo health stayed `Healthy` — a failed sync leaves the PREVIOUS pods
  #     running, and those pods were fine.
  #   - Every HTTP surface returned 200, for the same reason.
  #   - `argo_main_parity_drift_sources` stayed 0, because Argo records
  #     `sync.revision` for a sync that FAILED, so revision parity held.
  #   - The repo's own post-deploy gate asserts live behaviour, not which
  #     commit is live, so old-but-working also reads as pass.
  #
  # The missing question was never "is prod healthy" or "is the revision
  # right" but "did the rollout actually land". `argo_main_rollout_ok`
  # answers it: revision parity AND Synced AND last operation not failed.
  #
  # These rules live HERE and not in the PrometheusRule in
  # deploy-pipeline-monitor.yaml: there is no prometheus-operator on this
  # cluster, so PrometheusRule objects are inert. Prometheus reads
  # rule_files: /etc/prometheus/rules/*.yml, which is this ConfigMap.
  #
  # After editing: kubelet propagates the ConfigMap within ~60s, then
  # `curl -X POST http://prometheus.monitoring:9090/-/reload`.
  # =========================================================================
  deploy-parity-alerts.yml: |
    groups:
      - name: argo-rollout-truth
        interval: 1m
        rules:
          - alert: ArgoMainRolloutNotLanded
            expr: |
              argo_main_rollout_failed_sources > 0
            for: 15m
            labels:
              severity: critical
              category: deploy-parity
            annotations:
              summary: "An ArgoCD app tracking main has not rolled out its target revision"
              description: |
                At least one Git-backed prod Argo source is not genuinely
                running GitHub main: either it is OutOfSync, or its last sync
                operation failed. Inspect `argo_main_rollout_ok` labels for the
                offending application/repo/path.

                Argo health and HTTP probes will BOTH look fine while this is
                firing — a failed sync leaves the previous pods serving. Do not
                dismiss this because the site is up.

                Triage:
                  kubectl -n argocd get application <app> \
                    -o jsonpath='{.status.sync.status}{" "}{.status.operationState.phase}{" "}{.status.operationState.message}'
              runbook: docs/runbooks/deploy-pipeline-monitor.md

          # Escalates the same condition on duration. 15m catches the incident;
          # this catches the "nobody looked at the ticket" tail — the actual
          # 2026-08-07 failure mode, where Argo's automated sync will not retry
          # a revision it already failed, so a stuck app stays stuck silently
          # until the next commit lands.
          - alert: ArgoMainRolloutStuckForTooLong
            expr: |
              max(argo_main_rollout_stuck_seconds) by (application, repo) > 7200
            for: 10m
            labels:
              severity: critical
              category: deploy-parity
            annotations:
              summary: "{{ $labels.application }} has had a failed sync for over 2h"
              description: |
                The last sync operation for {{ $labels.application }}
                ({{ $labels.repo }}) failed {{ $value | humanizeDuration }} ago
                and has not been retried successfully.

                Argo's automated sync does NOT retry a revision that already
                failed, so this will not clear on its own — it needs either a
                new commit on main or a manual sync.
              runbook: docs/runbooks/deploy-pipeline-monitor.md

          # The monitor emits rollout metrics only when it completes. Absence
          # must read as "not measured", never as "nothing wrong".
          - alert: ArgoRolloutTruthUnavailable
            expr: |
              absent(argo_main_rollout_failed_sources)
            for: 30m
            labels:
              severity: warning
              category: deploy-parity
            annotations:
              summary: "No rollout-truth signal from the argo-main-parity monitor"
              description: |
                `argo_main_rollout_failed_sources` has been absent for 30m, so
                a stuck rollout is currently undetectable. Check the
                argo-main-parity-monitor CronJob in the monitoring namespace
                and its Pushgateway target.
              runbook: docs/runbooks/deploy-pipeline-monitor.md

  # =========================================================================
  # Resurrected 2026-08-26 (availability remediation Tier 0.3) from the dead
  # PrometheusRule pgbackrest-health-rules.yaml (monitoring/pgbackrest-health).
  # That object existed in the cluster as a CRD but was never reconciled —
  # no prometheus-operator runs here, so only /etc/prometheus/rules/*.yml
  # (this ConfigMap) is ever loaded. See the doctrine note above
  # secret-integrity-rules.yml for the verified 2026-08-06 rule-count check.
  #
  # PgBackRestRestoreDrillOverdue duplicated PostgresBackupCheckFailed from
  # the also-dead wal-archive-rules/postgres-wal-archive.yaml at
  # warning severity with a weaker expr (no `absent()` guard) — skipped in
  # favor of the critical-severity, absent-guarded version here
  # (PgBackRestCheckUnhealthy behaves like PostgresBackupCheckFailed but is
  # correct on total absence, not just staleness).
  # =========================================================================
  pgbackrest-health-rules.yml: |
    groups:
      - name: pgbackrest-operational-health
        interval: 60s
        rules:
          - alert: PgBackRestCheckUnhealthy
            expr: |
              (pgbackrest_check_healthy{stanza="main"} == 0)
              or
              (
                absent(pgbackrest_check_last_run_timestamp_seconds{stanza="main"})
                or
                (time() - pgbackrest_check_last_run_timestamp_seconds{stanza="main"} > 2700)
              )
            for: 5m
            labels:
              severity: critical
              category: platform
              component: pgbackrest
            annotations:
              summary: "pgBackRest backup health check is unhealthy or stale"
              description: |
                pgbackrest_check_healthy{stanza="main"} is 0 OR the check CronJob
                has not run in >45 minutes. This means the backup repo may be
                unreachable, the stanza may be corrupt, or credentials rotated
                without updating the backup pod.

                Immediate steps:
                  1. kubectl -n data get jobs -l app=pgbackrest-check --sort-by=.metadata.creationTimestamp | tail -5
                  2. kubectl -n data logs job/<latest-check-job>
                  3. kubectl -n data exec deploy/postgres -c pgbackrest -- pgbackrest check --stanza=main
                Runbook: docs/runbooks/POSTGRES_WAL_ARCHIVING.md#check-failures

          # NOTE: the source CRD's expr referenced
          # pgbackrest_restore_drill_last_success_timestamp_seconds, a metric
          # name that CronJob never emitted (it writes
          # pgbackrest_restore_drill_last_run_timestamp_seconds — see
          # infra/k8s/platform-infra/postgres-pgbackrest-restore-drill.yaml).
          # That mismatch meant this rule would never have fired even if the
          # operator had reconciled it. Fixed to the real metric name here.
          - alert: PgBackRestRestoreDrillOverdue
            expr: |
              (
                absent(pgbackrest_restore_drill_last_run_timestamp_seconds{stanza="main"})
                or
                (time() - pgbackrest_restore_drill_last_run_timestamp_seconds{stanza="main"} > 3024000)
              )
            for: 15m
            labels:
              severity: warning
              category: platform
              component: pgbackrest
            annotations:
              summary: "pgBackRest restore drill is overdue (>35 days)"
              description: |
                No successful restore drill recorded in the past 35 days.
                Without a successful restore drill, the backup cannot be
                considered verified for DR purposes.

                Trigger a drill manually:
                  kubectl -n data create job --from=cronjob/pgbackrest-restore-drill \
                    drill-$(date +%Y%m%d)
                Then monitor: kubectl -n data logs job/drill-$(date +%Y%m%d) -f
                Runbook: docs/runbooks/disaster-recovery.md#restore-drill

          - alert: PgBackRestCronJobFailed
            expr: |
              kube_job_status_failed{
                namespace="data",
                job_name=~"pgbackrest-(check|backup-full|backup-diff).*"
              } > 0
            for: 0m
            labels:
              severity: critical
              category: platform
              component: pgbackrest
            annotations:
              summary: "pgBackRest CronJob {{ $labels.job_name }} has failed"
              description: |
                The CronJob {{ $labels.job_name }} in namespace {{ $labels.namespace }}
                has failed (kube_job_status_failed > 0). This is a K8s-level
                failure (OOM, bad image, scheduling error) distinct from a
                successful run that found unhealthy state.

                Investigate:
                  kubectl -n data describe job {{ $labels.job_name }}
                  kubectl -n data logs job/{{ $labels.job_name }}
                Runbook: docs/runbooks/POSTGRES_WAL_ARCHIVING.md#check-failures

  # =========================================================================
  # Resurrected 2026-08-26 (availability remediation Tier 0.3) from the dead
  # PrometheusRule wal-archive-rules/postgres-wal-archive.yaml
  # (monitoring/postgres-wal-archive). Same dead-CRD story as above.
  #
  # PostgresBackupCheckFailed from the source file is skipped here: it
  # duplicates PgBackRestCheckUnhealthy above (same pgbackrest_check_healthy
  # condition) at a weaker, non-absent-guarded warning severity.
  # =========================================================================
  postgres-wal-archive-rules.yml: |
    groups:
      - name: postgres-wal-archive
        interval: 30s
        rules:
          - alert: PostgresWALArchiveBehind
            expr: |
              (
                pg_stat_archiver_failed_count - pg_stat_archiver_failed_count offset 5m > 0
              )
              and
              (
                (pg_stat_archiver_last_archive_age_seconds > 300)
                or
                (pg_stat_archiver_last_archive_age_seconds == 0)
              )
            for: 5m
            labels:
              severity: critical
              category: platform
              component: postgres-wal-archive
            annotations:
              summary: "Postgres WAL archiver is behind or failing"
              description: |
                pg_stat_archiver shows failed_count incrementing AND no successful
                archive in >5min. RPO is at risk. Check pgbackrest sidecar logs:
                  kubectl -n data logs deploy/postgres -c pgbackrest --tail=100
                Runbook: docs/runbooks/POSTGRES_WAL_ARCHIVING.md#failure-modes

          - alert: PostgresWALLagHigh
            expr: pg_stat_archiver_last_archive_age_seconds > 300
            for: 2m
            labels:
              severity: warning
              category: platform
              component: postgres-wal-archive
            annotations:
              summary: "Postgres WAL archive lag > 5 minutes"
              description: |
                Most recent WAL archive is {{ $value | humanizeDuration }} old.
                RPO target is 5 minutes. This is a warning — if it persists and
                the archiver is failing (see failed_count), PostgresWALArchiveBehind
                will page.
                Runbook: docs/runbooks/POSTGRES_WAL_ARCHIVING.md#wal-lag

          - alert: PostgresWALSpoolDiskHigh
            expr: |
              kubelet_volume_stats_used_bytes{namespace="data",persistentvolumeclaim="pgbackrest-spool-pvc"}
              /
              kubelet_volume_stats_capacity_bytes{namespace="data",persistentvolumeclaim="pgbackrest-spool-pvc"}
              > 0.80
            for: 5m
            labels:
              severity: warning
              category: platform
              component: postgres-wal-archive
            annotations:
              summary: "pgBackRest spool PVC over 80%"
              description: |
                Spool usage is {{ $value | humanizePercentage }} of 20Gi. If R2
                is unreachable, this PVC will fill and archive_command will
                start failing. Investigate R2 reachability first, then consider
                an emergency resize.
                Runbook: docs/runbooks/POSTGRES_WAL_ARCHIVING.md#spool-pressure

          - alert: PostgresBackupJobsStale
            expr: |
              time() - max(kube_job_status_completion_time{namespace="data",job_name=~"pgbackrest-backup-.*"}) > 129600
            for: 15m
            labels:
              severity: warning
              category: platform
              component: postgres-wal-archive
            annotations:
              summary: "No successful pgBackRest full/diff backup in >36h"
              description: |
                Last successful pgbackrest-backup-{{full|diff}} Job completion is
                over 36 hours ago. Expected cadence: full weekly, diff daily.
                Runbook: docs/runbooks/POSTGRES_WAL_ARCHIVING.md#backup-cadence

  # =========================================================================
  # Resurrected 2026-08-26 (availability remediation Tier 0.3). Two sources:
  #
  #   CloudflaredTunnelDown ported from the dead
  #   prometheus-platform-rules.yaml (PrometheusRule platform-infrastructure-
  #   rules). This is the "Cloudflare tunnel monitoring" the audit flagged —
  #   the live cloudflared-probe-misconfigured group above only detects
  #   misconfigured probe TARGETS, not the tunnel itself being unreachable.
  #
  #   CloudflaredProbeBackendUnreachable / CloudflaredProbeNotRunning ported
  #   from the dead infra/k8s/production/cloudflared-probe.yaml
  #   PrometheusRule (cloudflared-probe-rules) — that file's own header
  #   comment already documented it as unloaded (verified 2026-08-06) and
  #   pointed here as the fix. Distinct alert names from the misconfigured-
  #   target group above: these fire on the probe finding the backend
  #   actually unreachable, not on the probe's target list being wrong.
  # =========================================================================
  cloudflared-tunnel-rules.yml: |
    groups:
      - name: cloudflared
        interval: 30s
        rules:
          - alert: CloudflaredTunnelDown
            expr: |
              absent(up{job="cloudflared"}) or up{job="cloudflared"} == 0
            for: 2m
            labels:
              severity: critical
              category: platform
            annotations:
              summary: "Cloudflare tunnel is down"
              description: "All cloudflared instances are unreachable for more than 2 minutes. External traffic cannot reach the cluster."

      - name: cloudflared-probe
        interval: 30s
        rules:
          - alert: CloudflaredProbeBackendUnreachable
            expr: |
              cloudflared_probe_reachable_total == 0
            for: 2m
            labels:
              severity: critical
              category: platform
            annotations:
              summary: "cloudflared cannot reach {{ $labels.namespace }}/{{ $labels.service }}:{{ $labels.port }}"
              description: |
                In-cluster synthetic probe in the cloudflare-tunnel namespace
                failed to reach {{ $labels.namespace }}/{{ $labels.service }}:{{ $labels.port }}
                for >2m. Because the probe pod mirrors cloudflared's labels,
                cloudflared itself cannot reach this Service either. Likely
                cause: NetworkPolicy denies cloudflare-tunnel egress to that
                namespace, the Service has no endpoints, or the underlying
                pod is failing health checks.
                Runbook: docs/runbooks/cloudflared-probe.md

          - alert: CloudflaredProbeNotRunning
            expr: |
              absent(cloudflared_probe_runs_total) or rate(cloudflared_probe_runs_total[5m]) == 0
            for: 5m
            labels:
              severity: warning
              category: platform
            annotations:
              summary: "cloudflared-probe is not emitting metrics"
              description: |
                No probe iterations recorded in the last 5 minutes. The probe
                itself may be crashlooping or unscheduled. Without it we lose
                visibility into in-cluster cloudflared reachability.

  # =========================================================================
  # Resurrected 2026-08-26 (availability remediation Tier 0.3) from the dead
  # infra/k8s/production/synthetic-flow-probe.yaml PrometheusRule
  # (synthetic-flow-probe-rules). Not referenced by any kustomization and
  # never reconciled by an operator — same dead-on-arrival story.
  # =========================================================================
  synthetic-flow-probe-rules.yml: |
    groups:
      - name: synthetic-flow-probe
        interval: 30s
        rules:
          - alert: SyntheticJourneyConsecutivelyFailing
            expr: |
              synthetic_journey_consecutive_failures >= 3
            for: 1m
            labels:
              severity: critical
              category: synthetic-flow
            annotations:
              summary: "Synthetic journey {{ $labels.platform }}/{{ $labels.journey }} is broken"
              description: |
                The synthetic-flow-probe has reported {{ $value }} consecutive failures
                for the journey {{ $labels.platform }}/{{ $labels.journey }}.
                At the default 5-min schedule that's ~15+ minutes of broken user flow.

                Inspect the failing step:
                  kubectl -n cloudflare-tunnel logs deploy/synthetic-flow-probe --tail=100 | \
                    jq -c 'select(.event=="journey_failed" and .platform=="{{ $labels.platform }}")'

                Cross-correlate with cloudflared-probe: if `cloudflared_probe_reachable_total` for
                the same backend is 1 (Service reachable) but this journey is failing, the issue is
                application-layer (CSP, CORS, SSO callback, session, redirect). If the cloudflared
                probe is also 0 the issue is in-cluster network reachability — fix that first.

                Runbook: docs/runbooks/synthetic-flow-probe.md

          - alert: SyntheticJourneyStepLatencyRegression
            expr: |
              histogram_quantile(0.95,
                sum by (platform, journey, step, le) (
                  rate(synthetic_journey_step_latency_seconds_bucket[5m])
                )
              )
              >
              2 * histogram_quantile(0.95,
                sum by (platform, journey, step, le) (
                  rate(synthetic_journey_step_latency_seconds_bucket[1h] offset 5m)
                )
              )
            for: 10m
            labels:
              severity: warning
              category: synthetic-flow
            annotations:
              summary: "Synthetic journey step {{ $labels.platform }}/{{ $labels.journey }}/{{ $labels.step }} is >2x slower than baseline"
              description: |
                p95 latency for step `{{ $labels.step }}` in journey
                {{ $labels.platform }}/{{ $labels.journey }} has been more than 2x its prior 1h
                baseline for 10+ minutes. Likely cause: backend slowness, network congestion,
                or a recently-deployed change that added latency.

          - alert: SyntheticFlowProbeNotRunning
            expr: |
              absent(synthetic_journey_last_run_timestamp)
              or
              (time() - max by (platform, journey) (synthetic_journey_last_run_timestamp)) > 600
            for: 5m
            labels:
              severity: warning
              category: synthetic-flow
            annotations:
              summary: "synthetic-flow-probe is not emitting metrics"
              description: |
                No journey runs recorded in the last 10 minutes for at least one journey.
                The probe pod may be crashlooping, the ConfigMap may be malformed, or scrapes
                may be broken. Check:
                  kubectl -n cloudflare-tunnel get pod -l app=synthetic-flow-probe
                  kubectl -n cloudflare-tunnel logs deploy/synthetic-flow-probe --tail=50

  # =========================================================================
  # Resurrected 2026-08-26 (availability remediation Tier 0.3): the 5 of 8
  # "decoration" rules from deploy-pipeline-monitor.yaml's PrometheusRule
  # (deploy-pipeline-monitor-rules, group `deploy-pipeline-monitor`) whose
  # metrics are genuinely emitted by check_main_ci.py (confirmed against
  # infra/deploy-pipeline-monitor/check_main_ci.py and its tests) and have
  # no live equivalent.
  #
  # The other 3 rules in that PrometheusRule (group `argo-main-parity-
  # monitor`: ArgoMainParityDrift, ArgoMainParityMonitorFailed,
  # ArgoMainParityMonitorStale) are DELETED, not ported: their metrics
  # (argo_main_parity_drift_sources etc., from check_argo_main_parity.py)
  # are real, but deploy-parity-alerts.yml above already covers this exact
  # monitor with a redesigned, more accurate signal
  # (argo_main_rollout_ok/argo_main_rollout_failed_sources) — see that
  # key's own header comment for why the drift-sources approach missed the
  # 2026-08-07 avala-services incident. Porting the superseded metric
  # verbatim would double-alert on every real rollout failure.
  # =========================================================================
  deploy-pipeline-freshness-rules.yml: |
    groups:
      - name: deploy-pipeline-monitor
        interval: 1m
        rules:
          - alert: MainCIFailingForTooLong
            expr: repo_main_blocked_seconds > 1800
            for: 0m
            labels:
              severity: critical
              category: deploy-pipeline
            annotations:
              summary: "{{ $labels.repo }} main CI has been failing for >30 min"
              description: |
                Latest CI run on `{{ $labels.branch }}` of `{{ $labels.repo }}`
                is failed. The failing commit was pushed {{ $value | humanizeDuration }}
                ago — no image has been rebuilt → no deploys are reaching ArgoCD
                → live pods are drifting from `main`.
                Open the Actions tab on the repo, identify the failing run,
                fix or rerun it.
                Runbook: docs/runbooks/deploy-pipeline-monitor.md

          - alert: MainCommitsAccumulatingNotDeployed
            expr: |
              (repo_main_latest_commit_age_seconds
               - repo_main_latest_ci_age_seconds) > 1800
            for: 5m
            labels:
              severity: warning
              category: deploy-pipeline
            annotations:
              summary: "{{ $labels.repo }} main has unbuilt commits (>30 min)"
              description: |
                `{{ $labels.repo }}` main HEAD is {{ $value | humanizeDuration }}
                newer than the most recent completed CI run. Either CI is
                stalled, the workflow filter isn't matching, or the runner
                fleet is starved. ArgoCD will reconcile the *previous* image
                until this clears.

          - alert: MainCIConsecutiveFailures
            expr: repo_main_ci_failure_streak_count >= 3
            for: 15m
            labels:
              severity: warning
              category: deploy-pipeline
            annotations:
              summary: "{{ $labels.repo }} main CI: 3+ consecutive failures"
              description: |
                `{{ $labels.repo }}` has {{ $value }} consecutive non-success
                CI runs on `{{ $labels.branch }}`. Likely a real defect rather
                than a flake.

          - alert: DeployPipelineMonitorNotRunning
            expr: |
              time() - deploy_pipeline_monitor_last_run_timestamp_seconds > 900
              or absent(deploy_pipeline_monitor_last_run_timestamp_seconds)
            for: 5m
            labels:
              severity: warning
              category: deploy-pipeline
            annotations:
              summary: "deploy-pipeline-monitor has not pushed metrics in >15 min"
              description: |
                The CronJob is supposed to push every 5 min. Either it is not
                scheduling (check `kubectl -n monitoring get cronjob`), the
                GitHub token expired, or pushgateway is unreachable.

          - alert: DeployPipelineMonitorRepoProbeFailing
            expr: repo_main_probe_ok == 0
            for: 30m
            labels:
              severity: warning
              category: deploy-pipeline
            annotations:
              summary: "deploy-pipeline-monitor cannot probe {{ $labels.repo }}"
              description: |
                The monitor has been unable to fetch state from
                `{{ $labels.repo }}` for 30+ minutes. Likely causes: PAT scope
                missing the repo, repo renamed, or branch deleted. The monitor
                keeps running for the other repos.

  # =========================================================================
  # ARC pool health (added 2026-09-04)
  # -------------------------------------------------------------------------
  # These evaluate the gauges that infra/k8s/production/arc/pool-health-alert.yaml
  # pushes to the pushgateway every 5 minutes. They are NOT a replacement for
  # that detector's direct POST to Alertmanager — they are the half of the
  # problem the POST cannot solve, plus one deliberate redundancy:
  #
  #   ARCPoolHealthDetectorStale / Missing — the detector's own death. A
  #     CronJob that stops scheduling is silent in exactly the way a healthy
  #     fleet is silent. That is the shape of the 82-day-dead
  #     ARCNoRunnersAvailable rule and of the OOMKilled stuck-runner watchdog,
  #     and it is why the detector now emits a heartbeat at all.
  #
  #   ARCRunnersOutdatedGauge — the same fact ARCRunnersDeprecated pages on,
  #     reached by a different path (API read -> pushgateway -> scrape ->
  #     rule) instead of (API read -> POST -> Alertmanager). Deliberate
  #     double-paging on one condition, because on 2026-08-10 the alert that
  #     should have caught this was dead four independent ways at once and
  #     each one of them was individually sufficient. Two paths that fail
  #     differently beat one path that looks healthy.
  #
  # Pushgateway values are sticky: if the CronJob dies mid-outage, the last
  # gauge persists and ARCRunnersOutdatedGauge keeps firing. That is the
  # correct direction to be wrong in, and DetectorStale fires alongside it to
  # say the numbers are frozen.
  # =========================================================================
  arc-pool-health-rules.yml: |
    groups:
      - name: arc-pool-health
        interval: 1m
        rules:
          - alert: ARCPoolHealthDetectorStale
            expr: time() - arc_pool_health_last_run_timestamp_seconds > 1200
            for: 5m
            labels:
              severity: critical
              service: arc
              category: ci-capacity
            annotations:
              summary: "ARC pool-health detector has not run in >20 min"
              description: |
                The `arc-pool-health` CronJob in `monitoring` pushes a
                heartbeat every 5 minutes. It has not. Until it runs again the
                runner pool has NO detector: a total CI outage would look
                exactly like this does. Check the CronJob's last jobs and the
                CronJobFailed alert for the same namespace.
              runbook_url: "https://github.com/madfam-org/internal-devops/blob/main/runbooks/arc-runner-image-rebuild.md"

          - alert: ARCPoolHealthDetectorMissing
            expr: absent(arc_pool_health_last_run_timestamp_seconds)
            for: 30m
            labels:
              severity: warning
              service: arc
              category: ci-capacity
            annotations:
              summary: "ARC pool-health detector has never pushed a heartbeat"
              description: |
                No `arc_pool_health_last_run_timestamp_seconds` series exists
                at all. Either the CronJob has never run since this rule
                landed, its egress to the pushgateway is blocked, or the
                pushgateway lost its state. This is the "applied and healthy
                but never actually running" failure the detector itself was
                written to end.
              runbook_url: "https://github.com/madfam-org/internal-devops/blob/main/runbooks/arc-runner-image-rebuild.md"

          - alert: ARCRunnersOutdatedGauge
            expr: arc_pool_outdated_runners > 0
            for: 5m
            labels:
              severity: critical
              service: arc
              category: ci-capacity
            annotations:
              summary: "ARC runners are being rejected at registration (metrics path)"
              description: |
                {{ $value }} EphemeralRunner(s) are in phase=Outdated. GitHub
                is refusing the runner agent — typically the pinned
                actions/runner base has aged past the ~60-day deprecation
                window. Every private repo's CI will sit QUEUED until the base
                image is bumped AND the overlay digest is repinned in
                infra/k8s/production/arc/runner-blue/rendered.yaml.
                ARCRunnersDeprecated normally pages first; if only this one
                fired, the detector's direct POST to Alertmanager is broken
                and that is a second incident.
              runbook_url: "https://github.com/madfam-org/internal-devops/blob/main/runbooks/arc-runner-image-rebuild.md"
---
# Prometheus PVC
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: prometheus-data
  namespace: monitoring
  labels:
    app.kubernetes.io/name: prometheus
    app.kubernetes.io/component: monitoring
    app.kubernetes.io/part-of: enclii
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 20Gi
  storageClassName: longhorn
---
# Prometheus Deployment
apiVersion: apps/v1
kind: Deployment
metadata:
  name: prometheus
  namespace: monitoring
  labels:
    app.kubernetes.io/name: prometheus
    app.kubernetes.io/component: monitoring
    app.kubernetes.io/part-of: enclii
spec:
  replicas: 1
  strategy:
    type: Recreate  # Prevents PVC lock contention during rollouts
  selector:
    matchLabels:
      app: prometheus
  template:
    metadata:
      labels:
        app: prometheus
        app.kubernetes.io/name: prometheus
        app.kubernetes.io/component: monitoring
        app.kubernetes.io/part-of: enclii
    spec:
      serviceAccountName: prometheus
      securityContext:
        fsGroup: 65534
        runAsUser: 65534
        runAsNonRoot: true
      containers:
        - name: prometheus
          image: docker.io/prom/prometheus:v2.53.3@sha256:c62e2f333beae2fdac8c3c7a3daaa7ac81110023cbc5857b0ec541f09d997951
          securityContext:
            privileged: false
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: false
            capabilities:
              drop:
                - ALL
          args:
            - "--config.file=/etc/prometheus/prometheus.yml"
            - "--storage.tsdb.path=/prometheus"
            - "--storage.tsdb.retention.time=7d"
            - "--storage.tsdb.retention.size=8GB"
            - "--web.console.libraries=/usr/share/prometheus/console_libraries"
            - "--web.console.templates=/usr/share/prometheus/consoles"
            - "--web.enable-lifecycle"
          ports:
            - containerPort: 9090
              name: http
          resources:
            requests:
              memory: "768Mi"
              cpu: "200m"
            limits:
              memory: "2Gi"
              cpu: "500m"
          volumeMounts:
            - name: config
              mountPath: /etc/prometheus
            - name: rules
              mountPath: /etc/prometheus/rules
            - name: data
              mountPath: /prometheus
          startupProbe:
            httpGet:
              path: /-/ready
              port: 9090
            initialDelaySeconds: 15
            periodSeconds: 10
            failureThreshold: 30
            timeoutSeconds: 5
          readinessProbe:
            httpGet:
              path: /-/ready
              port: 9090
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /-/healthy
              port: 9090
            initialDelaySeconds: 30
            periodSeconds: 15
            timeoutSeconds: 5
            failureThreshold: 3
      volumes:
        - name: config
          configMap:
            name: prometheus-config
        - name: rules
          configMap:
            name: prometheus-rules
        - name: data
          persistentVolumeClaim:
            claimName: prometheus-data
---
# Prometheus Service
apiVersion: v1
kind: Service
metadata:
  name: prometheus
  namespace: monitoring
  labels:
    app.kubernetes.io/name: prometheus
    app.kubernetes.io/component: monitoring
    app.kubernetes.io/part-of: enclii
  annotations:
    prometheus.io/scrape: "true"
    prometheus.io/port: "9090"
spec:
  type: ClusterIP
  ports:
    - port: 9090
      targetPort: 9090
      name: http
  selector:
    app: prometheus
