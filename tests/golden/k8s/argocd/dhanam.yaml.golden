# Dhanam Finance Services Application
# Deploys: dhanam-admin, dhanam-api, dhanam-web (from external repo)
# Source: https://github.com/madfam-org/dhanam (external repo)
#
# NOTE: Dhanam CI currently deploys via SSH + kubectl set image.
# ArgoCD auto-sync DISABLED — old image tags (e.g. :89438293) are expired
# in GHCR, so any rollout creates pods that fail ImagePull.
# The running pods use node-cached images.
#
# Prerequisites for enabling auto-sync:
#   1. Run dhanam CI to push fresh :main tags to GHCR
#   2. Set imagePullPolicy: IfNotPresent (prevents re-pull of cached images)
#   3. Uncomment syncPolicy.automated below
#   4. Migrate CI to commit image refs to git (remove kubectl set image)
---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: dhanam-services
  namespace: argocd
  labels:
    app.kubernetes.io/name: dhanam-services
    app.kubernetes.io/part-of: dhanam
  annotations:
    # ArgoCD Image Updater — disabled until CI pushes images with consistent tags
    # Uncomment when dhanam CI standardizes on :main tag
    # argocd-image-updater.argoproj.io/image-list: |
    #   dhanam-api=ghcr.io/madfam-org/dhanam-api:main,
    #   dhanam-admin=ghcr.io/madfam-org/dhanam-admin:main
    # argocd-image-updater.argoproj.io/dhanam-api.update-strategy: digest
    # argocd-image-updater.argoproj.io/dhanam-admin.update-strategy: digest
    # argocd-image-updater.argoproj.io/git-repository: https://github.com/madfam-org/dhanam.git
    # argocd-image-updater.argoproj.io/write-back-method: "git:secret:argocd/git-creds"
    # argocd-image-updater.argoproj.io/write-back-target: kustomization
    # argocd-image-updater.argoproj.io/git-branch: main
    argocd.argoproj.io/compare-options: IgnoreExtraneous=true
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default

  source:
    repoURL: https://github.com/madfam-org/dhanam.git
    targetRevision: main
    path: infra/k8s/production
    directory:
      exclude: '{secrets-template.yaml,cloudflare-routes.yaml}'

  destination:
    server: https://kubernetes.default.svc
    namespace: dhanam

  syncPolicy:
    # Auto-sync DISABLED — see prerequisites in header comment
    # automated:
    #   prune: false
    #   selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - RespectIgnoreDifferences=true

  ignoreDifferences:
    # Ignore image field — CI currently sets images via kubectl, not git
    # Remove this once CI is migrated to commit image refs to git
    - group: apps
      kind: Deployment
      jsonPointers:
        - /spec/template/spec/containers/0/image
        - /spec/replicas
    - group: ""
      kind: Service
      jsonPointers:
        - /spec/clusterIP
