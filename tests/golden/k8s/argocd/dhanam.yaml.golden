# Dhanam Finance Services Application
# Deploys: dhanam-admin, dhanam-api, dhanam-web (from external repo)
# Source: https://github.com/madfam-org/dhanam (external repo)
#
# Images pushed as nested GHCR packages (auto-linked to repo):
#   - ghcr.io/madfam-org/dhanam/api:main  (API, NestJS)
#   - ghcr.io/madfam-org/dhanam/web:main  (Web, Next.js)
#
# CI deploys via kubectl set image with SHA digests.
# ArgoCD auto-sync enabled (selfHeal) for non-image drift correction.
# Image field excluded from diff — CI manages image versions.
---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: dhanam-services
  namespace: argocd
  labels:
    app.kubernetes.io/name: dhanam-services
    app.kubernetes.io/part-of: dhanam
  annotations:
    argocd.argoproj.io/compare-options: IgnoreExtraneous=true
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default

  source:
    repoURL: https://github.com/madfam-org/dhanam.git
    targetRevision: main
    path: infra/k8s/production
    directory:
      exclude: '{secrets-template.yaml,cloudflare-routes.yaml}'

  destination:
    server: https://kubernetes.default.svc
    namespace: dhanam

  syncPolicy:
    automated:
      prune: false
      selfHeal: true
    syncOptions:
      - CreateNamespace=true

  ignoreDifferences:
    # Ignore image field — CI sets images via kubectl set image with SHA digests
    - group: apps
      kind: Deployment
      jsonPointers:
        - /spec/template/spec/containers/0/image
        - /spec/replicas
    - group: ""
      kind: Service
      jsonPointers:
        - /spec/clusterIP
