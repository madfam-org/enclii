# GitHub Actions Runner Controller Applications
# Deploys: ARC controller + blue runner scale set.
#
# ArgoCD v3.2.5 cannot reliably compare the public ARC OCI Helm charts
# when values come from a second Git source, so the chart output is rendered
# into infra/k8s/production/arc/* and managed as ordinary Git manifests.
#
# To upgrade ARC charts:
#   helm template arc-controller oci://ghcr.io/actions/actions-runner-controller-charts/gha-runner-scale-set-controller \
#     --namespace arc-system --version <version> -f infra/helm/arc/values-controller.yaml \
#     > infra/k8s/production/arc/controller/rendered.yaml
#   helm template arc-runner-blue oci://ghcr.io/actions/actions-runner-controller-charts/gha-runner-scale-set \
#     --namespace arc-runners --version <version> \
#     -f infra/helm/arc/values-runner-set.yaml \
#     -f infra/helm/arc/values-runner-set-blue.yaml \
#     > infra/k8s/production/arc/runner-blue/rendered.yaml
---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: arc-runners
  namespace: argocd
  labels:
    app.kubernetes.io/name: arc-runners
    app.kubernetes.io/part-of: enclii
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default

  source:
    repoURL: https://github.com/madfam-org/enclii.git
    targetRevision: main
    path: infra/k8s/production/arc/controller

  destination:
    server: https://kubernetes.default.svc
    namespace: arc-system

  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true

  ignoreDifferences:
    - group: apps
      kind: Deployment
      jsonPointers:
        - /metadata/labels/app.kubernetes.io~1instance
        - /spec/template/metadata/labels/app.kubernetes.io~1instance
---
# ARC Runner Scale Set (Blue)
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: arc-runners-blue
  namespace: argocd
  labels:
    app.kubernetes.io/name: arc-runners-blue
    app.kubernetes.io/part-of: enclii
spec:
  project: default

  source:
    repoURL: https://github.com/madfam-org/enclii.git
    targetRevision: main
    path: infra/k8s/production/arc/runner-blue

  destination:
    server: https://kubernetes.default.svc
    namespace: arc-runners

  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true

  # ARC creates AutoscalingListener resources dynamically from the runner set.
  # They carry Argo tracking labels, so Argo sees them as extraneous even though
  # they are controller-owned runtime state.
  ignoreDifferences:
    - group: actions.github.com
      kind: AutoscalingListener
      jqPathExpressions:
        - .
