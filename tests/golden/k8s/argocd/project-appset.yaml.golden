# Project ApplicationSet — Auto-generates ArgoCD Applications from config.json files
# Adding a new project requires only a config.json in infra/argocd/projects/<name>/
# No manual Application YAML needed — the platform handles it automatically.
#
# Replaces: core-services.yaml, dhanam.yaml, janua.yaml, tezca.yaml, ecosystem-services.yaml
---
apiVersion: argoproj.io/v1alpha1
kind: ApplicationSet
metadata:
  name: project-applications
  namespace: argocd
  labels:
    app.kubernetes.io/name: project-applications
    app.kubernetes.io/part-of: enclii
    app.kubernetes.io/managed-by: enclii-platform
spec:
  goTemplate: true
  goTemplateOptions: ["missingkey=zero"]
  # Preserve existing Applications when ApplicationSet is deleted (safety net)
  preservedFields:
    annotations:
      - notifications.argoproj.io/subscribe.on-sync-succeeded.enclii
      - notifications.argoproj.io/subscribe.on-sync-failed.enclii
  generators:
    - git:
        repoURL: https://github.com/madfam-org/enclii.git
        revision: main
        files:
          - path: "infra/argocd/projects/*/config.json"
  template:
    metadata:
      name: '{{ .name }}-services'
      labels:
        app.kubernetes.io/name: '{{ .name }}-services'
        app.kubernetes.io/part-of: '{{ .partOf }}'
        app.kubernetes.io/managed-by: enclii-platform
      annotations:
        notifications.argoproj.io/subscribe.on-sync-succeeded.enclii: ""
        notifications.argoproj.io/subscribe.on-sync-failed.enclii: ""
        # Client-side diff ONLY -- keep ServerSideDiff out of this annotation.
        # Mirrors the runtime reconciler
        # (apps/switchyard-api/internal/argocd/application_reconciler.go):
        # SSD's server-side dry-run goes through admission, and Kyverno's
        # verify-image-signatures denies it on every CI digest bump of a
        # signature-verified Deployment -> ComparisonError wedges the whole
        # app. See docs/infrastructure/ARGOCD_KNOWN_ISSUES.md.
        argocd.argoproj.io/compare-options: IgnoreExtraneous=true
      finalizers:
        - resources-finalizer.argocd.argoproj.io
    spec:
      project: default
      source:
        repoURL: '{{ .repoURL }}'
        targetRevision: '{{ .branch }}'
        path: '{{ .manifestPath }}'
      destination:
        server: https://kubernetes.default.svc
        namespace: '{{ .namespace }}'
      syncPolicy:
        automated:
          prune: true
          selfHeal: true
        syncOptions:
          - CreateNamespace=true
          - RespectIgnoreDifferences=true
          # ServerSideApply uses field-manager-based merge instead of
          # client-side strategic merge. Required for Kyverno-managed
          # annotations like `kyverno.io/verify-images` which are
          # immutable post-mutation: client-side merge tries to PATCH
          # the annotation and gets blocked by Kyverno's mutate webhook
          # (`kyverno.io/verify-images annotation cannot be changed`).
          # Server-side apply respects field ownership so Kyverno keeps
          # the annotation while ArgoCD reconciles everything else.
          # Surfaced 2026-04-28 by dhanam-services sync failure.
          - ServerSideApply=true
      ignoreDifferences:
        # ArgoCD tracking label conflicts with kustomize commonLabels
        # Kyverno verify-images annotations (both deployment and pod template level)
        - group: apps
          kind: Deployment
          jsonPointers:
            - /spec/replicas
            - /spec/template/metadata/annotations/kubectl.kubernetes.io~1restartedAt
            - /metadata/annotations/kyverno.io~1verify-images
            - /spec/template/metadata/annotations/kyverno.io~1verify-images
            - /metadata/labels/app.kubernetes.io~1instance
        - group: apps
          kind: StatefulSet
          jsonPointers:
            - /spec/replicas
            - /spec/template/metadata/annotations/kubectl.kubernetes.io~1restartedAt
            - /metadata/annotations/kyverno.io~1verify-images
            - /spec/template/metadata/annotations/kyverno.io~1verify-images
            - /metadata/labels/app.kubernetes.io~1instance
          jqPathExpressions:
            - .spec.volumeClaimTemplates[]?.apiVersion
            - .spec.volumeClaimTemplates[]?.kind
            - .spec.volumeClaimTemplates[]?.metadata.creationTimestamp
            - .spec.volumeClaimTemplates[]?.status
        - group: ""
          kind: Service
          jsonPointers:
            - /spec/clusterIP
            - /metadata/labels/app.kubernetes.io~1instance
        - group: ""
          kind: ConfigMap
          jsonPointers:
            - /metadata/labels/app.kubernetes.io~1instance
          jqPathExpressions:
            # The status service catalog is runtime-owned by switchyard-api so
            # zero-touch onboarding does not require Enclii repo edits.
            - 'select(.metadata.name == "status-config-enclii" or .metadata.name == "status-config-madfam") | .data["services-config"]'
        - group: policy
          kind: PodDisruptionBudget
          jsonPointers:
            - /metadata/labels/app.kubernetes.io~1instance
        - group: batch
          kind: CronJob
          jsonPointers:
            - /metadata/annotations
            - /metadata/labels/app.kubernetes.io~1instance
        - group: ""
          kind: Secret
          jsonPointers:
            - /data
            - /stringData
            # ESO writes the produced Secret (e.g. enclii-secrets, creationPolicy
            # Merge) with its own reconcile hash + the operator ops annotations,
            # and Argo injects its tracking label. None of these live in the git
            # stub, so without ignoring them the Secret sits permanently
            # OutOfSync (core-services Degraded). Mirrors the ExternalSecret-kind
            # ignores below, but on the produced Secret.
            - /metadata/labels/app.kubernetes.io~1instance
            - /metadata/annotations/reconcile.external-secrets.io~1data-hash
            - /metadata/annotations/force-sync
            - /metadata/annotations/enclii.dev~1secret-intake-id
            - /metadata/annotations/enclii.dev~1secret-intake-target
            - /metadata/annotations/enclii.dev~1last-ops-idempotency-key
            - /metadata/annotations/enclii.dev~1last-ops-operation
            - /metadata/annotations/enclii.dev~1last-ops-reason
            - /metadata/annotations/enclii.dev~1last-ops-requested
            - /metadata/annotations/enclii.dev~1refresh-requested-at
        - group: external-secrets.io
          kind: ExternalSecret
          jsonPointers:
            # Runtime ESO refreshes are operator actions, not desired-state
            # drift in client repositories.
            - /metadata/annotations/force-sync
            - /metadata/annotations/enclii.dev~1last-ops-idempotency-key
            - /metadata/annotations/enclii.dev~1last-ops-operation
            - /metadata/annotations/enclii.dev~1last-ops-reason
            - /metadata/annotations/enclii.dev~1last-ops-requested
            - /metadata/annotations/enclii.dev~1refresh-requested-at
          # NOTE: there is deliberately NO jqPathExpressions block on this rule.
          #
          # It used to hide `.spec.data[]?.remoteRef.{conversionStrategy,
          # decodingStrategy,metadataPolicy}` (apiserver-applied ESO CRD
          # defaults). With RespectIgnoreDifferences=true, ArgoCD copies live
          # values at ignored paths into the desired object before applying;
          # ExternalSecret is a CRD, so that copy is an RFC 7386 merge patch in
          # which arrays are atomic -> the whole LIVE spec.data replaced the
          # desired one and every added entry was silently dropped while the
          # sync reported "serverside-applied / Succeeded".
          # See docs/infrastructure/ARGOCD_KNOWN_ISSUES.md,
          # "ExternalSecret `spec.data` Changes Never Applied".
          #
          # The defaulting noise is handled by spelling the three defaults out
          # in the ExternalSecret manifests in git, NOT by ServerSideDiff (its
          # admission dry-run is denied by Kyverno on signature-verified
          # Deployments -- same doc, "Server-Side Diff Denied by Kyverno").
          # The jsonPointers above are safe: they select map keys, not list
          # items. scripts/check-argocd-ignore-differences.py enforces this.
