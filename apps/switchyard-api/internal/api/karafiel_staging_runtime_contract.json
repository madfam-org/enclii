{
  "backend": {
    "karafiel-api": {
      "env": [
        {
          "name": "JANUA_AUDIENCE",
          "value": "karafiel-staging-api"
        },
        {
          "name": "JANUA_ADDITIONAL_AUDIENCES",
          "value": ""
        },
        {
          "name": "DJANGO_SECRET_KEY",
          "valueFrom": {
            "secretKeyRef": {
              "key": "DJANGO_SECRET_KEY",
              "name": "karafiel-secrets"
            }
          }
        },
        {
          "name": "ENCRYPTION_MASTER_KEY",
          "valueFrom": {
            "secretKeyRef": {
              "key": "ENCRYPTION_MASTER_KEY",
              "name": "karafiel-secrets"
            }
          }
        },
        {
          "name": "DB_HOST",
          "valueFrom": {
            "secretKeyRef": {
              "key": "DB_HOST",
              "name": "karafiel-staging-database-runtime"
            }
          }
        },
        {
          "name": "DB_PORT",
          "valueFrom": {
            "secretKeyRef": {
              "key": "DB_PORT",
              "name": "karafiel-staging-database-runtime"
            }
          }
        },
        {
          "name": "DB_NAME",
          "valueFrom": {
            "secretKeyRef": {
              "key": "DB_NAME",
              "name": "karafiel-staging-database-runtime"
            }
          }
        },
        {
          "name": "DB_USER",
          "valueFrom": {
            "secretKeyRef": {
              "key": "DB_USER",
              "name": "karafiel-staging-database-runtime"
            }
          }
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": {
            "secretKeyRef": {
              "key": "DB_PASSWORD",
              "name": "karafiel-staging-database-runtime"
            }
          }
        },
        {
          "name": "PGSSLMODE",
          "value": "verify-full"
        },
        {
          "name": "PGSSLROOTCERT",
          "value": "/var/run/karafiel-staging-db/ca.crt"
        },
        {
          "name": "BANK_ALLOCATION_LEDGER_ENABLED",
          "value": "false"
        },
        {
          "name": "DHANAM_SOURCE_CURRENTNESS_ENABLED",
          "value": "false"
        },
        {
          "name": "ENVIRONMENT",
          "value": "staging"
        },
        {
          "name": "SAT_ENVIRONMENT",
          "value": "staging"
        },
        {
          "name": "FEATURE_CFDI_AUTO_ISSUE",
          "value": "false"
        },
        {
          "name": "SENTRY_ENVIRONMENT",
          "value": "staging"
        },
        {
          "name": "FEATURE_GRANT_COMPLIANCE",
          "value": "false"
        },
        {
          "name": "POD_IP",
          "valueFrom": {
            "fieldRef": {
              "fieldPath": "status.podIP"
            }
          }
        },
        {
          "name": "ALLOWED_HOSTS",
          "value": "staging-api.karafiel.mx,karafiel-api,karafiel-api.enclii-karafiel-staging,karafiel-api.enclii-karafiel-staging.svc,karafiel-api.enclii-karafiel-staging.svc.cluster.local,localhost,127.0.0.1,$(POD_IP)"
        },
        {
          "name": "PROMETHEUS_MULTIPROC_DIR",
          "value": "/tmp/prometheus-multiproc"
        }
      ],
      "envFrom": [
        {
          "configMapRef": {
            "name": "karafiel-cfdi-config"
          }
        }
      ]
    },
