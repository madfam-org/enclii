# Site Configuration
SITE_NAME="Enclii Status"
SITE_URL="https://status.enclii.dev"
NEXT_PUBLIC_APP_URL="https://status.enclii.dev"

# Services to Monitor (JSON array)
# Each service: { name, url, group, description? }
SERVICES_CONFIG='[
  {"name": "Switchyard API", "url": "https://api.enclii.dev/health/ready", "group": "Enclii", "description": "Control plane API"},
  {"name": "Web Dashboard", "url": "https://app.enclii.dev", "group": "Enclii", "description": "User dashboard"},
  {"name": "Admin Console", "url": "https://admin.enclii.dev", "group": "Enclii", "description": "Infrastructure admin"},
  {"name": "Documentation", "url": "https://docs.enclii.dev", "group": "Enclii", "description": "Documentation site"}
]'

# Health Check Configuration
HEALTH_CHECK_TIMEOUT_MS=10000
HEALTH_CHECK_CACHE_TTL_SECONDS=30
HEALTH_CHECK_RETRIES=2
HEALTH_CHECK_RETRY_DELAY_MS=1000

# Response Time Thresholds (JSON) — calibrate for your deployment's latency profile
# Default: {"fast":200,"normal":500,"slow":1000}
# Cloudflare tunnel: {"fast":1500,"normal":2500,"slow":4000}
RESPONSE_TIME_THRESHOLDS='{"fast":200,"normal":500,"slow":1000}'

# Prometheus Integration (Phase 2)
PROMETHEUS_URL="http://prometheus.monitoring.svc.cluster.local:9090"

# Database for Incidents and Status History
DATABASE_URL="postgresql://localhost:5432/enclii_status"

# Cron Secret for Status History Recording
# Used by K8s CronJob to authenticate POST /api/status/record
CRON_SECRET=""

# Admin Secret for Incident Management API
# Used to authenticate POST/PATCH/DELETE /api/incidents
ADMIN_SECRET=""

# Auto-Incident Detection
# Automatically create incidents when services fail consecutively
AUTO_INCIDENTS_ENABLED=true
AUTO_INCIDENT_THRESHOLD=2

# Authentication for Admin (Phase 3)
JANUA_ISSUER_URL="https://auth.madfam.io"
JANUA_CLIENT_ID="status-admin"
