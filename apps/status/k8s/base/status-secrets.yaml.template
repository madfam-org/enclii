# Status Secrets Template
#
# Create this secret manually or via ExternalSecrets.
#
# Option A — fresh database URL:
#   kubectl create secret generic status-secrets -n enclii \
#     --from-literal=database-url='postgresql://user:pass@host:5432/enclii' \
#     --from-literal=cron-secret=$(openssl rand -hex 32)
#
# Option B — reuse the existing enclii database URL:
#   kubectl create secret generic status-secrets -n enclii \
#     --from-literal=database-url=$(kubectl get secret enclii-secrets -n enclii \
#       -o jsonpath='{.data.ENCLII_DATABASE_URL}' | base64 -d) \
#     --from-literal=cron-secret=$(openssl rand -hex 32)
#
apiVersion: v1
kind: Secret
metadata:
  name: status-secrets
  namespace: enclii
type: Opaque
stringData:
  database-url: "REPLACE_ME"
  cron-secret: "REPLACE_ME"
