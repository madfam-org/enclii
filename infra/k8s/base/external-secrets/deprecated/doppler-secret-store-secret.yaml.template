---
# Doppler Service Token Secret
# Copy this file, replace the token, and apply. DO NOT commit the actual secret.
#
# Generate token in Doppler dashboard:
#   Project → Config → Access → Service Tokens → Generate
#
# Apply:
#   kubectl apply -f doppler-secret-store-secret.yaml -n external-secrets
apiVersion: v1
kind: Secret
metadata:
  name: doppler-token-auth
  namespace: external-secrets
  labels:
    app.kubernetes.io/name: doppler-secret-store
    app.kubernetes.io/part-of: enclii
type: Opaque
stringData:
  doppler-token: "example-local-doppler-service-token"
