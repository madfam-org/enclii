---
# Redis Authentication Secret
# Copy this file to redis-secret.yaml and set the password before applying.
# DO NOT commit the actual secret to version control.
#
# Generate a strong password:
#   openssl rand -base64 32
#
# Apply:
#   kubectl apply -f redis-secret.yaml -n enclii
apiVersion: v1
kind: Secret
metadata:
  name: redis-auth
  namespace: enclii
  labels:
    app: redis
    app.kubernetes.io/name: redis
    app.kubernetes.io/component: cache
    app.kubernetes.io/part-of: enclii
type: Opaque
stringData:
  redis-password: "REPLACE_WITH_STRONG_PASSWORD"
