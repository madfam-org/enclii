# Production Environment Variables
# Production-specific overrides and additions
#
# Usage with Kustomize configMapGenerator:
#   configMapGenerator:
#     - name: production-env
#       envs:
#         - ../../../components/environment/common.env
#         - ../../../components/environment/production.env
#
# NOTE: Secrets are NOT in this file. Use secretKeyRef for:
#   - ENCLII_OIDC_CLIENT_ID
#   - ENCLII_OIDC_CLIENT_SECRET
#   - ENCLII_REGISTRY_USERNAME
#   - ENCLII_REGISTRY_PASSWORD
#   - ENCLII_GITHUB_WEBHOOK_SECRET
#   - ENCLII_CLOUDFLARE_API_TOKEN
#   - ENCLII_CLOUDFLARE_ACCOUNT_ID
#   - ENCLII_CLOUDFLARE_ZONE_ID
#   - ENCLII_CLOUDFLARE_TUNNEL_ID
#   - ENCLII_CLOUDFLARE_FALLBACK_ORIGIN_ZONE_ID   (Cloudflare for SaaS, optional)
#   - ENCLII_CLOUDFLARE_FALLBACK_ORIGIN_HOSTNAME  (Cloudflare for SaaS, optional)

# ==========================================
# ENVIRONMENT IDENTIFICATION
# ==========================================
ENCLII_ENV=production

# ==========================================
# LOGGING & DEBUGGING
# ==========================================
ENCLII_LOG_LEVEL=warn
ENCLII_ENABLE_PROFILING=false

# ==========================================
# PERFORMANCE TUNING (Production Scale)
# ==========================================
ENCLII_RATE_LIMIT_REQUESTS_PER_MINUTE=10000
ENCLII_DB_POOL_SIZE=50
ENCLII_CACHE_TTL_SECONDS=7200
ENCLII_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ==========================================
# INTERNAL SERVICES
# ==========================================
# NOTE: Redis uses ENCLII_REDIS_HOST/PORT (set in environment-patch.yaml)
# Do NOT use ENCLII_REDIS_URL - config reads HOST/PORT, not URL
ENCLII_ROUNDHOUSE_URL=http://roundhouse:80
ENCLII_SELF_URL=http://switchyard-api

# ==========================================
# EXTERNAL URLS (Production Domains)
# ==========================================
ENCLII_OIDC_REDIRECT_URL=https://api.enclii.dev/v1/auth/callback
ENCLII_POST_LOGIN_REDIRECT_URL=https://app.enclii.dev/auth/callback
NEXT_PUBLIC_API_URL=https://api.enclii.dev

# ==========================================
# ADMIN ACCESS
# ==========================================
ENCLII_ADMIN_EMAILS=admin@madfam.io

# ------------------------------------------------------------------
# ADR-003 TENANT SCOPE — STAGED ROLLOUT STATE (2026-09-05)
# ------------------------------------------------------------------
# The code default is ON (unset = enforce). This line deliberately
# overrides that default to OFF, and it is a ROLLOUT STAGE, not a
# setting: merging to main deploys immediately, so the enforcing build
# reaches production before anyone can run the pre-deploy report
# against it. Off is how production behaves exactly as it did before
# ADR-003 while that report is run.
#
#   stage 1 (now)  deploy with this false — behaviour unchanged
#   stage 2        operator runs GET /v1/admin/tenant-scope/dry-run,
#                  resolves every principal it reports losing reach,
#                  and sets ENCLII_PLATFORM_ADMIN_EMAILS below
#   stage 3        a one-line PR flips this to true
#
# Stage 3 is the point of the work. While this reads false, every
# tenant admin can reach every tenant — the defect ADR-003 records —
# so this is an open item, not a resting state. The API logs at ERROR
# on every boot while it is off.
#
# Procedure: docs/runbooks/TENANT_SCOPE_ENFORCEMENT_ROLLOUT.md
ENCLII_TENANT_SCOPE_ENFORCE=false

# The explicit operator allow-list that grants the cross-tenant
# platform rank. Set this in stage 2, from the dry-run report. Until
# it is set the API falls back to ENCLII_ADMIN_EMAILS above, so the
# reconcile still populates users.is_platform_admin and the report is
# meaningful at stage 1.
# ENCLII_PLATFORM_ADMIN_EMAILS=
