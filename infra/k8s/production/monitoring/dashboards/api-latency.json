      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(enclii_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(enclii_http_requests_total[5m])) * 100",
