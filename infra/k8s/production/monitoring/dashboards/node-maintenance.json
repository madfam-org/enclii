  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "Disk Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 85 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "title": "Root Disk Usage (Post-Cleanup)",
      "type": "gauge",
      "targets": [
        {
          "expr": "node_maintenance_disk_usage_percent",
          "legendFormat": "{{ instance }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 86400 },
              { "color": "red", "value": 172800 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "title": "Time Since Last Maintenance",
      "type": "stat",
      "targets": [
        {
          "expr": "time() - node_maintenance_last_run_timestamp_seconds",
          "legendFormat": "{{ instance }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "spanNulls": false
          }
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "title": "Root Disk Available (with 7-day prediction)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}",
          "legendFormat": "Available — {{ instance }}"
        },
        {
          "expr": "predict_linear(node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}[7d], 86400 * 7)",
          "legendFormat": "Predicted (7d) — {{ instance }}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 200,
      "panels": [],
      "title": "Maintenance Run History",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "fillOpacity": 80,
            "lineWidth": 1,
            "pointSize": 5,
            "spanNulls": false
          }
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "title": "Images Removed Per Run",
      "type": "timeseries",
      "targets": [
        {
          "expr": "node_maintenance_images_removed_total",
          "legendFormat": "{{ instance }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "fillOpacity": 80,
            "lineWidth": 1,
            "pointSize": 5,
            "spanNulls": false
          }
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "title": "Containers Cleaned Per Run",
      "type": "timeseries",
      "targets": [
        {
          "expr": "node_maintenance_containers_cleaned_total",
          "legendFormat": "{{ instance }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "bytes",
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "fillOpacity": 80,
            "lineWidth": 1,
            "pointSize": 5,
            "spanNulls": false
          }
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 15 },
      "id": 6,
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "title": "Log Space Freed Per Run",
      "type": "timeseries",
      "targets": [
        {
          "expr": "node_maintenance_logs_freed_bytes",
          "legendFormat": "{{ instance }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 15 },
      "id": 7,
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "title": "Disk Usage Trend (Post-Cleanup)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "node_maintenance_disk_usage_percent",
          "legendFormat": "{{ instance }}"
        },
        {
          "expr": "85",
          "legendFormat": "Warning Threshold (85%)"
        }
      ]
    },
    {
      "collapsed": false,
