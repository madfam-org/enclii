      "title": "Every revenue probe",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Each blackbox-revenue target: last result, HTTP status, money path, paging class. paging=warning targets go to the digest only (decision 6 recommendation).",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "probe ok"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "FAIL",
                        "color": "red"
                      },
                      "1": {
                        "text": "ok",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "http status"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "id": 6,
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "probe ok",
            "desc": false
          }
        ]
      },
      "title": "Revenue probes (latest)",
      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_success{job=\"blackbox-revenue\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_http_status_code{job=\"blackbox-revenue\"}",
          "format": "table",
          "instant": true,
          "refId": "B"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "check": true
            },
            "indexByName": {
              "product": 0,
              "flow": 1,
              "money_path": 2,
              "paging": 3,
              "Value #A": 4,
              "Value #B": 5,
              "instance": 6,
              "module": 7,
              "target_namespace": 8
            }
          }
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
