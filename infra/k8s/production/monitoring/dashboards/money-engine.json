          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "title": "vCTO retainer (Nauta cockpit, Karafiel CFDI, Janua)",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(probe_success{job=\"blackbox-revenue\", money_path=~\".*,retainer,.*\"})",
          "legendFormat": "retainer"
