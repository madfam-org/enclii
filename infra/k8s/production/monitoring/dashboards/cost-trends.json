    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "id": 400,
      "panels": [],
      "title": "Cost per Namespace (Detail)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          },
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Namespace" },
            "properties": [{ "id": "custom.width", "value": 200 }]
          },
          {
            "matcher": { "id": "byName", "options": "CPU Requests (cores)" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 3 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Memory Requests" },
            "properties": [{ "id": "unit", "value": "bytes" }]
          },
          {
            "matcher": { "id": "byName", "options": "Pod Count" },
            "properties": [{ "id": "unit", "value": "short" }]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 26 },
      "id": 8,
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "CPU Requests (cores)", "desc": true }],
        "footer": {
          "show": true,
          "reducer": ["sum"],
          "countRows": false
        }
      },
      "title": "Resource Allocation per Namespace",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (namespace) (kube_pod_container_resource_requests{resource=\"cpu\"})",
          "legendFormat": "{{ namespace }}",
          "instant": true,
          "format": "table",
          "refId": "CPU"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (namespace) (kube_pod_container_resource_requests{resource=\"memory\"})",
          "legendFormat": "{{ namespace }}",
          "instant": true,
          "format": "table",
          "refId": "Memory"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count by (namespace) (kube_pod_info)",
          "legendFormat": "{{ namespace }}",
          "instant": true,
          "format": "table",
          "refId": "Pods"
        }
      ],
      "transformations": [
        {
          "id": "seriesToColumns",
          "options": { "byField": "namespace" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Time 1": true, "Time 2": true, "Time 3": true },
            "renameByName": {
              "namespace": "Namespace",
              "Value #CPU": "CPU Requests (cores)",
              "Value #Memory": "Memory Requests",
              "Value #Pods": "Pod Count"
            }
          }
        }
      ]
    }
