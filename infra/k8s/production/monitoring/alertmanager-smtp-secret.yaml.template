# AlertManager SMTP Credentials
# Create this secret before deploying AlertManager:
#
#   kubectl create secret generic alertmanager-smtp-secret -n monitoring \
#     --from-literal=smtp-password='YOUR_GMAIL_APP_PASSWORD'
#
# Use a Gmail App Password (not account password).
# Long-term: migrate to Resend SMTP relay or External Secrets Operator (Doppler).
---
apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-smtp-secret
  namespace: monitoring
  labels:
    app.kubernetes.io/name: alertmanager
    app.kubernetes.io/component: monitoring
    app.kubernetes.io/part-of: enclii
type: Opaque
stringData:
  smtp-password: "example-local-smtp-app-password"
