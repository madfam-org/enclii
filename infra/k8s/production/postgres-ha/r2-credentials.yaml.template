# CNPG Backup credentials for R2.
#
# DO NOT COMMIT THE FILLED VERSION. Use this template to construct
# the secret manually before the Cluster reconciles. After Wave 2
# (Vault + ESO live), this becomes an ExternalSecret pulling from
# Vault under `kv/data/r2/cnpg-backups/*`.
#
# Operator action (one-time, before merging the companion PR):
#
#   kubectl -n data create secret generic cnpg-r2-credentials \
#     --from-literal=ACCESS_KEY_ID='<r2-access-key-id>' \
#     --from-literal=SECRET_ACCESS_KEY='<r2-secret-access-key>'
#
#   # Set the R2_ACCOUNT_ID env var on the cluster's spec.backup
#   # endpointURL via a SubstrateRef ConfigMap, OR hard-code it in the
#   # endpointURL once chosen. Default approach: ConfigMap below.
#
# The R2 bucket policy must grant write access to the prefix
# `cnpg/postgres-ha/`. Use the same bucket as P1.1 pgbackrest
# (`enclii-backups`), distinct prefix.
#
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: cnpg-r2-credentials
  namespace: data
stringData:
  ACCESS_KEY_ID: REPLACE_ME
  SECRET_ACCESS_KEY: REPLACE_ME
---
# R2 account ID lives in a ConfigMap so the Cluster's endpointURL can
# template against it. Lower sensitivity than the access keys.
apiVersion: v1
kind: ConfigMap
metadata:
  name: cnpg-r2-config
  namespace: data
data:
  R2_ACCOUNT_ID: REPLACE_ME
