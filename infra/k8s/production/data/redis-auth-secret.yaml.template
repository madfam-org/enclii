# ==============================================================================
# Redis Auth Secret Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file: cp redis-auth-secret.yaml.template redis-auth-secret.yaml
# 2. Replace REPLACE_ME with the actual Redis password
# 3. Apply: kubectl apply -f redis-auth-secret.yaml
# 4. DO NOT commit redis-auth-secret.yaml to git
#
# The password must match the password component in:
#   - dhanam-secrets REDIS_URL
#   - janua-secrets REDIS_URL
# ==============================================================================

apiVersion: v1
kind: Secret
metadata:
  name: redis-auth
  namespace: data
  labels:
    app: redis
    app.kubernetes.io/name: redis
    app.kubernetes.io/component: cache
    app.kubernetes.io/part-of: enclii-infrastructure
  annotations:
    secret.enclii.dev/type: infrastructure
type: Opaque
stringData:
  redis-password: "REPLACE_ME"
