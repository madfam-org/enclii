# Cloudflare API Credentials for Config Backup
# Create this secret manually before enabling cloudflare-config-backup CronJob:
#   kubectl apply -f cloudflare-api-secrets.yaml -n data
#
# Required: CF API token with DNS Read + Tunnel Read permissions
---
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-api-credentials
  namespace: data
  labels:
    app.kubernetes.io/name: cloudflare-config-backup
    app.kubernetes.io/component: backup
    app.kubernetes.io/part-of: enclii
type: Opaque
stringData:
  api-token: "CF_API_TOKEN_WITH_DNS_READ_AND_TUNNEL_READ"
  zone-id-enclii: "ENCLII_DEV_ZONE_ID"
  zone-id-madfam: "MADFAM_IO_ZONE_ID"
  account-id: "CF_ACCOUNT_ID"
