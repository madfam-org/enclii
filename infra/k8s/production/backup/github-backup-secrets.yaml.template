# GitHub Backup Credentials
# Create this secret manually before enabling github-repos-backup CronJob:
#   kubectl apply -f github-backup-secrets.yaml -n data
#
# Required: GitHub PAT with repo read scope for madfam-org
---
apiVersion: v1
kind: Secret
metadata:
  name: github-backup-credentials
  namespace: data
  labels:
    app.kubernetes.io/name: github-repos-backup
    app.kubernetes.io/component: backup
    app.kubernetes.io/part-of: enclii
type: Opaque
stringData:
  github-pat: "MADFAM_BOT_PAT_WITH_REPO_READ_SCOPE"
